---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Performance & Backtest Results">
  <style is:global>
    :root {
      --brand-500: #ff7a1a;
      --brand-500-rgb: 255,122,26;
      --brand-600: #e66a15;
      --dark-800: #0b1120;
      --dark-900: #030712;
      --text-base: #cfd4d7;
      --text-muted: #94a3b8;
    }
    .ss-num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
    .ss-label-stamp { font-family: 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; font-size: 10px; }

    /* Hairline grid */
    .ss-hairline { border-color: rgba(148,163,184,.12); }

    /* Reveal */
    .ss-reveal { opacity: 0; transform: translateY(24px); transition: opacity .9s cubic-bezier(.16,1,.3,1), transform .9s cubic-bezier(.16,1,.3,1); }
    .ss-reveal.ss-active { opacity: 1; transform: translateY(0); }

    /* Tabs */
    .ss-seg-btn[data-active="true"] { background: rgba(255,122,26,.15); color: #fff; border-color: rgba(255,122,26,.4); }
    .ss-seg-btn { color: #94a3b8; }

    /* Heatmap cells */
    .ss-heat-cell { transition: transform .2s ease, outline-color .2s ease; }
    .ss-heat-cell:hover { transform: scale(1.08); outline: 1px solid rgba(255,255,255,.4); z-index: 2; }

    /* FAQ */
    details.ss-faq summary { list-style: none; cursor: pointer; }
    details.ss-faq summary::-webkit-details-marker { display: none; }
    details.ss-faq[open] .ss-faq-chev { transform: rotate(180deg); }
    .ss-faq-chev { transition: transform .25s ease; }

    /* CTA shadow */
    .ss-cta-glow { box-shadow: 0 14px 40px -8px rgba(255,122,26,.45), inset 0 1px 0 rgba(255,255,255,.18); }

    /* Trade log row */
    .ss-log-row:hover { background: rgba(255,122,26,.04); }

    /* Disclosure pill */
    .ss-pill { display:inline-flex; align-items:center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }

    .ss-gridline { stroke: rgba(148,163,184,.10); }

    /* Anchored "Last updated" tape */
    .ss-updated-dot { width: 6px; height: 6px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.15); animation: ss-ping 2.4s ease-in-out infinite; }
    @keyframes ss-ping { 0%,100% { box-shadow: 0 0 0 4px rgba(34,197,94,.15);} 50% { box-shadow: 0 0 0 8px rgba(34,197,94,.04);} }
    
    .ss-metric-card { transition: transform .25s ease, border-color .25s ease; }
    .ss-metric-card:hover { transform: translateY(-2px); border-color: rgba(255,122,26,.35); }
  </style>

  <!-- ──────────────────────────────────────────────────────────────────── -->
  <!-- HERO -->
  <header class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 relative">
    <div class="max-w-7xl mx-auto">
      <!-- Eyebrow -->
      <div class="flex flex-wrap items-center gap-3 mb-8">
        <span class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25">
          <i data-lucide="line-chart" class="w-3 h-3"></i> Performance Audit
        </span>
        <span class="ss-pill bg-dark-900 text-slate-300 border ss-hairline">
          <span class="ss-updated-dot mr-2"></span> Backtest period · Jan 2021 → Dec 2024
        </span>
        <span class="ss-pill bg-dark-900 text-slate-300 border ss-hairline">
          <i data-lucide="database" class="w-3 h-3"></i> 1,460 trading days
        </span>
      </div>

      <div class="grid lg:grid-cols-12 gap-12 items-end">
        <!-- Headline -->
        <div class="lg:col-span-7 ss-reveal">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.05] mb-6">
            Risk <span class="ss-num text-brand-500">$1.00</span>.<br/>
            Make <span class="ss-num text-brand-500">$3.64</span>.<br/>
            <span class="text-slate-400 font-semibold">Expectancy over emotion.</span>
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mb-8">
            A <strong class="text-white">2.82× profit factor</strong> across four years of algorithmic testing — including the 2022 bear market. StockSentry enforces ruthless loss-cutting and dynamic profit-trailing so you trade with institutional discipline.
          </p>
          <div class="flex flex-wrap gap-3">
            <button data-tally-open="KYv4MD" data-tally-layout="modal" data-tally-hide-title="1" data-tally-auto-close="0" class="bg-brand-600 hover:bg-brand-500 text-white px-7 py-3.5 rounded-xl font-semibold flex items-center gap-2 ss-cta-glow transition">
              <i data-lucide="send" class="w-4 h-4"></i> Start 14-Day Free Trial
            </button>
            <a href="#methodology" class="text-slate-200 px-5 py-3.5 rounded-xl font-medium border ss-hairline hover:bg-white/5 transition flex items-center gap-2">
              Review Methodology
            </a>
          </div>
        </div>

        <!-- Mini-stat card -->
        <div class="lg:col-span-5 ss-reveal">
          <div class="rounded-3xl border ss-hairline bg-dark-900 p-7 relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-brand-500/15 blur-3xl pointer-events-none"></div>
            <div class="relative z-10">
              <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold mb-1">$10K Account Grew Into</div>
              <div class="ss-num text-5xl font-bold text-white mb-6">$16,623<span class="text-2xl text-slate-500">.83</span></div>
              
              <div class="grid grid-cols-2 gap-4">
                <div class="rounded-xl bg-dark-900 border ss-hairline p-3">
                  <div class="text-[10px] uppercase tracking-widest text-brand-500 mb-1 font-semibold">Total Return</div>
                  <div class="ss-num text-white text-xl font-bold">66.24%</div>
                </div>
                <div class="rounded-xl bg-dark-900 border ss-hairline p-3">
                  <div class="text-[10px] uppercase tracking-widest text-brand-500 mb-1 font-semibold">Win/Loss Ratio</div>
                  <div class="ss-num text-white text-xl font-bold">3.64 : 1</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Headline metric strip -->
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-3 ss-reveal">
        <div class="ss-metric-card rounded-2xl border ss-hairline bg-dark-900 p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Profit Factor</div>
            <i data-lucide="scale" class="w-4 h-4 text-slate-500"></i>
          </div>
          <div class="ss-num text-3xl font-bold text-white mb-1">2.82×</div>
          <p class="text-[11px] text-slate-500 leading-snug">$2.82 gross profit per $1.00 lost</p>
        </div>
        <div class="ss-metric-card rounded-2xl border ss-hairline bg-dark-900 p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Risk : Reward</div>
            <i data-lucide="target" class="w-4 h-4 text-slate-500"></i>
          </div>
          <div class="ss-num text-3xl font-bold text-white mb-1">1 : 3.64</div>
          <p class="text-[11px] text-slate-500 leading-snug">Average payouts skewed in your favor</p>
        </div>
        <div class="ss-metric-card rounded-2xl border ss-hairline bg-dark-900 p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Max Drawdown</div>
            <i data-lucide="shield" class="w-4 h-4 text-slate-500"></i>
          </div>
          <div class="ss-num text-3xl font-bold text-white mb-1">−15.77%</div>
          <p class="text-[11px] text-slate-500 leading-snug">Capped vs SPY −24% in the same window</p>
        </div>
        <div class="ss-metric-card rounded-2xl border ss-hairline bg-dark-900 p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Sharpe</div>
            <i data-lucide="activity" class="w-4 h-4 text-slate-500"></i>
          </div>
          <div class="ss-num text-3xl font-bold text-white mb-1">1.15</div>
          <p class="text-[11px] text-slate-500 leading-snug">Mathematical compounding efficiency</p>
        </div>
      </div>
    </div>
  </header>

  <!-- ──────────────────────────────────────────────────────────────────── -->
  <!-- SECTION: Live equity curve with regime annotations -->
  <section class="px-4 sm:px-6 lg:px-8 py-20 border-t ss-hairline">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8 ss-reveal">
        <div class="max-w-2xl">
          <div class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25 mb-4">
            <i data-lucide="trending-up" class="w-3 h-3"></i> Equity Curve
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-3">Four years. Three regimes. One curve.</h2>
          <p class="text-slate-400 leading-relaxed">A <span class="text-white font-semibold">$10,000</span> starting account, marked-to-market monthly. Hover the bands for the regime context the Sentry was operating in.</p>
        </div>
        <div class="flex flex-wrap gap-2" id="eq-tabs">
          <button class="ss-seg-btn px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="all" data-active="true">All · 4Y</button>
          <button class="ss-seg-btn px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2021">2021</button>
          <button class="ss-seg-btn px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2022">2022</button>
          <button class="ss-seg-btn px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2023">2023</button>
          <button class="ss-seg-btn px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2024">2024</button>
        </div>
      </div>

      <!-- Chart card -->
      <div class="rounded-3xl border ss-hairline bg-dark-900 p-5 sm:p-8 ss-reveal">
        <!-- Legend row: regime chips -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
          <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono uppercase tracking-wider">
            <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border" style="border-color:rgba(16,185,129,.4); background:rgba(16,185,129,.10); color:#34d399;">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> 2021 · Bull
            </span>
            <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border" style="border-color:rgba(244,63,94,.45); background:rgba(244,63,94,.12); color:#fb7185;">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> 2022 · Bear
            </span>
            <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border" style="border-color:rgba(255,122,26,.4); background:rgba(255,122,26,.10); color:#ffb37a;">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> 2023–24 · Recovery
            </span>
          </div>
          <div class="text-xs font-mono text-slate-500" id="eq-readout">Hover the curve</div>
        </div>

        <!-- SVG -->
        <div class="relative w-full">
          <svg viewBox="0 0 1100 460" preserveAspectRatio="xMidYMid meet" class="w-full h-[340px] sm:h-[460px]" id="equity-svg" aria-label="Equity curve chart"></svg>
        </div>

        <!-- Regime annotations -->
        <div class="grid sm:grid-cols-3 gap-3 mt-6">
          <div class="rounded-xl border ss-hairline bg-dark-900 p-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">2021 · Bull</span>
            </div>
            <div class="text-white font-semibold text-sm mb-1">Trend-rider mode</div>
            <p class="text-xs text-slate-400 leading-relaxed">Trailing stops widened. Sentry rode 11 winning swings; lost a partial give-back of +3.4% in Sept.</p>
          </div>
          <div class="rounded-xl border ss-hairline bg-dark-900 p-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2 h-2 rounded-full bg-rose-400"></span>
              <span class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">2022 · Bear / VIX&gt;30</span>
            </div>
            <div class="text-white font-semibold text-sm mb-1">Cash-shield engaged</div>
            <p class="text-xs text-slate-400 leading-relaxed">New entries hard-blocked 7 weeks. Account drew down only −15.77% while SPY hit −24%.</p>
          </div>
          <div class="rounded-xl border ss-hairline bg-dark-900 p-4">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2 h-2 rounded-full bg-brand-500"></span>
              <span class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">2023–24 · Recovery</span>
            </div>
            <div class="text-white font-semibold text-sm mb-1">Discovery scanner on</div>
            <p class="text-xs text-slate-400 leading-relaxed">Capital rotated into V, HD, NFLX, NVDA. +$2,873 added that buy-and-hold would have missed.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────────── -->
  <!-- SECTION: Stress-tested through the cycle -->
  <section class="px-4 sm:px-6 lg:px-8 py-20 border-t ss-hairline">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5 ss-reveal">
        <div class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25 mb-4">
          <i data-lucide="shield-check" class="w-3 h-3"></i> The 2022 Gauntlet
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-5">When the market broke, the Sentry didn't.</h2>
        <div class="space-y-4 text-slate-300 leading-relaxed">
          <p>We didn't optimize for a clean short-term bull market. The audit ran across a full macro cycle — the 2021 melt-up, the 2022 inflation shock, and the volatile 2023–24 recovery.</p>
          <p>The Sentry's job is not to outpace the bull. It's to <strong class="text-white">refuse to sit in a knife-fight</strong>. When VIX broke 30, new entries were hard-blocked. When trailing stops were tagged, the system was already in cash.</p>
        </div>

        <div class="mt-8 rounded-2xl border-l-4 border-brand-500 bg-dark-900 p-5">
          <div class="text-xs uppercase tracking-widest text-brand-500 font-bold mb-2">The bottom line</div>
          <p class="text-white text-base leading-relaxed">Your $10,000 survived the 2022 wreckage with its <span class="ss-num font-semibold text-brand-500">growth intact</span>, closing the year at $12,874. <br/><span class="text-slate-400 text-sm">By sitting out the breakdown, the Sentry preserved capital that took standard portfolios years to recover.</span></p>
        </div>
      </div>

      <div class="lg:col-span-7 ss-reveal">
        <div class="relative rounded-3xl border ss-hairline bg-dark-900 p-3 sm:p-5 overflow-hidden">
          <img src="/charts/chart_2022_bear.png" alt="2022 Bear Market Comparison: StockSentry vs S&P 500" class="w-full rounded-2xl block" />
          <!-- Callouts -->
          <div class="hidden md:flex absolute top-[18%] right-[6%] flex-col items-end gap-1 z-10">
            <span class="px-2.5 py-1 rounded-md bg-brand-500 text-white text-[10px] font-bold shadow-lg whitespace-nowrap border border-brand-400">Sentry — cash shield engaged</span>
            <div class="w-px h-10 bg-brand-500 mr-6"></div>
          </div>
          <div class="hidden md:flex absolute bottom-[14%] left-[8%] flex-col items-start gap-1 z-10">
            <div class="w-px h-6 bg-rose-400 ml-6"></div>
            <span class="px-2.5 py-1 rounded-md bg-rose-500 text-white text-[10px] font-bold shadow-lg whitespace-nowrap border border-rose-400">SPY — −24% drawdown</span>
          </div>
        </div>
        <p class="text-center text-[10px] text-slate-500 mt-3 uppercase tracking-widest font-bold">Simulation · StockSentry vs S&amp;P 500 · Calendar year 2022</p>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────────── -->
  <!-- SECTION: Monthly returns heatmap -->
  <section class="px-4 sm:px-6 lg:px-8 py-20 border-t ss-hairline">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 ss-reveal">
        <div class="max-w-2xl">
          <div class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25 mb-4">
            <i data-lucide="grid-3x3" class="w-3 h-3"></i> Monthly Returns
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-3">Every month, all 48 of them.</h2>
          <p class="text-slate-400 leading-relaxed">No cherry-picked windows. Net P&amp;L for every calendar month of the audit, color-graded by magnitude.</p>
        </div>
        <div class="flex items-center gap-4 text-xs text-slate-400">
          <div class="flex items-center gap-2"><span class="inline-block w-3 h-3 rounded" style="background:#7f1d1d"></span>−5%+</div>
          <div class="flex items-center gap-2"><span class="inline-block w-3 h-3 rounded" style="background:#374151"></span>0%</div>
          <div class="flex items-center gap-2"><span class="inline-block w-3 h-3 rounded" style="background:#ff7a1a"></span>+5%+</div>
        </div>
      </div>

      <div class="rounded-3xl border ss-hairline bg-dark-900 p-5 sm:p-8 ss-reveal" id="heatmap-card">
        <div class="grid grid-cols-[64px_repeat(12,minmax(0,1fr))_minmax(72px,auto)] gap-2 items-center text-[11px]">
          <!-- Header row -->
          <div></div>
          <div class="text-center text-slate-500 font-semibold">Jan</div>
          <div class="text-center text-slate-500 font-semibold">Feb</div>
          <div class="text-center text-slate-500 font-semibold">Mar</div>
          <div class="text-center text-slate-500 font-semibold">Apr</div>
          <div class="text-center text-slate-500 font-semibold">May</div>
          <div class="text-center text-slate-500 font-semibold">Jun</div>
          <div class="text-center text-slate-500 font-semibold">Jul</div>
          <div class="text-center text-slate-500 font-semibold">Aug</div>
          <div class="text-center text-slate-500 font-semibold">Sep</div>
          <div class="text-center text-slate-500 font-semibold">Oct</div>
          <div class="text-center text-slate-500 font-semibold">Nov</div>
          <div class="text-center text-slate-500 font-semibold">Dec</div>
          <div class="text-center text-slate-500 font-semibold uppercase tracking-wider">YTD</div>
        </div>
        <div id="heatmap-rows" class="mt-2 space-y-2"></div>

        <div class="mt-6 pt-5 border-t ss-hairline flex flex-wrap items-center justify-between gap-3 text-xs text-slate-400">
          <div class="flex items-center gap-2"><i data-lucide="info" class="w-3.5 h-3.5"></i> Returns are net of <span class="text-white">0.05% per-leg slippage</span> and a $0 commission assumption.</div>
          <div class="flex items-center gap-4">
            <span>Best month <span class="ss-num text-brand-500 font-semibold">+6.3%</span></span>
            <span>Worst month <span class="ss-num text-rose-400 font-semibold">−4.1%</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────────── -->
  <!-- SECTION: Asymmetry Engine -->
  <section class="px-4 sm:px-6 lg:px-8 py-20 border-t ss-hairline">
    <div class="max-w-5xl mx-auto ss-reveal">
      <div class="text-center mb-12">
        <div class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25 mb-4">
          <i data-lucide="zap" class="w-3 h-3"></i> Asymmetry Engine
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">Why a 40.6% win rate is the point.</h2>
        <p class="text-slate-400 max-w-2xl mx-auto leading-relaxed">Amateurs ask: how often do you win? Professionals ask: how much when you do, and how little when you don't.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="rounded-3xl border ss-hairline bg-dark-900 p-7">
          <div class="flex items-center gap-2 mb-5 text-emerald-400">
            <i data-lucide="trending-up" class="w-5 h-5"></i>
            <span class="text-[10px] uppercase tracking-widest font-bold">Profit Velocity</span>
          </div>
          <div class="ss-num text-5xl font-bold text-white mb-2">+15.02<span class="text-2xl text-slate-500">%</span></div>
          <p class="text-slate-400 text-sm">Average winning trade · trailing-stop locked</p>
          <!-- Mini distribution bars -->
          <div class="mt-6 flex items-end gap-1 h-12">
            <div class="flex-1 bg-emerald-500/30 rounded-t" style="height:30%"></div>
            <div class="flex-1 bg-emerald-500/40 rounded-t" style="height:55%"></div>
            <div class="flex-1 bg-emerald-500/60 rounded-t" style="height:80%"></div>
            <div class="flex-1 bg-emerald-500/80 rounded-t" style="height:95%"></div>
            <div class="flex-1 bg-emerald-500/60 rounded-t" style="height:70%"></div>
            <div class="flex-1 bg-emerald-500/40 rounded-t" style="height:45%"></div>
            <div class="flex-1 bg-emerald-500/30 rounded-t" style="height:25%"></div>
            <div class="flex-1 bg-emerald-500/20 rounded-t" style="height:18%"></div>
            <div class="flex-1 bg-emerald-500/15 rounded-t" style="height:10%"></div>
          </div>
          <div class="text-[10px] text-slate-500 mt-2 font-mono">distribution of winning-trade %</div>
        </div>

        <div class="rounded-3xl border ss-hairline bg-dark-900 p-7">
          <div class="flex items-center gap-2 mb-5 text-rose-400">
            <i data-lucide="trending-down" class="w-5 h-5"></i>
            <span class="text-[10px] uppercase tracking-widest font-bold">Loss Control</span>
          </div>
          <div class="ss-num text-5xl font-bold text-white mb-2">−4.13<span class="text-2xl text-slate-500">%</span></div>
          <p class="text-slate-400 text-sm">Average losing trade · circuit-breaker exit</p>
