---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
    title="AI Stock App Performance | 4-Year Backtest & Audit Results"
    description="Review the audited performance of our AI Stock Market App. See how our algorithm delivered a +122.8% return over 4 years, consistently beating the S&P 500 and NASDAQ."
>
<style is:global>
  :root {
    --brand-500: #ff7a1a;
    --brand-500-rgb: 255,122,26;
    --brand-600: #e66a15;
    --dark-800: #0b1120;
    --dark-900: #030712;
  }
  .ss-num  { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
  .ss-stamp{ font-family: 'JetBrains Mono', ui-monospace, monospace; letter-spacing:.12em; text-transform:uppercase; font-size:10px; }
  .ss-hairline { border-color: rgba(148,163,184,.12); }
  .ss-reveal { opacity:0; transform:translateY(24px); transition: opacity .9s cubic-bezier(.16,1,.3,1), transform .9s cubic-bezier(.16,1,.3,1); }
  .ss-reveal.ss-active { opacity:1; transform:translateY(0); }
  .ss-pill  { display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
  .ss-card  { transition: transform .25s ease, border-color .25s ease; }
  .ss-card:hover { transform:translateY(-2px); border-color:rgba(255,122,26,.35); }
  .ss-seg[data-active="true"] { background:rgba(255,122,26,.15); color:#fff; border-color:rgba(255,122,26,.4); }
  .ss-seg  { color:#94a3b8; }
  .ss-cta-glow { box-shadow: 0 14px 40px -8px rgba(255,122,26,.45), inset 0 1px 0 rgba(255,255,255,.18); }
  .ss-updated-dot { width:6px; height:6px; border-radius:50%; background:#22c55e; box-shadow:0 0 0 4px rgba(34,197,94,.15); animation: ss-ping 2.4s ease-in-out infinite; }
  @keyframes ss-ping { 0%,100%{box-shadow:0 0 0 4px rgba(34,197,94,.15);}50%{box-shadow:0 0 0 8px rgba(34,197,94,.04);} }
  details.ss-faq summary { list-style:none; cursor:pointer; }
  details.ss-faq summary::-webkit-details-marker { display:none; }
  details.ss-faq[open] .ss-chev { transform:rotate(180deg); }
  .ss-chev { transition: transform .25s ease; }
  .chart-label { font-family:'JetBrains Mono',ui-monospace,monospace; font-size:13px; fill:#94a3b8; }
  .ss-gridline { stroke:rgba(148,163,184,.09); stroke-width:1; }
  /* Annual bar */
  .yr-bar { height:8px; border-radius:4px; min-width:3px; transition: width .6s cubic-bezier(.16,1,.3,1); }
  /* Win/loss visual */
  .win-bar  { background: linear-gradient(90deg,rgba(52,211,153,.3),rgba(52,211,153,.8)); }
  .loss-bar { background: linear-gradient(90deg,rgba(251,113,133,.8),rgba(251,113,133,.3)); }
</style>

<!-- ════════════════════════════════════════════════════════ HERO -->
<header class="pt-32 pb-14 px-4 sm:px-6 lg:px-8 relative">
  <div class="max-w-7xl mx-auto">

    <!-- Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-8">
      <span class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25">
        <i data-lucide="trending-up" class="w-3 h-3"></i> Backtest v9 — Performance Audit
      </span>
      <span class="ss-pill bg-dark-900 text-slate-300 border ss-hairline">
        <span class="ss-updated-dot"></span> Jan 2021 → Dec 2024 · 4 years
      </span>
      <span class="ss-pill bg-dark-900 text-slate-300 border ss-hairline">
        <i data-lucide="database" class="w-3 h-3"></i> 207 closed trades
      </span>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 items-end">

      <!-- Headline -->
      <div class="lg:col-span-6 ss-reveal">
        <div class="ss-stamp text-brand-500 mb-3 font-bold">Tested Performance</div>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.0] mb-5">
          <span class="text-brand-500 ss-num">+122.8%</span><br/>
          <span class="text-3xl sm:text-4xl text-slate-300 font-semibold">vs SPY's +68.3%&nbsp;&amp;&nbsp;QQQ's +69.5%</span>
        </h1>
        <p class="text-lg text-slate-400 leading-relaxed max-w-lg mb-8">
          $10,000 turned into <strong class="text-white ss-num">$22,282.61</strong> across a full market cycle — the 2021 bull run, the brutal 2022 bear market, and the 2023–24 recovery. All benchmarks beaten by <strong class="text-white">+54 percentage points</strong>.
        </p>
        <div class="flex flex-wrap gap-3">
          <button data-tally-open="KYv4MD" data-tally-layout="modal" data-tally-hide-title="1" data-tally-auto-close="0"
            class="bg-brand-600 hover:bg-brand-500 text-white px-7 py-3.5 rounded-xl font-semibold flex items-center gap-2 ss-cta-glow transition">
            <i data-lucide="send" class="w-4 h-4"></i> Start 14-Day Free Trial
          </button>
          <a href="#chart" class="text-slate-200 px-5 py-3.5 rounded-xl font-medium border ss-hairline hover:bg-white/5 transition flex items-center gap-2">
            See the Chart <i data-lucide="arrow-down" class="w-4 h-4"></i>
          </a>
        </div>
      </div>

      <!-- 3-way comparison card -->
      <div class="lg:col-span-6 ss-reveal">
        <div class="grid grid-cols-3 gap-2">

          <!-- StockSentry -->
          <div class="rounded-2xl border-2 border-brand-500/60 bg-gradient-to-b from-brand-500/12 to-brand-500/4 p-5 relative overflow-hidden col-span-1">
            <div class="absolute top-2.5 right-2.5">
              <span class="ss-stamp text-brand-500 font-bold px-1.5 py-0.5 rounded bg-brand-500/15 border border-brand-500/25">🏆 WINNER</span>
            </div>
            <div class="ss-stamp text-brand-500 mb-2 font-bold">StockSentry</div>
            <div class="ss-num text-4xl font-bold text-white mb-1">222.83</div>
            <div class="ss-num text-2xl font-bold text-brand-500 mb-3">+122.8%</div>
            <div class="text-[11px] text-slate-400">$10k → <span class="text-white font-mono font-semibold">$22,282</span></div>
          </div>

          <!-- SPY -->
          <div class="rounded-2xl border ss-hairline bg-dark-900 p-5">
            <div class="ss-stamp text-[#60a5fa] mb-2 font-bold">SPY</div>
            <div class="ss-num text-3xl font-bold text-white mb-1">168.27</div>
            <div class="ss-num text-xl font-bold text-[#60a5fa] mb-3">+68.3%</div>
            <div class="text-[11px] text-slate-400">$10k → <span class="text-white font-mono font-semibold">$16,827</span></div>
            <div class="mt-3 pt-3 border-t ss-hairline text-[10px] text-rose-400 font-mono">−54.5pp vs SS</div>
          </div>

          <!-- QQQ -->
          <div class="rounded-2xl border ss-hairline bg-dark-900 p-5">
            <div class="ss-stamp text-[#a78bfa] mb-2 font-bold">QQQ</div>
            <div class="ss-num text-3xl font-bold text-white mb-1">169.46</div>
            <div class="ss-num text-xl font-bold text-[#a78bfa] mb-3">+69.5%</div>
            <div class="text-[11px] text-slate-400">$10k → <span class="text-white font-mono font-semibold">$16,946</span></div>
            <div class="mt-3 pt-3 border-t ss-hairline text-[10px] text-rose-400 font-mono">−53.3pp vs SS</div>
          </div>
        </div>

        <!-- Metric strip below -->
        <div class="grid grid-cols-4 gap-2 mt-2">
          <div class="ss-card rounded-xl border ss-hairline bg-dark-900 p-3">
            <div class="ss-stamp text-brand-500 mb-1 font-bold">Sharpe</div>
            <div class="ss-num text-xl font-bold text-white">1.25</div>
          </div>
          <div class="ss-card rounded-xl border ss-hairline bg-dark-900 p-3">
            <div class="ss-stamp text-brand-500 mb-1 font-bold">Risk/Reward</div>
            <div class="ss-num text-xl font-bold text-white">~5:1</div>
          </div>
          <div class="ss-card rounded-xl border ss-hairline bg-dark-900 p-3">
            <div class="ss-stamp text-brand-500 mb-1 font-bold">Win Rate</div>
            <div class="ss-num text-xl font-bold text-white">35.7%</div>
          </div>
          <div class="ss-card rounded-xl border ss-hairline bg-dark-900 p-3">
            <div class="ss-stamp text-brand-500 mb-1 font-bold">Max DD</div>
            <div class="ss-num text-xl font-bold text-rose-400">−23.7%</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- ════════════════════════════════════════════════════════ CHART -->
<section id="chart" class="px-4 sm:px-6 lg:px-8 py-20 border-t ss-hairline">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8 ss-reveal">
      <div class="max-w-2xl">
        <div class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25 mb-4">
          <i data-lucide="activity" class="w-3 h-3"></i> Equity Curve vs Benchmarks
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-2">
          Four years. Two benchmarks. One clear winner.
        </h2>
        <p class="text-slate-400 leading-relaxed">$10,000 starting capital, marked to market monthly. The orange line is StockSentry — indexed to 100. <span class="text-white font-medium">Bear market band</span> shows the Mar–Nov 2022 regime.</p>
      </div>
      <div class="flex flex-wrap gap-2" id="chart-tabs">
        <button class="ss-seg px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="all" data-active="true">All · 4Y</button>
        <button class="ss-seg px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2021">2021</button>
        <button class="ss-seg px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2022">2022</button>
        <button class="ss-seg px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2023">2023</button>
        <button class="ss-seg px-3 py-1.5 rounded-lg border ss-hairline text-xs font-semibold uppercase tracking-wider" data-range="2024">2024</button>
      </div>
    </div>

    <div class="rounded-3xl border ss-hairline bg-dark-900 p-5 sm:p-8 ss-reveal">
      <!-- Legend -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex flex-wrap items-center gap-3 text-[11px] font-mono uppercase tracking-wider">
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-brand-500/40 bg-brand-500/10 text-brand-400">
            <span class="w-3 h-0.5 bg-brand-500 rounded block"></span> StockSentry · <strong id="leg-ss">+122.8%</strong>
          </span>
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-blue-400/30 bg-blue-500/10 text-blue-300">
            <span class="w-3 h-0.5 bg-blue-400 rounded block"></span> SPY · <strong id="leg-spy">+68.3%</strong>
          </span>
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-violet-400/30 bg-violet-500/10 text-violet-300">
            <span class="w-3 h-0.5 bg-violet-400 rounded block"></span> QQQ · <strong id="leg-qqq">+69.5%</strong>
          </span>
          <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md border border-rose-400/25 bg-rose-500/10 text-rose-300">
            <span class="w-2 h-2 rounded-sm bg-rose-400/50 block"></span> Bear Regime
          </span>
        </div>
        <div class="text-xs font-mono text-slate-500" id="chart-readout">Hover for values</div>
      </div>

      <!-- SVG container -->
      <div class="relative w-full" id="chart-wrap">
        <svg viewBox="0 0 1100 440" preserveAspectRatio="xMidYMid meet"
          class="w-full h-[300px] sm:h-[440px]" id="perf-svg"
          aria-label="StockSentry vs SPY vs QQQ equity curve">
          <defs>
            <linearGradient id="v9grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ff7a1a" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#ff7a1a" stop-opacity="0.02"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Regime annotations -->
      <div class="grid sm:grid-cols-3 gap-3 mt-6 pt-6 border-t ss-hairline">
        <div class="rounded-xl border ss-hairline bg-dark-900 p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
            <span class="ss-stamp text-slate-400 font-bold">2021 · Bull</span>
          </div>
          <div class="ss-num text-brand-500 text-xl font-bold">+42.9%</div>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">StockSentry outperformed SPY (+30.5%) and QQQ (+29.2%) in the momentum phase, riding 10 conviction setups.</p>
        </div>
        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-rose-400 shrink-0"></span>
            <span class="ss-stamp text-rose-300 font-bold">2022 · Bear</span>
          </div>
          <div class="flex items-center gap-3">
            <div><div class="ss-num text-white text-xl font-bold">−13.7%</div><div class="text-[10px] text-brand-500 font-mono">StockSentry</div></div>
            <div class="text-slate-600 text-xs">vs</div>
            <div><div class="ss-num text-rose-400 text-xl font-bold">−32.6%</div><div class="text-[10px] text-violet-400 font-mono">QQQ</div></div>
          </div>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">Capital-protection shields cut losses nearly in half vs QQQ — preserving compounding power for the recovery.</p>
        </div>
        <div class="rounded-xl border ss-hairline bg-dark-900 p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-brand-500 shrink-0"></span>
            <span class="ss-stamp text-slate-400 font-bold">2023–24 · Recovery</span>
          </div>
          <div class="ss-num text-brand-500 text-xl font-bold">+35.6% / +36.7%</div>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">Rotation engine deployed capital into GE (+142%), META (+67%), MU (+61%), CEG (+34%) — beating SPY both years.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════ ANNUAL BREAKDOWN -->
<section class="px-4 sm:px-6 lg:px-8 py-20 border-t ss-hairline">
  <div class="max-w-7xl mx-auto">
    <div class="mb-12 ss-reveal">
      <div class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25 mb-4">
        <i data-lucide="calendar" class="w-3 h-3"></i> Annual Return Breakdown
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-3">Every year, every number.</h2>
      <p class="text-slate-400 max-w-2xl leading-relaxed">No cherry-picked window. The key story: the 2022 bear market protection left StockSentry with far more capital to compound in 2023–24.</p>
    </div>

    <div class="rounded-3xl border ss-hairline bg-dark-900 overflow-hidden ss-reveal">
      <!-- Header -->
      <div class="grid grid-cols-[100px_1fr_1fr_1fr] gap-px bg-slate-800/30">
        <div class="bg-dark-900 p-4 ss-stamp text-slate-500 font-bold">Year</div>
        <div class="bg-dark-900 p-4 ss-stamp text-brand-500 font-bold flex items-center gap-1.5">
          <span class="w-2 h-0.5 bg-brand-500 rounded"></span> StockSentry
        </div>
        <div class="bg-dark-900 p-4 ss-stamp text-blue-400 font-bold flex items-center gap-1.5">
          <span class="w-2 h-0.5 bg-blue-400 rounded"></span> SPY
        </div>
        <div class="bg-dark-900 p-4 ss-stamp text-violet-400 font-bold flex items-center gap-1.5">
          <span class="w-2 h-0.5 bg-violet-400 rounded"></span> QQQ
        </div>
      </div>

      <!-- 2021 -->
      <div class="grid grid-cols-[100px_1fr_1fr_1fr] gap-px bg-slate-800/20 border-t ss-hairline">
        <div class="bg-dark-900 px-4 py-5 flex items-center">
          <span class="ss-num text-white font-bold text-lg">2021</span>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-brand-500 font-bold text-2xl mb-1.5">+42.9%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-brand-500/70 rounded-full" style="width:85.8%"></div></div>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-blue-400 font-bold text-2xl mb-1.5">+30.5%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-blue-500/60 rounded-full" style="width:61%"></div></div>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-violet-400 font-bold text-2xl mb-1.5">+29.2%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-violet-500/60 rounded-full" style="width:58.4%"></div></div>
        </div>
      </div>

      <!-- 2022 (bear - highlighted) -->
      <div class="grid grid-cols-[100px_1fr_1fr_1fr] gap-px bg-rose-500/5 border-t border-rose-500/15">
        <div class="bg-transparent px-4 py-5 flex items-center gap-2">
          <span class="ss-num text-white font-bold text-lg">2022</span>
          <span class="ss-stamp text-rose-400 border border-rose-400/30 px-1 py-0.5 rounded">Bear</span>
        </div>
        <div class="bg-transparent px-4 py-5">
          <div class="ss-num text-white font-bold text-2xl mb-1.5">−13.7%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2">
            <div class="yr-bar rounded-full" style="width:21.3%;background:rgba(251,113,133,.5)"></div>
          </div>
          <div class="text-[10px] text-brand-500 font-mono mt-1.5">BEST IN CLASS ✓</div>
        </div>
        <div class="bg-transparent px-4 py-5">
          <div class="ss-num text-rose-400 font-bold text-2xl mb-1.5">−18.2%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2">
            <div class="yr-bar rounded-full" style="width:27.9%;background:rgba(251,113,133,.5)"></div>
          </div>
        </div>
        <div class="bg-transparent px-4 py-5">
          <div class="ss-num text-rose-400 font-bold text-2xl mb-1.5">−32.6%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2">
            <div class="yr-bar rounded-full" style="width:49.8%;background:rgba(251,113,133,.7)"></div>
          </div>
          <div class="text-[10px] text-rose-400 font-mono mt-1.5">−19pp vs StockSentry</div>
        </div>
      </div>

      <!-- 2023 -->
      <div class="grid grid-cols-[100px_1fr_1fr_1fr] gap-px bg-slate-800/20 border-t ss-hairline">
        <div class="bg-dark-900 px-4 py-5 flex items-center">
          <span class="ss-num text-white font-bold text-lg">2023</span>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-brand-500 font-bold text-2xl mb-1.5">+36.7%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-brand-500/70 rounded-full" style="width:65.5%"></div></div>
          <div class="text-[10px] text-slate-500 font-mono mt-1.5">Beat SPY by +10pp</div>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-blue-400 font-bold text-2xl mb-1.5">+26.7%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-blue-500/60 rounded-full" style="width:47.7%"></div></div>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-violet-400 font-bold text-2xl mb-1.5">+55.9%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-violet-500/70 rounded-full" style="width:100%"></div></div>
          <div class="text-[10px] text-slate-500 font-mono mt-1.5">AI/tech bounce year</div>
        </div>
      </div>

      <!-- 2024 -->
      <div class="grid grid-cols-[100px_1fr_1fr_1fr] gap-px bg-slate-800/20 border-t ss-hairline">
        <div class="bg-dark-900 px-4 py-5 flex items-center">
          <span class="ss-num text-white font-bold text-lg">2024</span>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-brand-500 font-bold text-2xl mb-1.5">+35.6%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-brand-500/70 rounded-full" style="width:63.6%"></div></div>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-blue-400 font-bold text-2xl mb-1.5">+25.6%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-blue-500/60 rounded-full" style="width:45.7%"></div></div>
        </div>
        <div class="bg-dark-900 px-4 py-5">
          <div class="ss-num text-violet-400 font-bold text-2xl mb-1.5">+27.7%</div>
          <div class="w-full bg-slate-800 rounded-full overflow-hidden h-2"><div class="yr-bar bg-violet-500/60 rounded-full" style="width:49.5%"></div></div>
        </div>
      </div>

      <!-- Total row -->
      <div class="grid grid-cols-[100px_1fr_1fr_1fr] gap-px border-t-2 border-brand-500/30 bg-brand-500/5">
        <div class="px-4 py-5 flex items-center">
          <span class="ss-stamp text-slate-400 font-bold">Total</span>
        </div>
        <div class="px-4 py-5">
          <div class="ss-num text-brand-500 font-bold text-3xl">+122.8%</div>
