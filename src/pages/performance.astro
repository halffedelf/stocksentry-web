<script>
const initPerformancePage = () => {

  /* ═══ DATA ═══════════════════════════════════════════════════
     [label, v9, spy, qqq]  — normalized to 100 at start
     Monthly end-of-period values from backtest v9 CSV.
  ══════════════════════════════════════════════════════════════ */
  const DATA = [
    ["Jan '21 start",100,100,100],
    ["Jan '21",97.96,100.35,101.70],
    ["Feb '21",104.84,103.14,101.56],
    ["Mar '21",108.03,107.82,103.31],
    ["Apr '21",110.00,113.52,109.41],
    ["May '21",116.72,114.27,108.10],
    ["Jun '21",122.95,116.83,114.87],
    ["Jul '21",126.26,119.68,118.15],
    ["Aug '21",132.10,123.25,123.14],
    ["Sep '21",127.03,117.50,116.14],
    ["Oct '21",140.10,125.75,125.27],
    ["Nov '21",141.26,124.74,127.77],
    ["Dec '21",142.93,130.51,129.24],   // idx 12
    ["Jan '22",136.58,123.62,117.94],
    ["Feb '22",133.64,119.97,112.66],
    ["Mar '22",135.75,124.48,117.92],   // idx 15 — bear band start
    ["Apr '22",132.71,113.56,101.89],
    ["May '22",136.39,113.81,100.27],
    ["Jun '22",125.88,104.43,91.34],
    ["Jul '22",124.57,114.05,102.80],
    ["Aug '22",120.57,109.39,97.53],
    ["Sep '22",111.54,99.28,87.25],
    ["Oct '22",124.95,107.35,90.74],
    ["Nov '22",127.85,113.32,95.77],    // idx 23 — bear band end
    ["Dec '22",123.29,106.79,87.14],    // idx 24
    ["Jan '23",125.61,113.50,96.41],
    ["Feb '23",124.61,110.65,96.07],
    ["Mar '23",131.77,114.75,105.19],
    ["Apr '23",132.75,116.58,105.72],
    ["May '23",140.65,117.12,114.06],
    ["Jun '23",151.05,124.71,121.25],
    ["Jul '23",158.07,128.79,125.93],
    ["Aug '23",157.46,126.70,124.06],
    ["Sep '23",153.77,120.69,117.76],
    ["Oct '23",151.32,118.07,115.33],
    ["Nov '23",163.96,128.85,127.80],
    ["Dec '23",166.86,134.74,134.94],   // idx 36
    ["Jan '24",171.83,136.88,137.40],
    ["Feb '24",190.75,144.03,144.66],
    ["Mar '24",203.15,148.74,146.50],
    ["Apr '24",203.39,142.74,140.09],
    ["May '24",208.98,149.96,148.71],
    ["Jun '24",207.87,155.25,158.33],
    ["Jul '24",216.19,157.13,155.68],
    ["Aug '24",223.37,160.80,157.39],
    ["Sep '24",230.44,164.18,161.52],
    ["Oct '24",228.74,162.71,160.12],
    ["Nov '24",238.57,172.42,168.69],
    ["Dec '24",222.83,168.27,169.46],   // idx 48
  ];

  // Range slices: [startIdx, endIdx]
  const RANGES = {
    all:  [0, 48],
    2021: [0, 12],
    2022: [13, 24],
    2023: [25, 36],
    2024: [37, 48],
  };
  // Bear band in DATA indices: Mar 2022 = 15, Nov 2022 = 23
  const BEAR_START = 15, BEAR_END = 23;

  /* ═══ CHART ═══════════════════════════════════════════════ */
  const svg = document.getElementById('perf-svg');
  const readout = document.getElementById('chart-readout');
  const legSS  = document.getElementById('leg-ss');
  const legSPY = document.getElementById('leg-spy');
  const legQQQ = document.getElementById('leg-qqq');
  if (!svg) return;

  const W = 1100, H = 440;
  const PAD = { l: 72, r: 155, t: 62, b: 46 };
  const CW = W - PAD.l - PAD.r, CH = H - PAD.t - PAD.b;
  const MONO = "'JetBrains Mono',ui-monospace,monospace";

  let currentSlice = DATA;
  let bearIdxInSlice = { s: -1, e: -1 };

  function buildChart(range) {
    const [si, ei] = RANGES[range] ?? RANGES.all;
    currentSlice = DATA.slice(si, ei + 1);
    const N = currentSlice.length - 1;

    // Map bear indices to local slice
    bearIdxInSlice.s = Math.max(0, BEAR_START - si);
    bearIdxInSlice.e = Math.min(N, BEAR_END - si);
    const hasBear = (BEAR_START <= ei && BEAR_END >= si);

    // Value range
    const allV = currentSlice.flatMap(d => [d[1], d[2], d[3]]);
    const vMin = Math.min(...allV) * 0.94;
    const vMax = Math.max(...allV) * 1.065;

    const xi = i => PAD.l + CW * (i / N);
    const yi = v => PAD.t + CH * (1 - (v - vMin) / (vMax - vMin));

    // Path builder
    const mkPath = col => currentSlice
      .map((d, i) => `${i === 0 ? 'M' : 'L'}${xi(i).toFixed(1)},${yi(d[col]).toFixed(1)}`)
      .join(' ');

    let html = `<defs>
      <linearGradient id="v9grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ff7a1a" stop-opacity="0.30"/>
        <stop offset="100%" stop-color="#ff7a1a" stop-opacity="0.02"/>
      </linearGradient>
    </defs>`;

    // Grid lines
    for (let k = 0; k <= 5; k++) {
      const v = vMin + (vMax - vMin) * k / 5;
      const yy = yi(v).toFixed(1);
      html += `<line x1="${PAD.l}" x2="${W - PAD.r}" y1="${yy}" y2="${yy}" class="ss-gridline"/>`;
      const label = range === 'all'
        ? `${(v.toFixed(0))}` 
        : `${v >= 100 ? '+' : ''}${(v - 100).toFixed(1)}%`;
      html += `<text x="${PAD.l - 10}" y="${(+yy + 5).toFixed(1)}" class="chart-label" text-anchor="end">${label}</text>`;
    }

    // Bear regime band
    if (hasBear) {
      const bs = bearIdxInSlice.s, be = bearIdxInSlice.e;
      const bx1 = xi(bs).toFixed(1), bx2 = xi(be).toFixed(1);
      const bw = (xi(be) - xi(bs)).toFixed(1);
      const midBx = ((xi(bs) + xi(be)) / 2).toFixed(1);
      html += `<rect x="${bx1}" y="${PAD.t}" width="${bw}" height="${CH}" fill="rgba(244,63,94,.09)" stroke="none"/>`;
      html += `<line x1="${bx1}" x2="${bx1}" y1="${PAD.t}" y2="${PAD.t + CH}" stroke="rgba(244,63,94,.4)" stroke-width="1" stroke-dasharray="4 3"/>`;
      html += `<line x1="${bx2}" x2="${bx2}" y1="${PAD.t}" y2="${PAD.t + CH}" stroke="rgba(244,63,94,.4)" stroke-width="1" stroke-dasharray="4 3"/>`;
      html += `<text x="${midBx}" y="${PAD.t - 36}" text-anchor="middle" font-family="${MONO}" font-size="11" font-weight="700" fill="rgba(251,113,133,.7)" letter-spacing="1.5">BEAR MARKET</text>`;
      html += `<text x="${midBx}" y="${PAD.t - 18}" text-anchor="middle" font-family="${MONO}" font-size="11" fill="rgba(251,113,133,.5)">Mar – Nov 2022</text>`;
    }

    // Area fill under v9
    const areaPath = mkPath(1)
      + ` L${xi(N).toFixed(1)},${(PAD.t + CH).toFixed(1)}`
      + ` L${PAD.l},${(PAD.t + CH).toFixed(1)} Z`;
    html += `<path d="${areaPath}" fill="url(#v9grad)"/>`;

    // Lines
    html += `<path d="${mkPath(3)}" stroke="#a78bfa" stroke-width="2" fill="none" opacity="0.8"/>`;
    html += `<path d="${mkPath(2)}" stroke="#60a5fa" stroke-width="2" fill="none" opacity="0.85"/>`;
    html += `<path d="${mkPath(1)}" stroke="#ff7a1a" stroke-width="3" fill="none"/>`;

    // End-point dots + labels
    const last = currentSlice[N];
    const lx = xi(N).toFixed(1);

    // Sort endpoints to avoid overlap
    const endPts = [
      { v: last[1], col: '#ff7a1a', r: 5.5, label: `${last[1].toFixed(1)}`, bold: true },
      { v: last[2], col: '#60a5fa', r: 4,   label: `${last[2].toFixed(1)}`, bold: false },
      { v: last[3], col: '#a78bfa', r: 4,   label: `${last[3].toFixed(1)}`, bold: false },
    ];
    endPts.sort((a, b) => b.v - a.v); // sort by value descending
    let prevYy = -999;
    endPts.forEach(p => {
      let yy = yi(p.v);
      if (Math.abs(yy - prevYy) < 18) yy = prevYy + (yy > prevYy ? 18 : -18);
      prevYy = yy;
      html += `<circle cx="${lx}" cy="${yy.toFixed(1)}" r="${p.r}" fill="${p.col}" stroke="#030712" stroke-width="2"/>`;
      const fw = p.bold ? '700' : '500';
      html += `<text x="${(+lx + 12).toFixed(1)}" y="${(yy + 5).toFixed(1)}" font-family="${MONO}" font-size="14" font-weight="${fw}" fill="${p.col}">${p.label}</text>`;
    });

    // X-axis year labels
    const xLabelMap = {
      all: [[0,"Jan '21"],[13,"Jan '22"],[25,"Jan '23"],[37,"Jan '24"],[48,"Dec '24"]],
      2021:[[0,"Jan '21"],[4,"May"],[8,"Sep"],[12,"Dec '21"]],
      2022:[[0,"Jan '22"],[3,"Apr"],[6,"Jul"],[11,"Dec '22"]],
      2023:[[0,"Jan '23"],[3,"Apr"],[6,"Jul"],[11,"Dec '23"]],
      2024:[[0,"Jan '24"],[3,"Apr"],[6,"Jul"],[11,"Dec '24"]],
    };
    (xLabelMap[range] || xLabelMap.all).forEach(([idx, lbl]) => {
      const localIdx = idx;
      if (localIdx > N) return;
      const xx = xi(localIdx).toFixed(1);
      html += `<text x="${xx}" y="${(PAD.t + CH + 28).toFixed(1)}" class="chart-label" text-anchor="middle">${lbl}</text>`;
    });

    // Crosshair group (initially hidden)
    html += `<g id="crosshair" display="none">
      <line id="ch-vline" stroke="rgba(255,255,255,.15)" stroke-width="1" y1="${PAD.t}" y2="${PAD.t+CH}"/>
      <circle id="ch-dot-v9"  r="5" fill="#ff7a1a" stroke="#030712" stroke-width="2"/>
      <circle id="ch-dot-spy" r="4" fill="#60a5fa" stroke="#030712" stroke-width="2"/>
      <circle id="ch-dot-qqq" r="4" fill="#a78bfa" stroke="#030712" stroke-width="2"/>
    </g>`;

    // Invisible overlay for mouse events
    html += `<rect id="chart-overlay" x="${PAD.l}" y="${PAD.t}" width="${CW}" height="${CH}" fill="transparent" style="cursor:crosshair"/>`;

    svg.innerHTML = html;

    // Reattach hover listener
    const overlay = svg.querySelector('#chart-overlay');
    const crosshair = svg.querySelector('#crosshair');
    const chVline = svg.querySelector('#ch-vline');
    const chDotV9  = svg.querySelector('#ch-dot-v9');
    const chDotSPY = svg.querySelector('#ch-dot-spy');
    const chDotQQQ = svg.querySelector('#ch-dot-qqq');

    overlay?.addEventListener('mousemove', e => {
      const rect = svg.getBoundingClientRect();
      const scaleX = W / rect.width;
      const mx = (e.clientX - rect.left) * scaleX;
      const idx = Math.round((mx - PAD.l) / CW * N);
      const clamped = Math.max(0, Math.min(N, idx));
      const d = currentSlice[clamped];
      const cx = xi(clamped);
      crosshair.setAttribute('display', '');
      chVline.setAttribute('x1', cx); chVline.setAttribute('x2', cx);
      chDotV9.setAttribute('cx', cx);  chDotV9.setAttribute('cy', yi(d[1]));
      chDotSPY.setAttribute('cx', cx); chDotSPY.setAttribute('cy', yi(d[2]));
      chDotQQQ.setAttribute('cx', cx); chDotQQQ.setAttribute('cy', yi(d[3]));
      if (readout) readout.textContent = `${d[0]} · SS ${d[1].toFixed(1)} · SPY ${d[2].toFixed(1)} · QQQ ${d[3].toFixed(1)}`;
      // Update legend
      const pctSS  = `${d[1] >= 100 ? '+' : ''}${(d[1]-100).toFixed(1)}%`;
      const pctSPY = `${d[2] >= 100 ? '+' : ''}${(d[2]-100).toFixed(1)}%`;
      const pctQQQ = `${d[3] >= 100 ? '+' : ''}${(d[3]-100).toFixed(1)}%`;
      if (legSS)  legSS.textContent  = pctSS;
      if (legSPY) legSPY.textContent = pctSPY;
      if (legQQQ) legQQQ.textContent = pctQQQ;
    });
    overlay?.addEventListener('mouseleave', () => {
      crosshair?.setAttribute('display', 'none');
      if (readout) readout.textContent = 'Hover for values';
      if (legSS)  legSS.textContent  = '+122.8%';
      if (legSPY) legSPY.textContent = '+68.3%';
      if (legQQQ) legQQQ.textContent = '+69.5%';
    });
  }

  // Tab switching
  const tabs = document.querySelectorAll('#chart-tabs .ss-seg');
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(b => b.removeAttribute('data-active'));
      btn.setAttribute('data-active', 'true');
      buildChart(btn.dataset.range || 'all');
    });
  });

  buildChart('all');

  /* ═══ SCROLL REVEAL ═══════════════════════════════════════ */
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('ss-active'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.ss-reveal').forEach(el => observer.observe(el));

  // Activate elements already in viewport on first load
  requestAnimationFrame(() => {
    document.querySelectorAll('.ss-reveal').forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight + 100) el.classList.add('ss-active');
    });
  });

  /* ═══ BACK TO TOP ═════════════════════════════════════════ */
  const btt = document.getElementById('back-to-top');
  const handleBtt = () => {
    if (window.scrollY > 600) {
      btt?.classList.remove('translate-y-20', 'opacity-0', 'invisible');
      btt?.classList.add('translate-y-0', 'opacity-100', 'visible');
    } else {
      btt?.classList.add('translate-y-20', 'opacity-0', 'invisible');
      btt?.classList.remove('translate-y-0', 'opacity-100', 'visible');
    }
  };
  window.addEventListener('scroll', handleBtt);
  btt?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
};

document.addEventListener('astro:page-load', initPerformancePage);
</script>

