  <!-- ──────────────────────────────────────────────────────────────────── -->
  <!-- CHART + HEATMAP + LOG + TICKER GRID SCRIPTS -->
  <script>
    const setupPerformancePage = () => {
      /* Data */
      const monthlyReturns = [
        4.2, 3.8, -1.2, 5.1, 2.4, 3.6, 1.9, 4.4, -2.1, 6.3, 3.2, 1.8,
        -3.4, 1.2, 0.8, -4.1, 2.3, -2.8, 1.1, -1.6, 0.4, 2.1, -0.9, 1.7,
        5.2, 1.4, 3.8, 2.6, -1.1, 4.2, 3.7, -2.3, 1.8, 2.9, 4.1, 3.4,
        3.1, 1.8, 4.2, -2.4, 2.7, 1.5, -1.8, 3.4, 2.1, 0.9, 2.8, 1.6,
      ];
      const startEquity = 10000;
      const equity = [startEquity];
      monthlyReturns.forEach(r => equity.push(equity[equity.length - 1] * (1 + r / 100)));

      const spyMonthly = [
        -1.0, 2.7, 4.3, 5.2, 0.7, 2.3, 2.4, 3.0, -4.8, 6.9, -0.7, 4.4,
        -5.2, -3.0, 3.7, -8.8, 0.2, -8.4, 9.2, -4.2, -9.3, 8.1, 5.4, -5.9,
        6.2, -2.6, 3.5, 1.5, 0.3, 6.5, 3.1, -1.8, -4.9, -2.2, 9.1, 4.5,
        1.6, 5.2, 3.1, -4.2, 4.8, 3.5, 1.1, 2.3, 2.0, -1.0, 5.7, -2.5,
      ];
      const spyEquity = [startEquity];
      spyMonthly.forEach(r => spyEquity.push(spyEquity[spyEquity.length - 1] * (1 + r / 100)));

      /* Equity curve */
      const eqSvg = document.getElementById('equity-svg');
      const eqReadout = document.getElementById('eq-readout');
      if (!eqSvg) return;

      function drawEquityCurve(range) {
        const W = 1000, H = 360, padL = 56, padR = 24, padT = 24, padB = 36;
        let startIdx = 0, endIdx = 48;
        if (range === '2021') { startIdx = 0; endIdx = 12; }
        if (range === '2022') { startIdx = 12; endIdx = 24; }
        if (range === '2023') { startIdx = 24; endIdx = 36; }
        if (range === '2024') { startIdx = 36; endIdx = 48; }
        const sliceA = equity.slice(startIdx, endIdx + 1);
        const sliceB = spyEquity.slice(startIdx, endIdx + 1);
        const allVals = sliceA.concat(sliceB);
        const yMin = Math.min(...allVals) * 0.97;
        const yMax = Math.max(...allVals) * 1.03;
        const n = sliceA.length - 1;
        const x = (i) => padL + (W - padL - padR) * (i / n);
        const y = (v) => padT + (H - padT - padB) * (1 - (v - yMin) / (yMax - yMin));

        let pathA = '', pathB = '';
        sliceA.forEach((v, i) => { pathA += (i === 0 ? 'M' : 'L') + x(i).toFixed(1) + ',' + y(v).toFixed(1) + ' '; });
        sliceB.forEach((v, i) => { pathB += (i === 0 ? 'M' : 'L') + x(i).toFixed(1) + ',' + y(v).toFixed(1) + ' '; });
        const area = pathA + ' L ' + x(n).toFixed(1) + ',' + (H - padB) + ' L ' + padL + ',' + (H - padB) + ' Z';

        const ySteps = 4;
        let yLabels = '';
        for (let i = 0; i <= ySteps; i++) {
          const v = yMin + (yMax - yMin) * (i / ySteps);
          const yy = y(v);
          yLabels += `<line x1="${padL}" x2="${W - padR}" y1="${yy}" y2="${yy}" class="gridline" stroke-width="1"/>`;
          yLabels += `<text x="${padL - 8}" y="${yy + 4}" text-anchor="end" fill="#64748b" font-size="11" font-family="JetBrains Mono, ui-monospace, monospace">$${Math.round(v).toLocaleString()}</text>`;
        }

        let xLabels = '';
        if (range === 'all') {
          const yrTicks = [0, 12, 24, 36, 48];
          const yrLab = ['Dec ’20', 'Dec ’21', 'Dec ’22', 'Dec ’23', 'Dec ’24'];
          yrTicks.forEach((m, k) => {
            const xx = x(m);
            xLabels += `<text x="${xx}" y="${H - padB + 20}" text-anchor="middle" fill="#94a3b8" font-size="11" font-family="JetBrains Mono, ui-monospace, monospace">${yrLab[k]}</text>`;
          });
        } else {
          const mons = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          mons.forEach((m, i) => {
            const xx = x(i + 1);
            xLabels += `<text x="${xx}" y="${H - padB + 20}" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="JetBrains Mono, ui-monospace, monospace">${m}</text>`;
          });
        }

        let bands = '';
        if (range === 'all') {
          bands += `<rect x="${x(12)}" y="${padT}" width="${x(24)-x(12)}" height="${H - padT - padB}" fill="rgba(244,63,94,0.06)"/>`;
          bands += `<rect x="${padL}" y="${padT}" width="${x(12)-padL}" height="${H - padT - padB}" fill="rgba(16,185,129,0.04)"/>`;
          bands += `<rect x="${x(24)}" y="${padT}" width="${(W-padR)-x(24)}" height="${H - padT - padB}" fill="rgba(255,122,26,0.04)"/>`;
        }

        let markers = '';
        if (range === 'all' || range === '2022') {
          const yr2022 = equity.slice(12, 25);
          const minIdxInYr = yr2022.indexOf(Math.min(...yr2022));
          const minIdx = 12 + minIdxInYr;
          if (minIdx >= startIdx && minIdx <= endIdx) {
            const xx = x(minIdx - startIdx), yy = y(equity[minIdx]);
            markers += `<circle cx="${xx}" cy="${yy}" r="4" fill="#f43f5e"/>`;
            markers += `<text x="${xx + 8}" y="${yy + 4}" fill="#f43f5e" font-size="11" font-weight="700">Trough · −15.77%</text>`;
          }
        }

        const lastA = sliceA[sliceA.length - 1];
        const lastB = sliceB[sliceB.length - 1];

        eqSvg.innerHTML = `
          <defs>
            <linearGradient id="areaGrad" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#ff7a1a" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#ff7a1a" stop-opacity="0"/>
            </linearGradient>
          </defs>
          ${bands}
          ${yLabels}
          <path d="${area}" fill="url(#areaGrad)"/>
          <path d="${pathB}" stroke="#64748b" stroke-width="1.5" fill="none" stroke-dasharray="4 4"/>
          <path d="${pathA}" stroke="#ff7a1a" stroke-width="2.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
          ${markers}
          <circle cx="${x(n)}" cy="${y(lastA)}" r="5" fill="#ff7a1a" stroke="#030712" stroke-width="2"/>
          <circle cx="${x(n)}" cy="${y(lastB)}" r="4" fill="#64748b" stroke="#030712" stroke-width="2"/>
          ${xLabels}
          <text x="${x(n) + 10}" y="${y(lastA) + 4}" fill="#ff7a1a" font-size="12" font-weight="700" font-family="JetBrains Mono, ui-monospace, monospace">$${Math.round(lastA).toLocaleString()}</text>
          <text x="${x(n) + 10}" y="${y(lastB) + 4}" fill="#94a3b8" font-size="11" font-family="JetBrains Mono, ui-monospace, monospace">$${Math.round(lastB).toLocaleString()}</text>
          <rect id="hover-capture" x="${padL}" y="${padT}" width="${W - padL - padR}" height="${H - padT - padB}" fill="transparent"/>
        `;
        const capture = eqSvg.querySelector('#hover-capture');
        const labelMonths = ['Dec ’20','Jan ’21','Feb ’21','Mar ’21','Apr ’21','May ’21','Jun ’21','Jul ’21','Aug ’21','Sep ’21','Oct ’21','Nov ’21','Dec ’21','Jan ’22','Feb ’22','Mar ’22','Apr ’22','May ’22','Jun ’22','Jul ’22','Aug ’22','Sep ’22','Oct ’22','Nov ’22','Dec ’22','Jan ’23','Feb ’23','Mar ’23','Apr ’23','May ’23','Jun ’23','Jul ’23','Aug ’23','Sep ’23','Oct ’23','Nov ’23','Dec ’23','Jan ’24','Feb ’24','Mar ’24','Apr ’24','May ’24','Jun ’24','Jul ’24','Aug ’24','Sep ’24','Oct ’24','Nov ’24','Dec ’24'];
        capture.addEventListener('mousemove', (e) => {
          const rect = eqSvg.getBoundingClientRect();
          const svgX = (e.clientX - rect.left) * (W / rect.width);
          const ratio = Math.max(0, Math.min(1, (svgX - padL) / (W - padL - padR)));
          const idx = Math.round(ratio * n);
          const absoluteIdx = startIdx + idx;
          eqReadout.textContent = `${labelMonths[absoluteIdx]} · Sentry $${Math.round(equity[absoluteIdx]).toLocaleString()} · SPY $${Math.round(spyEquity[absoluteIdx]).toLocaleString()}`;
        });
        capture.addEventListener('mouseleave', () => { eqReadout.textContent = 'Hover the curve · monthly'; });
      }
      drawEquityCurve('all');
      document.querySelectorAll('#eq-tabs .ss-seg-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#eq-tabs .ss-seg-btn').forEach(b => b.dataset.active = 'false');
          btn.dataset.active = 'true';
          drawEquityCurve(btn.dataset.range);
        });
      });

      /* Heatmap */
      function heatColor(v) {
        const c = Math.max(-6, Math.min(6, v));
        if (c >= 0) {
          const t = c / 6;
          return `rgb(${Math.round(55 + 200*t)},${Math.round(65 + 57*t)},${Math.round(81 - 55*t)})`;
        }
        const t = -c / 6;
        return `rgb(${Math.round(55 + 72*t)},${Math.round(65 - 36*t)},${Math.round(81 - 52*t)})`;
      }
      const rows = document.getElementById('heatmap-rows');
      if (rows) {
        const years = [2021, 2022, 2023, 2024];
        let html = '';
        years.forEach((yr, yi) => {
          const yearReturns = monthlyReturns.slice(yi * 12, yi * 12 + 12);
          const ytdPct = (yearReturns.reduce((acc, r) => acc * (1 + r / 100), 1) - 1) * 100;
          html += `<div class="grid gap-2 items-center" style="grid-template-columns: 64px repeat(12, minmax(0,1fr)) minmax(72px, auto);">`;
          html += `<div class="text-slate-400 font-mono text-xs font-semibold">${yr}</div>`;
          yearReturns.forEach(r => {
            const color = heatColor(r);
            const txt = (r >= 0 ? '+' : '') + r.toFixed(1);
            const textColor = Math.abs(r) >= 2 ? '#fff' : '#cbd5e1';
            html += `<div class="heat-cell aspect-square rounded-md flex items-center justify-center" style="background:${color}; color:${textColor}" title="${yr} · ${txt}%"><span class="ss-num text-[10px] font-semibold">${txt}</span></div>`;
          });
          const ytdColor = ytdPct >= 0 ? 'text-brand-500' : 'text-rose-400';
          html += `<div class="text-right ss-num text-sm font-bold ${ytdColor}">${ytdPct >= 0 ? '+' : ''}${ytdPct.toFixed(1)}%</div>`;
          html += `</div>`;
        });
        rows.innerHTML = html;
      }

      /* Trade log */
      const trades = [
        { ticker: 'NVDA', date: '2021-02-12', in: 138.30, out: 168.40, pct: 21.8, hold: '41d', src: 'seed', exit: 'Trailing stop · profit lock' },
        { ticker: 'MSFT', date: '2021-05-04', in: 244.10, out: 284.91, pct: 16.7, hold: '78d', src: 'seed', exit: 'AI SELL · trend break' },
        { ticker: 'LLY',  date: '2021-09-17', in: 232.05, out: 258.62, pct: 11.5, hold: '32d', src: 'seed', exit: 'Trailing stop' },
        { ticker: 'JPM',  date: '2022-01-04', in: 169.71, out: 161.85, pct: -4.6, hold: '11d', src: 'seed', exit: 'Circuit breaker · −4% floor' },
        { ticker: 'NVDA', date: '2022-04-08', in: 268.40, out: 257.19, pct: -4.2, hold: '6d',  src: 'seed', exit: 'AI SELL · VIX > 30 gate' },
        { ticker: 'MSFT', date: '2022-10-21', in: 245.04, out: 263.18, pct: 7.4,  hold: '34d', src: 'seed', exit: 'Trailing stop' },
        { ticker: 'V',    date: '2023-03-29', in: 217.95, out: 259.71, pct: 19.2, hold: '62d', src: 'discovery', exit: 'Trailing stop · profit lock' },
        { ticker: 'HD',   date: '2023-06-14', in: 296.40, out: 372.97, pct: 25.8, hold: '88d', src: 'discovery', exit: 'AI SELL · trend exhausted' },
        { ticker: 'NFLX', date: '2023-08-22', in: 412.70, out: 387.95, pct: -6.0, hold: '14d', src: 'discovery', exit: 'Earnings blackout · forced flat' },
        { ticker: 'NVDA', date: '2024-01-09', in: 522.83, out: 720.60, pct: 37.9, hold: '52d', src: 'seed', exit: 'Trailing stop · profit lock' },
        { ticker: 'JPM',  date: '2024-04-23', in: 184.20, out: 215.18, pct: 16.8, hold: '71d', src: 'seed', exit: 'AI SELL · trend break' },
        { ticker: 'LLY',  date: '2024-09-30', in: 891.10, out: 854.45, pct: -4.1, hold: '9d',  src: 'seed', exit: 'Circuit breaker · −4% floor' },
      ];
      function renderTradeLog(filter) {
        const body = document.getElementById('log-body');
        if (!body) return;
        let rows = trades;
        if (filter === 'win') rows = trades.filter(t => t.pct > 0);
        if (filter === 'loss') rows = trades.filter(t => t.pct < 0);
        if (filter === 'discovery') rows = trades.filter(t => t.src === 'discovery');
        body.innerHTML = rows.map(t => {
          const isWin = t.pct > 0;
          const pnlClass = isWin ? 'text-emerald-400' : 'text-rose-400';
          const srcPill = t.src === 'discovery'
            ? '<span class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25" style="font-size:9px; padding:2px 7px">Discovery</span>'
            : '<span class="ss-pill bg-white/5 text-slate-400 border border-slate-700/60" style="font-size:9px; padding:2px 7px">Seed</span>';
          return `<div class="log-row grid gap-2 px-5 py-3 items-center border-b border-slate-800" style="grid-template-columns: 1.2fr 1fr 0.8fr 0.8fr 0.8fr 1fr 0.8fr 1.4fr;">
            <div class="flex items-center gap-2"><div class="w-7 h-7 rounded-md bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500 text-[10px] font-bold font-mono">${t.ticker.slice(0,2)}</div><span class="text-white font-semibold text-sm">${t.ticker}</span></div>
            <div class="text-slate-400 ss-num text-xs">${t.date}</div>
            <div class="ss-num text-right text-slate-300 text-xs">$${t.in.toFixed(2)}</div>
            <div class="ss-num text-right text-slate-300 text-xs">$${t.out.toFixed(2)}</div>
            <div class="ss-num text-right font-bold text-sm ${pnlClass}">${isWin ? '+' : ''}${t.pct.toFixed(1)}%</div>
            <div class="ss-num text-right text-slate-500 text-xs">${t.hold}</div>
            <div class="text-right">${srcPill}</div>
            <div class="text-slate-400 text-xs truncate" title="${t.exit}">${t.exit}</div>
          </div>`;
        }).join('');
        document.getElementById('log-count').textContent = rows.length;
      }
      renderTradeLog('all');
      document.querySelectorAll('#log-filters .ss-seg-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#log-filters .ss-seg-btn').forEach(b => b.dataset.active = 'false');
          btn.dataset.active = 'true';
          renderTradeLog(btn.dataset.filter);
        });
      });

      /* Ticker grid */
      const tickers = [
        { sym: 'NVDA', name: 'NVIDIA',     trades: 9, wr: 55.6, avg: 11.6, best: 37.9, total: 1062, icon: 'cpu', src: 'Seed' },
        { sym: 'MSFT', name: 'Microsoft',  trades: 7, wr: 57.1, avg: 14.9, best: 34.1, total: 1065, icon: 'component', src: 'Seed' },
        { sym: 'JPM',  name: 'JPMorgan',   trades: 7, wr: 42.8, avg:  7.6, best: 18.2, total: 2530, icon: 'building-2', src: 'Seed' },
        { sym: 'LLY',  name: 'Eli Lilly',  trades: 6, wr: 50.0, avg:  9.2, best: 22.1, total:  847, icon: 'pill', src: 'Seed' },
        { sym: 'V',    name: 'Visa',       trades: 4, wr: 100,  avg: 17.2, best: 28.6, total: 1444, icon: 'credit-card', src: 'Discovery' },
        { sym: 'HD',   name: 'Home Depot', trades: 3, wr: 66.7, avg: 14.4, best: 25.9, total:  942, icon: 'hammer', src: 'Discovery' },
        { sym: 'NFLX', name: 'Netflix',    trades: 4, wr: 50.0, avg:  9.7, best: 22.3, total:  487, icon: 'play', src: 'Discovery' },
        { sym: '+ 18', name: 'Other names',trades: 24, wr: 45.8, avg:  6.4, best: 16.2, total: -224, icon: 'shuffle', src: 'Mixed' },
      ];
      const grid = document.getElementById('ticker-grid');
      if (grid) {
        grid.innerHTML = tickers.map(t => {
          const totalClass = t.total >= 0 ? 'text-brand-500' : 'text-rose-400';
          const totalStr = (t.total >= 0 ? '+' : '−') + '$' + Math.abs(t.total).toLocaleString();
          const srcPill = t.src === 'Discovery'
            ? '<span class="ss-pill bg-brand-500/10 text-brand-500 border border-brand-500/25" style="font-size:9px; padding:2px 7px">Discovery</span>'
            : t.src === 'Seed'
              ? '<span class="ss-pill bg-white/5 text-slate-400 border border-slate-700/60" style="font-size:9px; padding:2px 7px">Seed</span>'
              : '<span class="ss-pill bg-white/5 text-slate-400 border border-slate-700/60" style="font-size:9px; padding:2px 7px">Mixed</span>';
          return `<div class="rounded-2xl border border-slate-700 bg-dark-900 p-5 hover:border-brand-500/30 transition group">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500"><i data-lucide="${t.icon}" class="w-4 h-4"></i></div>
                <div><div class="text-white font-bold text-sm">${t.sym}</div><div class="text-slate-500 text-[10px]">${t.name}</div></div>
              </div>
              ${srcPill}
            </div>
            <div class="space-y-2 text-xs">
              <div class="flex justify-between"><span class="text-slate-500">Trades</span><span class="ss-num text-white">${t.trades}</span></div>
              <div class="flex justify-between"><span class="text-slate-500">Win rate</span><span class="ss-num text-white">${t.wr}%</span></div>
              <div class="flex justify-between"><span class="text-slate-500">Avg P&amp;L</span><span class="ss-num text-emerald-400 font-semibold">+${t.avg}%</span></div>
              <div class="flex justify-between"><span class="text-slate-500">Best trade</span><span class="ss-num text-white">+${t.best}%</span></div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between items-center">
              <span class="text-[10px] uppercase tracking-widest text-slate-500 font-bold">Total profit</span>
              <span class="ss-num font-bold text-sm ${totalClass}">${totalStr}</span>
            </div>
          </div>`;
        }).join('');
      }

      /* Re-render lucide icons after dynamic insert */
      if (window.lucide) window.lucide.createIcons();
    };

    document.addEventListener('astro:page-load', setupPerformancePage);
  </script>
</MainLayout>
