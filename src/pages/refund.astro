---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Refund Policy | StockSentry AI Stock App">
    <!-- Page Header -->
    <header class="pt-32 pb-12 px-4 border-b border-slate-800 bg-dark-800/50">
        <div class="max-w-3xl mx-auto text-center">
            <h1 class="text-4xl font-bold text-white mb-4">Refund & Cancellation Policy</h1>
        </div>
    </header>

    <!-- Main Content -->
    <main class="py-16 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto space-y-12">
        
        <section>
            <h2 class="text-2xl font-bold text-white mb-4">Alpha Club Access & Trial</h2>
            <p class="text-[var(--text-base)] leading-relaxed mb-6">
                We offer a strict 14-day evaluation trial for approved Alpha Club members on the Pro tier without requiring a credit card upfront. This ensures you have two full weeks of live market data to determine if StockSentry is right for your trading style before any financial commitment is made.
            </p>
        </section>

        <section>
            <h2 class="text-2xl font-bold text-white mb-4">Cancellations</h2>
            <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-4">
                You can cancel your subscription at any time.
            </p>
            <ul class="list-disc pl-5 space-y-2 text-sm text-[var(--text-muted)] marker:text-brand-500 mb-4">
                <li>To cancel, send the command <code>/account</code> to the app in app.</li>
                <li>The app will provide a direct, secure link to your Stripe Customer Portal.</li>
                <li>You can cancel your recurring subscription from the portal with one click.</li>
            </ul>
            <p class="text-[var(--text-muted)] text-sm leading-relaxed">
                Upon cancellation, you will retain access to your chosen tier until the end of your current billing cycle. After the cycle ends, your account will be downgraded and monitoring will cease.
            </p>
        </section>

        <section>
            <h2 class="text-2xl font-bold text-white mb-4">Refund Eligibility</h2>
            <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-4">
                Because we provide a risk-free 14-day trial to evaluate the product, <strong>we do not offer refunds or prorated refunds for mid-cycle cancellations.</strong> 
            </p>
            <p class="text-[var(--text-muted)] text-sm leading-relaxed">
                Exceptions are granted solely in the event of severe billing errors caused by our payment processor (Stripe). In such cases, contact support directly through the app interface. We do not issue refunds for trading losses, as we are not financial advisors and do not guarantee market performance.
            </p>
        </section>

    </main>
</MainLayout>
