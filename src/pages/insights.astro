---
import MainLayout from '../layouts/MainLayout.astro';

const articles = [
  {
    title: "Can LLMs Improve Stock Prediction? The Honest Answer May Surprise You",
    excerpt: "The AI hype is real. But so are the fundamental limits. Learn why hybrid architectures are the future of algorithmic trading.",
    date: "May 10, 2026",
    category: "AI & Data Science",
    slug: "llm-stock-prediction",
    featured: true
  },
  {
    title: "The 2022 Survival Guide: How Algorithmic Risk Shields Prevent Account Wreckage",
    excerpt: "While the NASDAQ dropped 33%, the Sentry's automated floor protocols kept drawdowns to a fraction of the market. Learn the math of the -10% exit.",
    date: "May 20, 2026",
    category: "Risk Management",
    slug: "bear-market-survival"
  },
  {
    title: "Swing Trading vs. Day Trading: Why the 'Slow' Game Wins",
    excerpt: "The psychological and mathematical case for the 30-minute re-check cadence. Discover why checking less frequently actually leads to higher conviction setups.",
    date: "May 18, 2026",
    category: "Strategy",
    slug: "swing-vs-day-trading"
  },
  {
    title: "Understanding the 3-Prong Rubric: Technical, Fundamental, and Macro",
    excerpt: "A deep dive into how our agent evaluates every ticker. Why a perfect chart isn't enough without news sentiment and regime alignment.",
    date: "May 15, 2026",
    category: "How it Works",
    slug: "three-prong-rubric"
  }
];

const featured = articles.find(a => a.featured);
const others = articles.filter(a => !a.featured);
---

<MainLayout 
    title="Insights & Strategy | Algorithmic Trading Intelligence"
    description="Educational guides and market analysis from the StockSentry team. Learn how to survive bear markets, optimize swing trading, and leverage AI for market oversight."
>
    <!-- Header -->
    <header class="pt-32 pb-12 px-4 border-b border-slate-800 bg-dark-900">
        <div class="max-w-4xl mx-auto text-center">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                <i data-lucide="book-open" class="w-3 h-3"></i> Knowledge Base
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Market <span class="text-brand-500">Insights.</span></h1>
            <p class="text-lg text-slate-400 max-w-2xl mx-auto">
                Evidence-based strategy, risk management guides, and the math behind our algorithmic oversight.
            </p>
        </div>
    </header>

    <main class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        
        <!-- Featured Article -->
        <section class="mb-20">
            <div class="group relative rounded-[2.5rem] overflow-hidden bg-dark-800 border border-slate-700 hover:border-brand-500/30 transition-all shadow-2xl">
                <div class="grid lg:grid-cols-2 gap-0">
                    <div class="p-8 md:p-12 flex flex-col justify-center">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="bg-brand-500 text-white text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-md">Featured</span>
                            <span class="text-slate-500 text-xs font-mono">{featured.date}</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight group-hover:text-brand-500 transition-colors">
                            {featured.title}
                        </h2>
                        <p class="text-slate-400 text-lg leading-relaxed mb-8">
                            {featured.excerpt}
                        </p>
                        <div>
                            <a href={`/insights/${featured.slug}`} class="inline-flex items-center gap-2 text-brand-500 font-bold hover:gap-3 transition-all">
                                Read Full Article <i data-lucide="arrow-right" class="w-5 h-5"></i>
                            </a>
                        </div>
                    </div>
                    <div class="bg-dark-900 relative min-h-[400px] overflow-hidden flex items-center justify-center p-6 md:p-10">
                        {featured.slug === 'bear-market-survival' ? (
                            <!-- Stylized Table Visual -->
                            <div class="w-full max-w-md bg-dark-950 rounded-3xl border border-slate-800 shadow-2xl overflow-hidden transform lg:rotate-2 hover:rotate-0 transition-transform duration-500 z-30">
                                <!-- Table Header -->
                                <div class="grid grid-cols-4 gap-px bg-slate-800/30 border-b border-slate-800">
                                    <div class="p-3 ss-stamp text-slate-500 font-bold text-[9px]">Year</div>
                                    <div class="p-3 ss-stamp text-brand-500 font-bold text-[9px]">Sentry</div>
                                    <div class="p-3 ss-stamp text-blue-400 font-bold text-[9px]">SPY</div>
                                    <div class="p-3 ss-stamp text-violet-400 font-bold text-[9px]">QQQ</div>
                                </div>
                                
                                <!-- 2021 Row -->
                                <div class="grid grid-cols-4 gap-px border-b border-slate-800/50">
                                    <div class="p-3 ss-num text-white font-bold text-sm bg-dark-900/50">2021</div>
                                    <div class="p-3 ss-num text-brand-500 font-bold text-sm bg-brand-500/5">+42.9%</div>
                                    <div class="p-3 ss-num text-blue-400 font-medium text-xs">+30.5%</div>
                                    <div class="p-3 ss-num text-violet-400 font-medium text-xs">+29.2%</div>
                                </div>

                                <!-- 2022 Row (Highlighted Bear) -->
                                <div class="grid grid-cols-4 gap-px border-b border-rose-500/20 bg-rose-500/5">
                                    <div class="p-3 flex items-center gap-1.5">
                                        <span class="ss-num text-white font-bold text-sm">2022</span>
                                        <span class="text-[8px] uppercase font-black text-rose-400 border border-rose-400/30 px-1 rounded">Bear</span>
                                    </div>
                                    <div class="p-3 ss-num text-white font-black text-sm bg-white/5">−13.7%</div>
                                    <div class="p-3 ss-num text-slate-500 font-medium text-xs">−18.2%</div>
                                    <div class="p-3 ss-num text-rose-400 font-bold text-sm">−32.6%</div>
                                </div>

                                <!-- 2023 Row -->
                                <div class="grid grid-cols-4 gap-px border-b border-slate-800/50">
                                    <div class="p-3 ss-num text-white font-bold text-sm bg-dark-900/50">2023</div>
                                    <div class="p-3 ss-num text-brand-500 font-bold text-sm bg-brand-500/5">+35.6%</div>
                                    <div class="p-3 ss-num text-blue-400 font-medium text-xs">+26.3%</div>
                                    <div class="p-3 ss-num text-violet-400 font-medium text-xs">+54.5%</div>
                                </div>

                                <!-- 2024 Row -->
                                <div class="grid grid-cols-4 gap-px">
                                    <div class="p-3 ss-num text-white font-bold text-sm bg-dark-900/50">2024</div>
                                    <div class="p-3 ss-num text-brand-500 font-bold text-sm bg-brand-500/5">+36.7%</div>
                                    <div class="p-3 ss-num text-blue-400 font-medium text-xs">+25.2%</div>
                                    <div class="p-3 ss-num text-violet-400 font-medium text-xs">+23.1%</div>
                                </div>

                                <!-- Footer/Badge -->
                                <div class="p-3 bg-brand-500 flex justify-between items-center">
                                    <span class="text-white text-[10px] font-black uppercase tracking-widest">Total return</span>
                                    <span class="text-white ss-num font-black text-lg">+122.8%</span>
                                </div>
                            </div>
                        ) : (
                            <!-- Default Visual (Brain/AI) -->
                            <div class="relative w-full max-w-sm aspect-square bg-dark-950 rounded-full border border-brand-500/20 flex items-center justify-center shadow-2xl z-30 overflow-hidden group/brain">
                                <div class="absolute inset-0 bg-gradient-to-br from-brand-500/10 to-transparent opacity-50"></div>
                                <div class="relative z-10 text-brand-500 transform group-hover/brain:scale-110 transition-transform duration-500">
                                    <i data-lucide="brain-circuit" class="w-32 h-32"></i>
                                </div>
                                <!-- Pulse Rings -->
                                <div class="absolute inset-0 rounded-full border border-brand-500/20 animate-ping opacity-20"></div>
                                <div class="absolute inset-4 rounded-full border border-brand-500/10 animate-pulse"></div>
                            </div>
                        )}
                        <!-- Decorative background glow -->
                        <div class="absolute inset-0 bg-gradient-to-r from-dark-800 via-transparent to-transparent lg:block hidden z-20"></div>
                        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-brand-500/20 blur-[100px] rounded-full pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Article Grid -->
        <section>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {others.map(article => (
                    <div class="flex flex-col bg-dark-800/40 rounded-3xl border border-slate-700 p-8 hover:border-brand-500/30 transition group h-full">
                        <div class="text-slate-500 text-[10px] font-mono mb-4 uppercase tracking-widest">{article.category} · {article.date}</div>
                        <h3 class="text-xl font-bold text-white mb-4 group-hover:text-brand-500 transition-colors">{article.title}</h3>
                        <p class="text-slate-400 text-sm leading-relaxed mb-8 flex-grow">
                            {article.excerpt}
                        </p>
                        <a href={`/insights/${article.slug}`} class="flex items-center gap-2 text-brand-500 text-sm font-bold">
                            Read Story <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                ))}

                <!-- Newsletter/Join CTA -->
                <div class="flex flex-col bg-brand-600 rounded-3xl p-8 shadow-xl shadow-brand-500/10 h-full relative overflow-hidden">
                    <div class="absolute -top-4 -right-4 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="relative z-10">
                        <i data-lucide="bell" class="w-8 h-8 text-white mb-6"></i>
                        <h3 class="text-2xl font-bold text-white mb-4">Never miss a setup.</h3>
                        <p class="text-orange-50 text-sm leading-relaxed mb-8">
                            Get our weekly strategy digest and the latest Alpha Group updates directly to your inbox.
                        </p>
                        <button data-tally-open="KYv4MD" data-tally-layout="modal" data-tally-hide-title="1" data-tally-auto-close="0" class="w-full bg-white text-brand-600 py-3 rounded-xl font-bold hover:bg-brand-50 transition shadow-lg">
                            Apply for Access
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>
</MainLayout>
