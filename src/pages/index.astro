---
import MainLayout from '../layouts/MainLayout.astro';
import HomepageProofSection from '../components/HomepageProofSection.astro';
---

<MainLayout 
    title="AI Stock Market App | Automated Trading Monitoring & Alerts"
    description="StockSentry is the leading AI Stock Market App for automated monitoring. Get real-time technical analysis, plain-English verdicts, and proactive trading alerts directly on your phone."
>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="reveal-direct">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
                    Stop watching charts, <br><span class="text-brand-500">start catching trends.</span>
                    <span class="sr-only">Personalized AI Stock Monitoring & Alerting App for US Markets</span>
                </h1>
                <p class="text-lg text-[var(--text-base)] mb-8 max-w-xl leading-relaxed">
                    Delegate your analysis to the Sentry. It <strong>watches the indicators</strong> and <strong>reads the news</strong>, giving you a definitive 0-100% confidence score on every setup.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#alpha-club" class="bg-brand-600 hover:bg-brand-500 text-white px-8 py-4 rounded-xl font-bold text-lg text-center transition btn-hover-effect flex items-center justify-center gap-2">
                        <i data-lucide="send" class="w-5 h-5"></i>
                        Join the Club
                    </a>
                    <div class="flex gap-3">
                        <!-- Google Play -->
                        <div class="flex items-center gap-3 px-5 py-3 rounded-2xl bg-dark-800 border border-slate-700 shadow-xl group hover:border-brand-500/50 transition-all cursor-pointer active:scale-[0.98]">
                            <div class="w-6 h-6 flex items-center justify-center">
                                <svg viewBox="0 0 512 512" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M32.5 7.3c-1.6 1.3-2.5 3.3-2.5 5.8v485.7c0 2.5.9 4.5 2.5 5.8l1.4 1.4L282 257.1v-2.2L33.9 5.9l-1.4 1.4z" fill="#2196F3"/>
                                    <path d="M362.2 337.3l-80.2-80.2v-2.2l80.2-80.2 1.9 1.1 94.8 53.3c27.1 15.3 27.1 40.3 0 55.6l-94.8 53.3-1.9-1.1z" fill="#FFC107"/>
                                    <path d="M364.1 338.4l-82.1-82.3-249.5 249.3c8.1 8.6 21.4 9.7 36.3 1.3l295.3-168.3z" fill="#F44336"/>
                                    <path d="M364.1 173.6L68.8 3.3C53.9-5.1 40.6-4 32.5 4.6L282 255.1l82.1-81.5z" fill="#4CAF50"/>
                                </svg>
                            </div>
                            <div class="text-left">
                                <div class="text-[8px] text-slate-500 uppercase font-black tracking-tighter leading-none mb-1">Get it on</div>
                                <div class="text-[13px] text-white font-black leading-none whitespace-nowrap">Google Play</div>
                            </div>
                        </div>
                        <!-- App Store -->
                        <div class="flex items-center gap-3 px-5 py-3 rounded-2xl bg-dark-800/40 border border-slate-800 opacity-50 relative overflow-hidden group">
                            <div class="w-6 h-6 flex items-center justify-center">
                                <svg viewBox="0 0 384 512" class="w-full h-full fill-white" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-31.4-73.1-109.8-1.7-142zM263 118.9c25.5-30.2 40.5-62.1 36-93.5-26.8 1.4-56.1 16.4-75.1 41.6-17.2 22.5-30.8 55.4-26.4 84.8 29.8 2.2 53.4-14.7 65.5-32.9z"/>
                                </svg>
                            </div>
                            <div class="text-left">
                                <div class="text-[8px] text-slate-500 uppercase font-black tracking-tighter leading-none mb-1">Coming Soon</div>
                                <div class="text-[13px] text-white font-black leading-none whitespace-nowrap">App Store</div>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="mt-4 text-xs text-[var(--text-muted)] flex items-center gap-1">
                    <i data-lucide="clock" class="w-3 h-3"></i> Built for the long-game. Swing trading focus (months, not weeks).
                </p>
                <p class="mt-2 text-xs text-red-400/80 flex items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3 h-3"></i> Not financial advice. Protect your capital.
                </p>
            </div>
            
            <!-- Mobile App Mockup (Phone Frame) -->
            <div class="relative mx-auto w-full max-w-[340px] mt-12 lg:mt-0 animate-float reveal-direct">
                <!-- Background glow (Illumination) -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-brand-500/20 blur-[100px] rounded-full z-0 pointer-events-none opacity-60"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-brand-500/30 blur-[60px] rounded-full z-0 pointer-events-none"></div>

                <!-- Hardware Buttons -->
                <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                <!-- Phone Bezel -->
                <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                    <!-- Phone Screen -->
                    <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner h-[580px] flex flex-col">
                        
                        <!-- Screen Reflection/Glare -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>

                        <!-- Hardware Notch -->
                        <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                            <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                            </div>
                        </div>

                        <!-- App Header -->
                        <div class="bg-dark-800 border-b border-slate-700/50 pt-9 pb-3 px-4 flex items-center gap-3 relative z-20">
                            <img src="/favicon/logo.png" alt="StockSentry Logo" class="w-9 h-9 object-contain shrink-0" />
                            <div>
                                <div class="text-white font-bold text-[13px] leading-tight">StockSentry</div>
                            </div>
                            <div class="ml-auto flex gap-3">
                                <i data-lucide="bell" class="w-4 h-4 text-slate-400"></i>
                                <i data-lucide="more-vertical" class="w-4 h-4 text-slate-400"></i>
                            </div>
                        </div>
                        
                        <!-- App Content Area -->
                        <div class="p-4 space-y-4 bg-dark-900 flex-1 overflow-hidden relative flex flex-col justify-end pb-6">
                            
                            <!-- Background Pattern -->
                            <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(#ffffff 1.5px, transparent 1.5px); background-size: 20px 20px;"></div>

                            <!-- DUK Watchlist Candidate -->
                            <div class="flex justify-start relative z-10 animate-fade-in-up">
                                <div class="bg-dark-800 text-slate-300 p-4 rounded-2xl text-[11px] leading-relaxed max-w-[92%] border border-slate-700/50 shadow-xl">
                                    <div class="text-slate-500 mb-1.5 text-[9px] font-mono">📊 SCAN COMPLETE</div>
                                    <div class="font-bold text-white text-[13px] mb-2.5 flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
                                        WATCHLIST CANDIDATE — DUK
                                    </div>
                                    
                                    <div class="bg-dark-950/50 border border-brand-500/20 rounded-xl p-3 mb-3">
                                        <div class="flex justify-between items-center mb-1.5">
                                            <span class="text-brand-500 font-bold text-[9px] uppercase tracking-wider">Verdict</span>
                                            <span class="text-white font-bold text-[10px]">STRONG BUY</span>
                                        </div>
                                        <div class="flex justify-between items-center">
                                            <span class="text-brand-500 font-bold text-[9px] uppercase tracking-wider">Confidence</span>
                                            <span class="text-white font-bold text-[10px]">88%</span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <p class="text-white font-medium mb-1">Price: $124.42 | RSI: 32.1</p>
                                        <p class="text-slate-400 leading-snug">DUK has pulled back to a major buyer zone. Rubric shows strong technical alignment.</p>
                                    </div>

                                    <div class="bg-dark-950/50 p-2.5 rounded-lg border border-slate-700/50 space-y-1 font-mono text-[10px]">
                                        <div class="flex justify-between"><span class="text-slate-500">Stop-loss:</span> <span class="text-white font-bold">$119.86</span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- META Proactive Safety -->
                            <div class="flex justify-start relative z-10 mt-2 opacity-90 scale-[0.98] origin-left animate-fade-in-up" style="animation-delay: 150ms;">
                                <div class="bg-dark-800 text-slate-300 p-3.5 rounded-2xl text-[11px] leading-relaxed max-w-[92%] border border-slate-700/50 shadow-lg">
                                    <div class="text-slate-500 mb-1 text-[9px] font-mono">🚨 POSITION ALERT</div>
                                    <div class="font-bold text-white text-[12px] mb-1.5 flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                        SET STOP-LOSS — META
                                    </div>
                                    <p class="text-slate-400 line-clamp-2">META is trading below its long-term average. Protect capital.</p>
                                    <div class="mt-2 text-red-400 font-bold text-[10px]">Stop at $572.13</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- App Action Bar -->
                        <div class="bg-dark-800 border-t border-slate-700/50 p-3 flex items-center justify-around relative z-20">
                            <div class="flex flex-col items-center gap-1 opacity-100">
                                <i data-lucide="home" class="w-4 h-4 text-brand-500"></i>
                                <span class="text-[8px] font-bold text-brand-500 uppercase">Home</span>
                            </div>
                            <div class="flex flex-col items-center gap-1 opacity-50">
                                <i data-lucide="eye" class="w-4 h-4 text-slate-400"></i>
                                <span class="text-[8px] font-bold text-slate-400 uppercase">Watch</span>
                            </div>
                            <div class="flex flex-col items-center gap-1 opacity-50">
                                <i data-lucide="plus-circle" class="w-4 h-4 text-slate-400"></i>
                                <span class="text-[8px] font-bold text-slate-400 uppercase">Add</span>
                            </div>
                            <div class="flex flex-col items-center gap-1 opacity-50">
                                <i data-lucide="bar-chart-3" class="w-4 h-4 text-slate-400"></i>
                                <span class="text-[8px] font-bold text-slate-400 uppercase">Stats</span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Background glow -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-brand-500/20 blur-3xl rounded-full z-0 pointer-events-none"></div>
            </div>
        </div>
    </section>

    <HomepageProofSection />

    <!-- Personal Market Intelligence Section (The Sentry Advantage) -->
    <section id="features" class="py-16 bg-dark-900 border-y border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-12">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                    <i data-lucide="cpu" class="w-3 h-3 mr-1.5"></i> The Sentry Advantage
                </div>
                <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">
                    Personal market intelligence <br><span class="text-brand-500">in your pocket.</span>
                </h2>
                <p class="text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed">
                    Most trading tools are built for <strong>"Full-time Quants."</strong> We built StockSentry for the <strong>99% of investors</strong> who have jobs, families, and lives, but still want professional-grade market oversight.
                </p>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 reveal-group">
                <!-- Feature 1: Morning Briefing -->
                <div class="reveal-item bg-transparent p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-transparent rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="sunrise" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Morning Briefing</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-4">
                        A concise status report delivered at <strong>08:30 AM Daily</strong>. Reviews your open positions and calculates current P&L to set the context for your day.
                    </p>
                    <a href="/insights/swing-vs-day-trading" class="text-brand-500 text-xs font-bold hover:underline inline-flex items-center gap-1.5">Read about cadence <i data-lucide="arrow-right" class="w-3 h-3"></i></a>
                </div>

                <!-- Feature 2: No Charts -->
                <div class="reveal-item bg-transparent p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-transparent rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="eye-off" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Zero Chart Overwhelm</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Stop drawing trendlines. StockSentry <strong>monitors 14 indicators</strong> 24/7 and sends only the final verdict.
                    </p>
                </div>

                <!-- Feature 2: Proactive AI -->
                <div class="reveal-item bg-transparent p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-transparent rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="gauge" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">AI Confidence Engine</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Raw data is evaluated against a <strong>3-prong rubric</strong> (Technical, Fundamental, Macro) to give you a definitive confidence score before you act.
                    </p>
                    <a href="/insights/three-prong-rubric" class="text-brand-500 text-xs font-bold hover:underline inline-flex items-center gap-1.5">How the logic works <i data-lucide="arrow-right" class="w-3 h-3"></i></a>
                    <a href="/insights/llm-stock-prediction" class="text-slate-500 text-[10px] block mt-2 hover:text-brand-500 transition-colors">Our philosophy on AI prediction →</a>
                </div>

                <!-- Feature 3: Native App UX -->
                <div class="reveal-item bg-transparent p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-transparent rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="smartphone" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Native & Private</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        No broker linking. No personal data. Manage your entire watchlist through a purpose-built, secure interface.
                    </p>
                </div>

                <!-- Feature 4: Discovery -->
                <div class="reveal-item bg-transparent p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-transparent rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="shield-check" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Principal Protection</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Hardcoded risk shields like the <strong>-10% Floor</strong> and <strong>Earnings Blackout</strong> protect your capital from sudden market shocks.
                    </p>
                    <a href="/insights/bear-market-survival" class="text-brand-500 text-xs font-bold hover:underline inline-flex items-center gap-1.5">See bear-market results <i data-lucide="arrow-right" class="w-3 h-3"></i></a>
                </div>

                <!-- Feature 6: Proactive Alerts -->
                <div class="reveal-item bg-transparent p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-transparent rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="trending-up" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Swing Trading Focus</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Designed for <strong>long-term gains</strong>. The Sentry handles the noise while you wait months or years for the real trend to manifest.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- How it Works Process Section -->
    <section id="how-it-works" class="py-16 bg-dark-900 border-t border-slate-800 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="mb-12 max-w-3xl">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                    How it works
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight">
                    From a quiet watchlist to a timed sell — without you in front of a chart.
                </h2>
            </div>

            <!-- Steps -->
            <div class="relative reveal-group">
                <!-- Desktop connecting line -->
                <div class="hidden md:block absolute top-12 left-[10%] w-[80%] h-[1px] border-t-2 border-dashed border-slate-700 z-0"></div>

                <div class="grid md:grid-cols-4 gap-12 relative z-10">
                    <!-- Step 1 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="scan" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">01</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">04:30 PM Scan</div>
                        <h3 class="text-lg font-bold text-white mb-3">Evaluate setups via the 3-Prong Rubric.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">Every afternoon, the Sentry sweeps the universe for high-probability Technical, Fundamental, and Macro alignment.</p>
                        <a href="/insights/three-prong-rubric" class="text-brand-500 text-xs font-bold hover:underline mt-4 inline-flex items-center gap-1">How the logic works <i data-lucide="arrow-right" class="w-3 h-3"></i></a>
                    </div>

                    <!-- Step 2 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="binoculars" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">02</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">Watch</div>
                        <h3 class="text-lg font-bold text-white mb-3">Watches for the right entry point.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">Once a ticker is on your list, StockSentry watches every market hour for a clean technical setup.</p>
                    </div>

                    <!-- Step 3 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="message-circle" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">03</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">Alert</div>
                        <h3 class="text-lg font-bold text-white mb-3">Messages you when the moment comes.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">A push notification with the signal, the reasoning, and the price. You do the research and decide.</p>
                    </div>

                    <!-- Step 4 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="activity" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">04</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">30m Re-check</div>
                        <h3 class="text-lg font-bold text-white mb-3">Tracks the trend after you own it.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">Every 30 minutes StockSentry re-checks the trend. When the trend turns, you get an immediate sell notification.</p>
                    </div>
                </div>
            </div>

            <!-- Bottom Cadence Banner -->
            <div class="mt-16 bg-dark-900 border border-slate-700 rounded-2xl p-6 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left max-w-4xl">
                <div class="bg-brand-500/20 text-brand-500 text-xs font-bold px-3 py-1.5 rounded-md shrink-0 border border-brand-500/20">30 MIN</div>
                <p class="text-sm text-[var(--text-base)]">Re-check cadence after you own the ticker — fast enough to catch a turn, slow enough to ignore the noise.</p>
            </div>
        </div>
    </section>

