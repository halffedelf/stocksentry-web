---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="AI powered stock monitoring bot">
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="reveal-direct">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-dark-800 text-sm font-medium mb-6 text-brand-500 border border-slate-700">
                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                    S&P 100 Monitoring Active
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
                    Own the trend, <br><span class="text-brand-500">not the screen.</span>
                </h1>
                <p class="text-lg text-[var(--text-base)] mb-8 max-w-xl leading-relaxed">
                    Delegate your analysis to the Sentry. It <strong>watches the indicators</strong> and <strong>reads the news</strong>, giving you a definitive 0-100% confidence score on every setup.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#alpha-club" class="bg-brand-600 hover:bg-brand-500 text-white px-8 py-4 rounded-xl font-bold text-lg text-center transition btn-hover-effect flex items-center justify-center gap-2">
                        <i data-lucide="send" class="w-5 h-5"></i>
                        Join the Club
                    </a>
                    <a href="/experience" class="bg-dark-800 hover:bg-slate-700 text-white px-8 py-4 rounded-xl font-medium text-lg text-center transition border border-slate-700 btn-hover-effect-dark">
                        View Example Alerts
                    </a>
                </div>
                <p class="mt-4 text-xs text-[var(--text-muted)] flex items-center gap-1">
                    <i data-lucide="clock" class="w-3 h-3"></i> Built for the long-game. Swing trading focus (months, not weeks).
                </p>
                <p class="mt-2 text-xs text-red-400/80 flex items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3 h-3"></i> Not financial advice. Protect your capital.
                </p>
            </div>
            
            <!-- Telegram Mockup (Phone Frame) -->
            <div class="relative mx-auto w-full max-w-[340px] mt-12 lg:mt-0 animate-float reveal-direct">
                <!-- Background glow (Illumination) -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-brand-500/20 blur-[100px] rounded-full z-0 pointer-events-none opacity-60"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-brand-500/30 blur-[60px] rounded-full z-0 pointer-events-none"></div>

                <!-- Hardware Buttons -->
                <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                <!-- Phone Bezel -->
                <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                    <!-- Phone Screen -->
                    <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner">
                        
                        <!-- Screen Reflection/Glare -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>

                        <!-- Hardware Notch -->
                        <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                            <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                            </div>
                        </div>

                        <!-- Telegram Header -->
                        <div class="bg-dark-800 border-b border-slate-700 pt-8 pb-3 px-4 flex items-center gap-3 relative z-20">
                            <div class="w-10 h-10 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0">
                                <svg width="20" height="20" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="6" stroke-linejoin="round"/>
                                    <path d="M30 65L45 45L55 55L70 30" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="70" cy="30" r="4" fill="var(--brand-500)"/>
                                </svg>
                            </div>
                            <div>
                                <div class="text-white font-bold text-sm leading-tight">StockSentry</div>
                                <div class="text-brand-500 text-[11px] leading-tight mt-0.5">bot</div>
                            </div>
                        </div>
                        
                        <!-- Telegram Chat Area -->
                        <div class="p-4 space-y-4 bg-dark-900 h-[480px] overflow-hidden relative flex flex-col justify-end pb-6">
                            
                            <!-- Background Pattern (Subtle) -->
                            <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"></div>

                            <!-- MCD Buy Alert -->
                            <div class="flex justify-start relative z-10">
                                <div class="bg-dark-800 text-[var(--text-base)] p-3.5 rounded-2xl rounded-tl-sm text-xs leading-relaxed max-w-[95%] border border-slate-700 shadow-md">
                                    <div class="text-[var(--text-muted)] mb-1 text-[10px]">📊 [17:40]</div>
                                    <div class="font-bold text-white text-[13px] mb-2">
                                        💡 BUY OPPORTUNITY — MCD
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-white">$275.75</span> <span class="text-[var(--text-muted)]">| RSI 25.2</span>
                                    </div>
                                    <div class="bg-dark-900 p-2 rounded border border-slate-700 mb-2 space-y-1">
                                        <div>Allocate: <span class="text-white font-medium">5-7% of portfolio</span></div>
                                        <div>Stop-loss: <span class="text-white font-medium">$263.77</span></div>
                                    </div>
                                    <div class="text-[var(--text-base)] mb-2 leading-snug">
                                        <strong class="text-white">Why:</strong> McDonald's has fallen so far and so fast that it's now deeply oversold — historically, drops this extreme tend to snap back...
                                    </div>
                                </div>
                            </div>

                            <!-- META Stop-Loss Alert -->
                            <div class="flex justify-start relative z-10 mt-2">
                                <div class="bg-dark-800 text-[var(--text-base)] p-3.5 rounded-2xl rounded-tl-sm text-xs leading-relaxed max-w-[95%] border border-slate-700 shadow-md">
                                    <div class="text-[var(--text-muted)] mb-1 text-[10px]">🚨 [17:40]</div>
                                    <div class="font-bold text-white text-[13px] mb-2">
                                        ⚠️ SET STOP-LOSS — META
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-white">$609.63</span> <span class="text-[var(--text-muted)]">| 🔴 -9.6%</span>
                                    </div>
                                    <div class="bg-red-500/10 p-2 rounded border border-red-500/20 mb-2 space-y-1">
                                        <div>Set stop at: <span class="text-white font-bold">$572.13</span></div>
                                        <div class="text-red-400 font-medium text-[10px]">If triggered, sell immediately.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Simulated Message Input -->
                        <div class="bg-dark-800 border-t border-slate-700 p-3 flex items-center gap-2 relative z-20">
                            <i data-lucide="paperclip" class="w-4 h-4 text-slate-400"></i>
                            <div class="flex-grow bg-dark-900 border border-slate-700 rounded-full h-8 px-3 flex items-center">
                                <span class="text-slate-500 text-xs">Message...</span>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center">
                                <i data-lucide="mic" class="w-4 h-4 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Background glow -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-brand-500/20 blur-3xl rounded-full z-0 pointer-events-none"></div>
            </div>
        </div>
    </section>

    <!-- The Sentry in Action (Visual Proof) -->
    <section class="py-16 bg-dark-800 border-y border-slate-800 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-12">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                    Real-time Performance
                </div>
                <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">
                    See the Sentry <br><span class="text-brand-500">in action.</span>
                </h2>
                <p class="text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
                    We don't just give you tools. We provide a <strong>complete market oversight service</strong> that speaks your language.
                </p>
            </div>

            <div class="grid lg:grid-cols-2 gap-12 items-center reveal-group">
                <!-- Visual 1: The Verdict -->
                <div class="reveal-item bg-dark-900 rounded-[2.5rem] p-8 border border-slate-700 shadow-2xl relative group">
                    <div class="absolute -top-4 -right-4 bg-brand-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg z-20">The Verdict</div>
                    <div class="space-y-6">
                        <div class="bg-dark-800 rounded-2xl p-6 border border-slate-700 relative">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0">
                                     <i data-lucide="brain-circuit" class="w-5 h-5 text-brand-500"></i>
                                </div>
                                <span class="text-white font-bold">Sentry Analysis</span>
                            </div>
                            <div class="text-[var(--text-base)] text-[13px] leading-relaxed italic border-l-4 border-brand-500 pl-4 space-y-3">
                                <p><strong>👀 WATCHLIST CANDIDATE — DUK</strong></p>
                                
                                <div class="bg-dark-900 border border-brand-500/20 rounded-lg p-3 my-2 not-italic">
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-brand-500 font-bold text-[10px] uppercase">Verdict</span>
                                        <span class="text-white font-bold text-[10px]">STRONG BUY</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-brand-500 font-bold text-[10px] uppercase">Confidence</span>
                                        <span class="text-white font-bold text-[10px]">88%</span>
                                    </div>
                                </div>

                                <p>DUK has pulled back to a major buyer zone. Our rubric shows strong technical alignment and fundamental health. Sentiment catalyst: positive price-target hike.</p>
                                <p><strong>Stop-loss: $119.86 | Risk/Reward: 1:2.9</strong></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-slate-500 text-[10px] uppercase tracking-wider font-bold">
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> AI Rubric</div>
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> Plain English</div>
                        </div>
                    </div>
                </div>

                <!-- Visual 2: Proactive Safety -->
                <div class="reveal-item bg-dark-900 rounded-[2.5rem] p-8 border border-slate-700 shadow-2xl relative group">
                    <div class="absolute -top-4 -right-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg z-20">Proactive Safety</div>
                    <div class="space-y-6">
                        <div class="bg-dark-800 rounded-2xl p-6 border border-slate-700 relative">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-red-900/20 flex items-center justify-center border border-red-500 shrink-0">
                                     <i data-lucide="shield-alert" class="w-5 h-5 text-red-500"></i>
                                </div>
                                <span class="text-white font-bold">Risk Management</span>
                            </div>
                            <div class="text-[var(--text-base)] text-[13px] leading-relaxed italic border-l-4 border-red-500 pl-4 space-y-3">
                                <p><strong>⚠️ SET STOP-LOSS — META</strong></p>
                                <p><strong>Why:</strong> META is now trading below its long-term average — a sign of a weak trend, not just a bad day. Setting a stop here protects your capital from a deeper breakdown if things get worse.</p>
                                <p><strong>Set stop at: $572.13</strong><br>
                                <span class="text-red-400 not-italic font-bold text-[11px]">If triggered, sell immediately.</span></p>
                                <p class="text-[10px] text-brand-500 truncate not-italic">📰 Goldman Sachs resets Broadcom forecast…</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-slate-500 text-[10px] uppercase tracking-wider font-bold">
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> Auto-Tracking</div>
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-4 h-4"></i> Instant Alert</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!--
    ════════════════════════════════════════════════════════════════════
    PERFORMANCE PROOF SECTION — drop into index.astro
    ════════════════════════════════════════════════════════════════════

    Recommended placement: between the existing "Sentry in Action" section
    (the Verdict + Risk Management cards) and the "Personal Market
    Intelligence" features grid. Narrative: see what it does → see what
    it produced → see why it works.

    Paste the whole <section>...</section> below into index.astro at that
    point. The accompanying <style> + <script> blocks are scoped to this
    section — paste them once, anywhere within MainLayout.
    ════════════════════════════════════════════════════════════════════
    -->

    <!-- The Receipts / Backtest Proof Section -->
    <section id="proof" class="py-20 bg-black border-y border-slate-800 relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute -top-32 left-1/4 w-[600px] h-[600px] rounded-full bg-brand-500/8 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-brand-500/5 blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Heading row -->
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-10 reveal-direct">
        <div class="max-w-2xl">
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/25">
            <i data-lucide="badge-check" class="w-3 h-3 mr-1.5"></i> The Receipts
            </div>
            <h2 class="text-3xl md:text-5xl font-bold text-white leading-[1.05] mb-5 tracking-tight">
            Four years of backtesting.<br/>
            <span class="text-brand-500">Audited and public.</span>
            </h2>
            <p class="text-lg text-slate-400 leading-relaxed">
            We replayed the Sentry tick-by-tick from January 2021 through December 2024 — a full macro cycle including the 2022 bear market. Every entry, every exit, every reason. <span class="text-white font-semibold">No cherry-picking.</span>
            </p>
        </div>
        <a href="/performance" class="hidden lg:inline-flex items-center gap-2 text-brand-500 hover:text-brand-50 font-semibold transition group whitespace-nowrap">
            <span>Read the full audit</span>
            <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
        </a>
        </div>

        <!-- Main proof block: 4-stat metric strip + receipts card -->
        <div class="grid lg:grid-cols-12 gap-6 mb-10 reveal-group">
        <!-- LEFT: 4-up stat grid -->
        <div class="lg:col-span-7">
            <div class="grid grid-cols-2 gap-3 h-full">
            <!-- Stat 1: Profit factor -->
            <div class="metric-card rounded-3xl border border-slate-700 bg-dark-900 p-6 reveal-item">
                <div class="flex items-center justify-between mb-4">
                <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Profit Factor</div>
                <i data-lucide="scale" class="w-4 h-4 text-slate-500"></i>
                </div>
                <div class="num text-4xl sm:text-5xl font-bold text-white leading-none mb-3">2.82<span class="text-slate-500 text-3xl">×</span></div>
                <p class="text-[11px] text-slate-500 leading-snug">
                <span class="text-brand-500 num font-semibold">$2.82</span> gross profit for every <span class="num">$1.00</span> lost.
                </p>
            </div>

            <!-- Stat 2: $10k → $16.6k -->
            <div class="metric-card rounded-3xl border border-slate-700 bg-dark-900 p-6 relative overflow-hidden reveal-item">
                <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-brand-500/15 blur-3xl pointer-events-none"></div>
                <div class="relative">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">$10K Grew Into</div>
                    <i data-lucide="trending-up" class="w-4 h-4 text-slate-500"></i>
                </div>
                <div class="num text-4xl sm:text-5xl font-bold text-white leading-none mb-3">
                    $16,623<span class="text-slate-500 text-2xl">.83</span>
                </div>
                <p class="text-[11px] text-slate-500 leading-snug">+66.24% cumulative growth · Net of slippage</p>
                </div>
            </div>

            <!-- Stat 3: Max drawdown -->
            <div class="metric-card rounded-3xl border border-slate-700 bg-dark-900 p-6 reveal-item">
                <div class="flex items-center justify-between mb-4">
                <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Max Drawdown</div>
                <i data-lucide="shield" class="w-4 h-4 text-slate-500"></i>
                </div>
                <div class="num text-4xl sm:text-5xl font-bold text-white leading-none mb-3">−15.77<span class="text-slate-500 text-3xl">%</span></div>
                <p class="text-[11px] text-slate-500 leading-snug">
                Simulated worst-case decline. Algorithmic cash-shields prevented catastrophic account wreckage.
                </p>
            </div>

            <!-- Stat 4: Risk:Reward -->
            <div class="metric-card rounded-3xl border border-slate-700 bg-dark-900 p-6 reveal-item">
                <div class="flex items-center justify-between mb-4">
                <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Risk : Reward</div>
                <i data-lucide="target" class="w-4 h-4 text-slate-500"></i>
                </div>
                <div class="num text-4xl sm:text-5xl font-bold text-white leading-none mb-3">1 : 3.64</div>
                <p class="text-[11px] text-slate-500 leading-snug">
                Average winner is <span class="text-brand-500 num font-semibold">3.64×</span> the size of an average loser.
                </p>
            </div>
            </div>
        </div>

        <!-- RIGHT: Equity sparkline card -->
        <div class="lg:col-span-5 reveal-direct">
            <div class="h-full rounded-3xl border border-slate-700 bg-dark-900 p-7 relative overflow-hidden">
            <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 18px 18px;"></div>
            <div class="relative flex flex-col h-full">
                <div class="flex items-center justify-between mb-3">
                <div class="text-[10px] uppercase tracking-widest text-brand-500 font-bold">Equity Curve · 2021–2024</div>
                <div class="flex items-center gap-1.5 text-[10px] text-slate-500 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    NET OF SLIPPAGE
                </div>
                </div>

                <!-- Inline equity sparkline -->
                <div class="relative flex-1 min-h-[240px]">
                <svg viewBox="0 0 700 340" preserveAspectRatio="xMidYMid meet" class="w-full h-full" id="proof-sparkline"></svg>
                </div>

                <!-- Legend + breakdown -->
                <div class="mt-4 pt-4 border-t border-slate-800 grid grid-cols-3 gap-3">
                <div>
                    <div class="label-stamp text-slate-500 mb-1">Trades</div>
                    <div class="num text-white font-bold">64</div>
                </div>
                <div>
                    <div class="label-stamp text-slate-500 mb-1">Win Rate</div>
                    <div class="num text-white font-bold">40.6%</div>
                </div>
                <div>
                    <div class="label-stamp text-slate-500 mb-1">Sharpe</div>
                    <div class="num text-white font-bold">1.15</div>
                </div>
                </div>
            </div>
            </div>
        </div>
        </div>

        <!-- Pull-quote callout: the asymmetry insight -->
        <div class="rounded-3xl border border-brand-500/30 bg-dark-900 p-6 sm:p-8 flex flex-col md:flex-row md:items-center gap-6 mb-10 reveal-direct">
        <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-brand-500/15 border border-brand-500/30 flex items-center justify-center text-brand-500">
            <i data-lucide="zap" class="w-6 h-6"></i>
        </div>
        <p class="text-base sm:text-lg text-white leading-relaxed flex-1">
            StockSentry closed 64 trades at a <span class="text-brand-500 num font-bold">40.6% win rate</span>, with the average winner running <span class="text-brand-500 num font-bold">+15%</span> against an average loser of just <span class="text-brand-500 num font-bold">−4.1%</span>. <span class="text-slate-400">Cut losses fast, let winners run.</span>
        </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mb-10 reveal-group">
        <div class="rounded-2xl border border-slate-700 bg-dark-900 p-5 flex items-start gap-4 reveal-item">
            <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500">
            <i data-lucide="gauge" class="w-4 h-4"></i>
            </div>
            <div>
            <div class="num text-2xl font-bold text-white leading-none mb-1.5">88<span class="text-slate-500 text-base">%</span></div>
            <div class="text-xs text-slate-400 leading-snug">Avg cash held through 2022. VIX-gate parked capital out of harm's way for 177 of 251 trading days.</div>
            </div>
        </div>
        <div class="rounded-2xl border border-slate-700 bg-dark-900 p-5 flex items-start gap-4 reveal-item">
            <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500">
            <i data-lucide="shield" class="w-4 h-4"></i>
            </div>
            <div>
            <div class="num text-2xl font-bold text-white leading-none mb-1.5">$31</div>
            <div class="text-xs text-slate-400 leading-snug">Avg loss size across 23 losers. Trailing stops fired fast — 23× smaller than the average <span class="num text-white">$711</span> winner.</div>
            </div>
        </div>
        </div>

        <!-- Mobile CTA -->
        <a href="/performance" class="lg:hidden inline-flex items-center gap-2 text-brand-500 hover:text-brand-50 font-semibold transition group">
        <span>Read the full audit</span>
