    <script>
        const setupAlphaModal = () => {
            const btn = document.getElementById('alpha-how-it-works-btn');
            const modal = document.getElementById('alpha-modal');
            const overlay = document.getElementById('alpha-modal-overlay');
            const close = document.getElementById('alpha-modal-close');
            const content = document.getElementById('alpha-modal-content');

            if (!btn || !modal) return;

            const open = () => {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                content?.classList.remove('scale-95');
                content?.classList.add('scale-100');
                document.body.style.overflow = 'hidden';
            };

            const hide = () => {
                modal.classList.add('opacity-0', 'pointer-events-none');
                content?.classList.remove('scale-100');
                content?.classList.add('scale-95');
                document.body.style.overflow = '';
            };

            btn.addEventListener('click', open);
            overlay?.addEventListener('click', hide);
            close?.addEventListener('click', hide);
            
            // Re-render icons for modal
            if (window.lucide) {
                window.lucide.createIcons();
            }
        };

        document.addEventListener('astro:page-load', setupAlphaModal);
    </script>

