---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="AI powered stock monitoring bot">
    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="reveal-direct">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-dark-800 text-sm font-medium mb-6 text-brand-500 border border-slate-700">
                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                    S&P 100 Monitoring Active
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
                    Own the trend, <br><span class="text-brand-500">not the screen.</span>
                </h1>
                <p class="text-lg text-[var(--text-base)] mb-8 max-w-xl leading-relaxed">
                    Delegate your analysis to the Sentry. It <strong>watches the indicators</strong> and <strong>reads the news</strong>, so you only get pinged when it’s time to act.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="bg-brand-600 hover:bg-brand-500 text-white px-8 py-4 rounded-xl font-bold text-lg text-center transition btn-hover-effect flex items-center justify-center gap-2">
                        <i data-lucide="send" class="w-5 h-5"></i>
                        Start Free Trial
                    </a>
                    <a href="/experience" class="bg-dark-800 hover:bg-slate-700 text-white px-8 py-4 rounded-xl font-medium text-lg text-center transition border border-slate-700 btn-hover-effect-dark">
                        View Example Alerts
                    </a>
                </div>
                <p class="mt-4 text-xs text-[var(--text-muted)] flex items-center gap-1">
                    <i data-lucide="info" class="w-3 h-3"></i> Not a day-trading bot. Built for swing trading timeframes.
                </p>
                <p class="mt-2 text-xs text-red-400/80 flex items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3 h-3"></i> Not financial advice. For informational purposes only.
                </p>
            </div>
            
            <!-- Telegram Mockup (Phone Frame) -->
            <div class="relative mx-auto w-full max-w-[340px] mt-12 lg:mt-0 animate-float reveal-direct">
                <!-- Background glow (Illumination) -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-brand-500/20 blur-[100px] rounded-full z-0 pointer-events-none opacity-60"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-brand-500/30 blur-[60px] rounded-full z-0 pointer-events-none"></div>

                <!-- Hardware Buttons -->
                <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                <!-- Phone Bezel -->
                <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                    <!-- Phone Screen -->
                    <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner">
                        
                        <!-- Screen Reflection/Glare -->
                        <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>

                        <!-- Hardware Notch -->
                        <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                            <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                            </div>
                        </div>

                        <!-- Telegram Header -->
                        <div class="bg-dark-800 border-b border-slate-700 pt-8 pb-3 px-4 flex items-center gap-3 relative z-20">
                            <div class="w-10 h-10 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0">
                                <svg width="20" height="20" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="6" stroke-linejoin="round"/>
                                    <path d="M30 65L45 45L55 55L70 30" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="70" cy="30" r="4" fill="var(--brand-500)"/>
                                </svg>
                            </div>
                            <div>
                                <div class="text-white font-bold text-sm leading-tight">StockSentry</div>
                                <div class="text-brand-500 text-[11px] leading-tight mt-0.5">bot</div>
                            </div>
                        </div>
                        
                        <!-- Telegram Chat Area -->
                        <div class="p-4 space-y-4 bg-dark-900 h-[480px] overflow-hidden relative flex flex-col justify-end pb-6">
                            
                            <!-- Background Pattern (Subtle) -->
                            <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"></div>

                            <!-- MCD Buy Alert -->
                            <div class="flex justify-start relative z-10">
                                <div class="bg-dark-800 text-[var(--text-base)] p-3.5 rounded-2xl rounded-tl-sm text-xs leading-relaxed max-w-[95%] border border-slate-700 shadow-md">
                                    <div class="text-[var(--text-muted)] mb-1 text-[10px]">📊 [17:40]</div>
                                    <div class="font-bold text-white text-[13px] mb-2">
                                        💡 BUY OPPORTUNITY — MCD
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-white">$275.75</span> <span class="text-[var(--text-muted)]">| RSI 25.2</span>
                                    </div>
                                    <div class="bg-dark-900 p-2 rounded border border-slate-700 mb-2 space-y-1">
                                        <div>Allocate: <span class="text-white font-medium">5-7% of portfolio</span></div>
                                        <div>Stop-loss: <span class="text-white font-medium">$263.77</span></div>
                                    </div>
                                    <div class="text-[var(--text-base)] mb-2 leading-snug">
                                        <strong class="text-white">Why:</strong> McDonald's has fallen so far and so fast that it's now deeply oversold — historically, drops this extreme tend to snap back...
                                    </div>
                                </div>
                            </div>

                            <!-- META Stop-Loss Alert -->
                            <div class="flex justify-start relative z-10 mt-2">
                                <div class="bg-dark-800 text-[var(--text-base)] p-3.5 rounded-2xl rounded-tl-sm text-xs leading-relaxed max-w-[95%] border border-slate-700 shadow-md">
                                    <div class="text-[var(--text-muted)] mb-1 text-[10px]">🚨 [17:40]</div>
                                    <div class="font-bold text-white text-[13px] mb-2">
                                        ⚠️ SET STOP-LOSS — META
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-white">$609.63</span> <span class="text-[var(--text-muted)]">| 🔴 -9.6%</span>
                                    </div>
                                    <div class="bg-red-500/10 p-2 rounded border border-red-500/20 mb-2 space-y-1">
                                        <div>Set stop at: <span class="text-white font-bold">$572.13</span></div>
                                        <div class="text-red-400 font-medium text-[10px]">If triggered, sell immediately.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Simulated Message Input -->
                        <div class="bg-dark-800 border-t border-slate-700 p-3 flex items-center gap-2 relative z-20">
                            <i data-lucide="paperclip" class="w-4 h-4 text-slate-400"></i>
                            <div class="flex-grow bg-dark-900 border border-slate-700 rounded-full h-8 px-3 flex items-center">
                                <span class="text-slate-500 text-xs">Message...</span>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center">
                                <i data-lucide="mic" class="w-4 h-4 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Background glow -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-brand-500/20 blur-3xl rounded-full z-0 pointer-events-none"></div>
            </div>
        </div>
    </section>

    <!-- The Sentry in Action (Visual Proof) -->
    <section class="py-24 bg-dark-800 border-y border-slate-800 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                    Real-time Performance
                </div>
                <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">
                    See the Sentry <br><span class="text-brand-500">in action.</span>
                </h2>
                <p class="text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
                    We don't just give you tools. We provide a <strong>complete market oversight service</strong> that speaks your language.
                </p>
            </div>

            <div class="grid lg:grid-cols-2 gap-12 items-center reveal-group">
                <!-- Visual 1: The Verdict -->
                <div class="reveal-item bg-dark-900 rounded-[2.5rem] p-8 border border-slate-700 shadow-2xl relative group">
                    <div class="absolute -top-4 -right-4 bg-brand-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg z-20">The Verdict</div>
                    <div class="space-y-6">
                        <div class="bg-dark-800 rounded-2xl p-6 border border-slate-700 relative">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0">
                                     <i data-lucide="brain-circuit" class="w-5 h-5 text-brand-500"></i>
                                </div>
                                <span class="text-white font-bold">Sentry Analysis</span>
                            </div>
                            <div class="text-[var(--text-base)] text-[13px] leading-relaxed italic border-l-4 border-brand-500 pl-4 space-y-3">
                                <p><strong>👀 WATCHLIST CANDIDATE — DUK</strong><br>
                                Duke Energy | Utilities</p>
                                <p>DUK has pulled back to a major buyer zone and looks stretched. With a reasonable valuation and a fresh price-target hike, this is a solid defensive addition to balance your tech-heavy portfolio.</p>
                                <p><strong>Stop-loss: $119.86 | Risk/Reward: 1:2.9</strong></p>
                                <p class="text-brand-500 not-italic font-bold text-[11px]">➡️ Add DUK to WATCHLIST in Telegram.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-slate-500 text-[10px] uppercase tracking-wider font-bold">
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> No Charts</div>
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> Plain English</div>
                        </div>
                    </div>
                </div>

                <!-- Visual 2: Proactive Safety -->
                <div class="reveal-item bg-dark-900 rounded-[2.5rem] p-8 border border-slate-700 shadow-2xl relative group">
                    <div class="absolute -top-4 -right-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg z-20">Proactive Safety</div>
                    <div class="space-y-6">
                        <div class="bg-dark-800 rounded-2xl p-6 border border-slate-700 relative">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-red-900/20 flex items-center justify-center border border-red-500 shrink-0">
                                     <i data-lucide="shield-alert" class="w-5 h-5 text-red-500"></i>
                                </div>
                                <span class="text-white font-bold">Risk Management</span>
                            </div>
                            <div class="text-[var(--text-base)] text-[13px] leading-relaxed italic border-l-4 border-red-500 pl-4 space-y-3">
                                <p><strong>⚠️ SET STOP-LOSS — META</strong></p>
                                <p><strong>Why:</strong> META is now trading below its long-term average — a sign of a weak trend, not just a bad day. Setting a stop here protects your capital from a deeper breakdown if things get worse.</p>
                                <p><strong>Set stop at: $572.13</strong><br>
                                <span class="text-red-400 not-italic font-bold text-[11px]">If triggered, sell immediately.</span></p>
                                <p class="text-[10px] text-brand-500 truncate not-italic">📰 Goldman Sachs resets Broadcom forecast…</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-slate-500 text-[10px] uppercase tracking-wider font-bold">
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-3 h-3"></i> Auto-Tracking</div>
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-4 h-4"></i> Instant Alert</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Personal Market Intelligence Section (The Sentry Advantage) -->
    <section id="features" class="py-24 bg-dark-900 border-y border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                    The Sentry Advantage
                </div>
                <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">
                    Personal market intelligence <br><span class="text-brand-500">in your pocket.</span>
                </h2>
                <p class="text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed">
                    Most trading tools are built for <strong>"Full-time Quants."</strong> We built StockSentry for the <strong>99% of investors</strong> who have jobs, families, and lives, but still want professional-grade market oversight.
                </p>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 reveal-group">
                <!-- Feature 1: No Charts -->
                <div class="reveal-item bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-dark-900 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="eye-off" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Zero Chart Overwhelm</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Stop drawing trendlines. StockSentry <strong>monitors 14 indicators</strong> 24/7 and sends only the final verdict.
                    </p>
                </div>

                <!-- Feature 2: Proactive AI -->
                <div class="reveal-item bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-dark-900 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="brain-circuit" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Latest AI Analysis</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Raw data is translated by <strong>LLMs</strong> into clear, plain English directives that you can act on instantly.
                    </p>
                </div>

                <!-- Feature 3: Conversational UX -->
                <div class="reveal-item bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-dark-900 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="message-square-more" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Conversational UX</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Telegram is <strong>native and intuitive</strong>. Manage your entire watchlist through simple, natural messages.
                    </p>
                </div>

                <!-- Feature 4: Discovery -->
                <div class="reveal-item bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-dark-900 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="search" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Discovery Scan</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Find fresh opportunities with our <strong>daily S&P 100 sweep</strong>, ranking the best setups before the close.
                    </p>
                </div>

                <!-- Feature 5: Privacy First -->
                <div class="reveal-item bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-dark-900 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="lock" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Strict Privacy</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        No broker links. No personal data. We only store your <strong>anonymous Telegram ID</strong> and your tickers.
                    </p>
                </div>

                <!-- Feature 6: Proactive Alerts -->
                <div class="reveal-item bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                    <div class="w-14 h-14 bg-dark-900 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-slate-700 group-hover:scale-110 transition-transform shadow-lg">
                        <i data-lucide="bell-ring" class="w-7 h-7"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Actionable Pings</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Zero noise. The Sentry stays silent until a <strong>significant trend shift</strong> is detected in your positions.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- How it Works Process Section -->
    <section id="how-it-works" class="py-24 bg-dark-900 border-t border-slate-800 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Header -->
            <div class="mb-20 max-w-3xl">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                    How it works
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight">
                    From a quiet watchlist to a timed sell — without you in front of a chart.
                </h2>
            </div>

            <!-- Steps -->
            <div class="relative reveal-group">
                <!-- Desktop connecting line -->
                <div class="hidden md:block absolute top-12 left-[10%] w-[80%] h-[1px] border-t-2 border-dashed border-slate-700 z-0"></div>

                <div class="grid md:grid-cols-4 gap-12 relative z-10">
                    <!-- Step 1 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="scan" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">01</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">Scan</div>
                        <h3 class="text-lg font-bold text-white mb-3">Scans top tickers for strong opportunities.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">StockSentry runs a daily sweep across the S&P 100 and NASDAQ 100*, ranking tickers by signal strength.</p>
                    </div>

                    <!-- Step 2 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="binoculars" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">02</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">Watch</div>
                        <h3 class="text-lg font-bold text-white mb-3">Watches for the right entry point.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">Once a ticker is on your list, StockSentry watches every market hour for a clean technical setup.</p>
                    </div>

                    <!-- Step 3 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="message-circle" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">03</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">Alert</div>
                        <h3 class="text-lg font-bold text-white mb-3">Messages you when the moment comes.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">Telegram ping with the signal, the reasoning, and the price. You do the research and decide.</p>
                    </div>

                    <!-- Step 4 -->
                    <div class="reveal-item relative flex flex-col items-center md:items-start text-center md:text-left">
                        <div class="w-24 h-24 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center mb-6 relative shadow-xl">
                            <i data-lucide="activity" class="w-8 h-8 text-brand-500"></i>
                            <div class="absolute -top-2 -right-2 bg-brand-600 text-white text-xs font-bold w-8 h-8 rounded-full flex items-center justify-center border-4 border-dark-900">04</div>
                        </div>
                        <div class="text-brand-500 text-xs font-bold tracking-wider uppercase mb-3">Monitor</div>
                        <h3 class="text-lg font-bold text-white mb-3">Tracks the trend after you own it.</h3>
                        <p class="text-sm text-[var(--text-base)] leading-relaxed">Every 30 minutes StockSentry re-checks the trend. When the trend turns, you get a sell alert.</p>
                    </div>
                </div>
            </div>

            <!-- Bottom Cadence Banner -->
            <div class="mt-16 bg-dark-800/50 border border-slate-700 rounded-2xl p-6 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left max-w-4xl">
                <div class="bg-brand-500/20 text-brand-500 text-xs font-bold px-3 py-1.5 rounded-md shrink-0 border border-brand-500/20">30 MIN</div>
                <p class="text-sm text-[var(--text-base)]">Re-check cadence after you own the ticker — fast enough to catch a turn, slow enough to ignore the noise.</p>
            </div>
        </div>
    </section>

    <!-- A Day in the Life Timeline -->
    <section class="py-24 bg-dark-800 border-y border-slate-800 relative overflow-hidden">
        <!-- Abstract Background Glow -->
