---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Why StockSentry">
    <!-- Hero / Intro -->
    <header class="pt-32 pb-16 px-4 text-center relative overflow-hidden">
        <div class="max-w-3xl mx-auto relative z-10">
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
                Trading intelligence, <br><span class="text-brand-500">without the overhead.</span>
            </h1>
            <p class="text-xl text-slate-400 mb-8 leading-relaxed">
                Most trading tools are built for "Full-time Quants." We built StockSentry for the 99% of investors who have jobs, families, and lives, but still want professional-grade market oversight.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="bg-brand-600 hover:bg-brand-500 text-white px-8 py-4 rounded-xl font-bold text-lg transition shadow-xl btn-hover-effect">
                    Start 14-Day Free Trial
                </a>
                <p class="text-slate-500 text-sm flex items-center justify-center gap-2">
                   <i data-lucide="shield-check" class="w-4 h-4"></i> No Credit Card Required
                </p>
            </div>
        </div>
    </header>

    <!-- Core USPs (Features First) -->
    <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            <!-- Feature 1: No Charts -->
            <div class="bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                <div class="w-14 h-14 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-brand-500/20 group-hover:scale-110 transition-transform">
                    <i data-lucide="eye-off" class="w-7 h-7"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">Zero Chart Overwhelm</h3>
                <p class="text-slate-400 leading-relaxed">
                    Drawing trendlines and watching RSI is a full-time job. StockSentry continuously monitors 14 technical indicators for you. You get the verdict, not the noise.
                </p>
            </div>

            <!-- Feature 2: Proactive AI -->
            <div class="bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                <div class="w-14 h-14 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-brand-500/20 group-hover:scale-110 transition-transform">
                    <i data-lucide="brain-circuit" class="w-7 h-7"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">The Latest AI Analysis</h3>
                <p class="text-slate-400 leading-relaxed">
                    Under the hood, we use the latest LLMs to analyze news sentiment and technical setups. It translates raw numbers into clear, plain English directives.
                </p>
            </div>

            <!-- Feature 3: Conversational UX -->
            <div class="bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                <div class="w-14 h-14 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-brand-500/20 group-hover:scale-110 transition-transform">
                    <i data-lucide="message-square-more" class="w-7 h-7"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">Conversational & Intuitive</h3>
                <p class="text-slate-400 leading-relaxed">
                    Telegram is native and conversational. No heavy software to install. Adding a ticker is as easy as sending a message. It's built for humans, not quants.
                </p>
            </div>

            <!-- Feature 4: Discovery -->
            <div class="bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                <div class="w-14 h-14 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-brand-500/20 group-hover:scale-110 transition-transform">
                    <i data-lucide="search" class="w-7 h-7"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">Find New Tickers</h3>
                <p class="text-slate-400 leading-relaxed">
                    Don't know what to trade? Our Discovery Scan sweeps the S&P 100 daily to find fresh opportunities with high signal strength, so you never miss a trend.
                </p>
            </div>

            <!-- Feature 5: Privacy First -->
            <div class="bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                <div class="w-14 h-14 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-brand-500/20 group-hover:scale-110 transition-transform">
                    <i data-lucide="lock" class="w-7 h-7"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">Strict Privacy</h3>
                <p class="text-slate-400 leading-relaxed">
                    We don't want your data. We don't link to your broker. We store only your Telegram ID and the tickers you watch. Your portfolio is your business.
                </p>
            </div>

            <!-- Feature 6: Proactive Alerts -->
            <div class="bg-dark-800 p-8 rounded-3xl border border-slate-700 hover:border-brand-500/30 transition group">
                <div class="w-14 h-14 bg-brand-500/10 rounded-2xl flex items-center justify-center text-brand-500 mb-6 border border-brand-500/20 group-hover:scale-110 transition-transform">
                    <i data-lucide="bell-ring" class="w-7 h-7"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">Actionable Pings</h3>
                <p class="text-slate-400 leading-relaxed">
                    Unlike "Stock Alarms" that beep every time a cent moves, we only reach out when a significant trend shift is detected. We respect your attention.
                </p>
            </div>

        </div>
    </section>

    <!-- The Side-by-Side Comparison -->
    <section class="py-24 bg-dark-900 border-y border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-white">How we stack up</h2>
                <p class="text-slate-400 mt-4">We aren't just simpler—we're significantly more affordable.</p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[800px]">
                    <thead>
                        <tr class="text-slate-400 border-b border-slate-700">
                            <th class="p-6 font-medium">Feature</th>
                            <th class="p-6 font-bold text-white bg-brand-500/10 rounded-t-2xl">StockSentry</th>
                            <th class="p-6 font-medium">Stock Alarm</th>
                            <th class="p-6 font-medium">TrendSpider</th>
                            <th class="p-6 font-medium">Trade Ideas</th>
                        </tr>
                    </thead>
                    <tbody class="text-slate-300 divide-y divide-slate-800">
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">Starting Price</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">$19.99/mo</td>
                            <td class="p-6">$9.99/mo</td>
                            <td class="p-6">$82.00/mo</td>
                            <td class="p-6">$127.00/mo</td>
                        </tr>
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">"Standard" AI Alerts</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">Included</td>
                            <td class="p-6">Limited (10)</td>
                            <td class="p-6">Standard Tier</td>
                            <td class="p-6">Premium Tier Only</td>
                        </tr>
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">Analysis Type</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">Plain English AI</td>
                            <td class="p-6">Price Triggers</td>
                            <td class="p-6">Technical Charts</td>
                            <td class="p-6">Quantitative Data</td>
                        </tr>
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">Delivery Method</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">Telegram (Fast)</td>
                            <td class="p-6">App Push/SMS</td>
                            <td class="p-6">Browser/App</td>
                            <td class="p-6">Desktop Software</td>
                        </tr>
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">AI Intelligence</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">LLM (Plain English)</td>
                            <td class="p-6">None (Static)</td>
                            <td class="p-6">Sidekick LLM</td>
                            <td class="p-6">Statistical (Holly)</td>
                        </tr>
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">Live Performance Audit</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">Daily Self-Tracking</td>
                            <td class="p-6">None</td>
                            <td class="p-6">Backtesting Only</td>
                            <td class="p-6">Backtesting Only</td>
                        </tr>
                        <tr class="hover:bg-white/5 transition">
                            <td class="p-6 font-medium text-white">Free Trial</td>
                            <td class="p-6 font-bold text-brand-500 bg-brand-500/5">14 Days (Full)</td>
                            <td class="p-6">Very Limited</td>
                            <td class="p-6">$19 (Paid)</td>
                            <td class="p-6">None</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-8 text-xs text-slate-500 text-center">*Competitor pricing based on published standard monthly rates as of May 2026.</p>
        </div>
    </section>

    <!-- Final Call to Action -->
    <section class="py-24 px-4">
        <div class="max-w-4xl mx-auto bg-gradient-to-br from-brand-600 to-brand-700 rounded-[2.5rem] p-8 md:p-16 text-center shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10 pointer-events-none"></div>
            
            <div class="relative z-10">
                <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Experience the future of personal monitoring.</h2>
                <p class="text-brand-50 mb-12 text-lg md:text-xl max-w-2xl mx-auto opacity-90">
                    Try the full Pro experience for 14 days. No credit card required. No obligation. If you don't love the Sentry, simply walk away.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
                    <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="w-full sm:w-auto bg-white text-brand-600 px-10 py-5 rounded-2xl font-bold text-xl hover:scale-105 transition-transform shadow-2xl flex items-center justify-center gap-2">
                        <i data-lucide="send" class="w-6 h-6"></i>
                        Start Free Trial
                    </a>
                    <a href="/pricing" class="text-white font-medium hover:text-brand-100 transition flex items-center gap-2">
                        See all plans <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>

                <div class="mt-12 pt-8 border-t border-white/10 grid grid-cols-2 md:grid-cols-3 gap-4 text-brand-50 text-sm">
                    <div class="flex items-center justify-center gap-2">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> No Card Needed
                    </div>
                    <div class="flex items-center justify-center gap-2">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> 14-Day Pro Access
                    </div>
                    <div class="flex items-center justify-center gap-2 col-span-2 md:col-span-1">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> No Auto-Subscription
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<script>
    import { 
        createIcons, 
        EyeOff, 
        BrainCircuit, 
        MessageSquareMore, 
        Search, 
        Lock, 
        BellRing, 
        ShieldCheck,
        Send,
        ArrowRight,
        CheckCircle
    } from 'lucide';
    
    createIcons({
        icons: { 
            EyeOff, 
            BrainCircuit, 
            MessageSquareMore, 
            Search, 
            Lock, 
            BellRing, 
            ShieldCheck,
            Send,
            ArrowRight,
            CheckCircle
        }
    });
</script>

