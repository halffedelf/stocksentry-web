---
import MainLayout from '../layouts/MainLayout.astro';
import PricingCard from '../components/PricingCard.astro';

const tiers = [
  {
    title: "Free Trial",
    description: "Test drive the Pro features for two weeks. No credit card required.",
    price: "$0",
    period: "/14 days",
    buttonText: "Start Free Trial",
    features: [
      { label: "<strong class='text-white'>25</strong> Tracked Tickers", active: true },
      { label: "<strong class='text-white'>25</strong> Manual /checks per day", active: true },
      { label: "<strong class='text-white'>Daily</strong> S&P 100 Discovery Scan", active: true },
      { label: "Daily Morning Briefing", active: true },
      { label: "NASDAQ 100 Scans", active: false },
    ]
  },
  {
    title: "Basic",
    description: "For casual investors watching a tight list of specific assets.",
    price: "$19.99",
    period: "/month",
    buttonText: "Subscribe",
    features: [
      { label: "<strong class='text-white'>10</strong> Tracked Tickers", active: true },
      { label: "<strong class='text-white'>10</strong> Manual /checks per day", active: true },
      { label: "<strong class='text-white'>Weekly</strong> S&P 100 Discovery Scan", active: true },
      { label: "Daily Morning Briefing", active: true },
      { label: "NASDAQ 100 Scans", active: false },
    ]
  },
  {
    title: "Pro",
    description: "For active swing traders managing broader portfolios.",
    price: "$29.99",
    period: "/month",
    buttonText: "Subscribe",
    highlight: true,
    features: [
      { label: "<strong class='text-white'>25</strong> Tracked Tickers", active: true },
      { label: "<strong class='text-white'>25</strong> Manual /checks per day", active: true },
      { label: "<strong class='text-white'>Daily</strong> S&P 100 Discovery Scan", active: true },
      { label: "Daily Morning Briefing", active: true },
      { label: "NASDAQ 100 Scans", active: false },
    ]
  },
  {
    title: "Premium",
    description: "Unrestricted access and expanded market discovery.",
    price: "$49.99",
    period: "/month",
    buttonText: "Subscribe",
    features: [
      { label: "<strong class='text-white'>100</strong> Tracked Tickers", active: true },
      { label: "<strong class='text-white'>100</strong> Manual /checks per day", active: true },
      { label: "<strong class='text-white'>Daily</strong> S&P 100 Scan", active: true },
      { label: "<strong class='text-white'>Daily</strong> NASDAQ 100 Scan", active: true },
      { label: "Daily Morning Briefing", active: true },
    ]
  }
];
---

<MainLayout title="Pricing">
    <!-- Header -->
    <header class="pt-32 pb-12 px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Delegate your technical analysis.</h1>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-8">
            Choose the capacity that fits your portfolio. All plans include automated 30-minute monitoring, AI assessments, and plain-English Telegram alerts.
        </p>
    </header>

    <!-- Pricing Cards -->
    <section class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 pb-24">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 items-start mt-8">
            {tiers.map(tier => (
                <PricingCard {...tier} />
            ))}
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="border-t border-slate-800 bg-dark-800/50 py-24">
        <div class="max-w-3xl mx-auto px-4">
            <h2 class="text-3xl font-bold text-white mb-12 text-center">Frequently Asked Questions</h2>
            
            <div class="space-y-8">
                <div>
                    <h3 class="text-lg font-bold text-white mb-2">How does the free trial work?</h3>
                    <p class="text-slate-400 text-sm">You get 14 days of full access to the Pro tier. We do not require a credit card upfront. When your trial ends, the bot will message you with a link to subscribe via Stripe to keep your watchlist active.</p>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-2">How are payments processed?</h3>
                    <p class="text-slate-400 text-sm">All payments are securely handled by Stripe. StockSentry never sees or stores your payment information. You will receive a unique checkout link directly inside your Telegram chat.</p>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-2">How do I cancel?</h3>
                    <p class="text-slate-400 text-sm">You can cancel anytime by typing <code>/account</code> in the bot. It will provide a link to your Stripe customer portal where you can cancel your subscription with one click. Your access will continue until the end of your billing cycle.</p>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-2">Can I upgrade or downgrade later?</h3>
                    <p class="text-slate-400 text-sm">Yes. You can manage your tier from your Stripe portal at any time. Pricing adjustments are prorated automatically.</p>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
