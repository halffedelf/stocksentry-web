                                <td class="p-5">Quantitative</td>
                            </tr>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-5 font-medium text-white">LLM intelligence</td>
                                <td class="p-5 bg-brand-500/5"><i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i></td>
                                <td class="p-5"><i data-lucide="x-circle" class="w-5 h-5 text-slate-700"></i></td>
                                <td class="p-5"><i data-lucide="check-circle-2" class="w-5 h-5 text-slate-500"></i></td>
                                <td class="p-5"><i data-lucide="check-circle-2" class="w-5 h-5 text-slate-500"></i></td>
                            </tr>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-5 font-medium text-white">News sentiment in alerts</td>
                                <td class="p-5 bg-brand-500/5"><i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i></td>
                                <td class="p-5"><i data-lucide="x-circle" class="w-5 h-5 text-slate-700"></i></td>
                                <td class="p-5 text-slate-400">Add-on</td>
                                <td class="p-5 text-slate-400">Limited</td>
                            </tr>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-5 font-medium text-white">Risk shields built-in</td>
                                <td class="p-5 bg-brand-500/5 text-white font-semibold">Trailing + −10% floor</td>
                                <td class="p-5"><i data-lucide="x-circle" class="w-5 h-5 text-slate-700"></i></td>
                                <td class="p-5 text-slate-400">Manual setup</td>
                                <td class="p-5 text-slate-400">Configurable</td>
                            </tr>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-5 font-medium text-white">Live performance audit</td>
                                <td class="p-5 bg-brand-500/5"><i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i></td>
                                <td class="p-5"><i data-lucide="x-circle" class="w-5 h-5 text-slate-700"></i></td>
                                <td class="p-5 text-slate-400">Backtesting only</td>
                                <td class="p-5 text-slate-400">Backtesting only</td>
                            </tr>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-5 font-medium text-white">Free trial</td>
                                <td class="p-5 bg-brand-500/5 text-brand-500 font-bold">14 days (full)</td>
                                <td class="p-5 text-slate-400">Very limited</td>
                                <td class="p-5 text-slate-400">$19 (paid)</td>
                                <td class="p-5 text-slate-400">None</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
