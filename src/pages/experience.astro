---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="The Experience">
    <!-- Page Header -->
    <header class="pt-32 pb-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800 bg-dark-800/50">
        <div class="max-w-3xl mx-auto text-center">
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/20">
                The Experience
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Elite oversight, delivered.</h1>
            <p class="text-xl text-[var(--text-base)]">
                Most trading tools are built for <strong>"Full-time Quants."</strong> We built StockSentry for the <strong>99% of investors</strong> who have jobs, families, and lives, but still want professional-grade market oversight.
            </p>
        </div>
    </header>

    <!-- Main Content -->
    <main class="py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto space-y-32">

        <!-- Experience Steps Flow -->
        <div class="space-y-40">
            
            <!-- Step 1: Telegram Setup -->
            <section class="reveal-item">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center text-brand-500 font-bold shrink-0 shadow-lg">1</div>
                            <h2 class="text-3xl font-bold text-white">Connect via Telegram</h2>
                        </div>
                        <p class="text-lg text-[var(--text-muted)] mb-8 leading-relaxed">Connect in seconds. StockSentry lives entirely within Telegram—private, conversational, and always in your pocket.</p>
                        <div class="bg-dark-800/50 rounded-2xl p-6 border border-slate-700">
                             <ul class="space-y-4">
                                <li class="flex items-center gap-4">
                                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center text-brand-500"><i data-lucide="download" class="w-4 h-4"></i></div>
                                    <span class="text-sm"><strong>Download Telegram:</strong> Available for iOS, Android, or Desktop.</span>
                                </li>
                                <li class="flex items-center gap-4">
                                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center text-brand-500"><i data-lucide="user-plus" class="w-4 h-4"></i></div>
                                    <span class="text-sm"><strong>Create Account:</strong> Privacy first. StockSentry cannot see your phone number.</span>
                                </li>
                                <li class="flex items-center gap-4">
                                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center text-brand-500"><i data-lucide="play" class="w-4 h-4"></i></div>
                                    <span class="text-sm"><strong>Start Chat:</strong> Visit <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="text-brand-500 font-bold hover:underline">@StockSentryAYS_bot</a></span>
                                </li>
                             </ul>
                        </div>
                    </div>
                    <!-- Visual: Phone Mockup 1: Bot Profile -->
                    <div class="relative mx-auto w-full max-w-[340px]">
                        <!-- Hardware Buttons -->
                        <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                        <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                        <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                        <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                            <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner flex flex-col h-[560px]">
                                <!-- Screen Reflection/Glare -->
                                <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>

                                <!-- Hardware Notch -->
                                <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                                    <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                        <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                        <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                                    </div>
                                </div>
                                
                                <!-- Bot Info Content -->
                                <div class="flex-grow bg-[#17212b] flex flex-col relative z-20 pt-8">
                                    <div class="h-48 bg-dark-800 flex flex-col items-center justify-center p-6 border-b border-white/5 mt-4">
                                        <div class="w-24 h-24 rounded-full bg-brand-900 flex items-center justify-center border-2 border-brand-500 mb-4 shadow-lg shadow-brand-500/20">
                                            <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="6" stroke-linejoin="round"/>
                                                <path d="M30 65L45 45L55 55L70 30" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                                                <circle cx="70" cy="30" r="4" fill="var(--brand-500)"/>
                                            </svg>
                                        </div>
                                        <h3 class="text-white font-bold text-lg">StockSentry</h3>
                                        <p class="text-slate-400 text-xs mt-1">bot</p>
                                    </div>
                                    <div class="p-6 space-y-6 flex-grow bg-dark-900">
                                        <div>
                                            <p class="text-[#4da3ff] text-xs font-bold uppercase mb-2">Info</p>
                                            <p class="text-white text-sm leading-relaxed">Proactive AI Market Oversight. Monitoring the S&P 100 & NASDAQ 100 for actionable trends.</p>
                                            <p class="text-slate-500 text-xs mt-1">Bio</p>
                                        </div>
                                        <div>
                                            <p class="text-white text-sm">@StockSentryAYS_bot</p>
                                            <p class="text-slate-500 text-xs mt-1">Username</p>
                                        </div>
                                        <div class="flex gap-4">
                                            <div class="flex-grow bg-[#242f3d] py-2 rounded-lg text-[#4da3ff] text-xs font-bold text-center border border-slate-700/50">SEND MESSAGE</div>
                                            <div class="w-10 h-10 bg-[#242f3d] rounded-lg flex items-center justify-center text-[#4da3ff] border border-slate-700/50"><i data-lucide="bell" class="w-4 h-4"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Step 2: Discovery Scan -->
            <section class="reveal-item">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div class="order-2 lg:order-1">
                        <div class="relative mx-auto w-full max-w-[340px]">
                            <!-- Hardware Buttons -->
                            <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                            <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                            <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                            <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                                <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner flex flex-col h-[560px]">
                                    <!-- Screen Reflection/Glare -->
                                    <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>

                                    <!-- Hardware Notch -->
                                    <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                                        <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                            <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                            <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                                        </div>
                                    </div>

                                    <div class="bg-dark-800 border-b border-slate-700 pt-8 pb-3 px-4 flex items-center gap-3 relative z-20">
                                        <div class="w-8 h-8 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0"><i data-lucide="activity" class="w-4 h-4 text-brand-500"></i></div>
                                        <div class="text-white font-bold text-sm">StockSentry</div>
                                    </div>
                                    <div class="p-4 space-y-4 flex-grow flex flex-col justify-start bg-dark-900 relative pt-6 overflow-hidden">
                                        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"></div>
                                        
                                        <div class="bg-dark-800 text-[var(--text-base)] p-4 rounded-2xl rounded-tl-sm text-[11px] leading-relaxed border border-slate-700 italic relative z-10 shadow-md">
                                            <p class="mb-2">📊 [04:30]</p>
                                            <p class="mb-2"><strong>👀 WATCHLIST CANDIDATE — DUK</strong><br>
                                            Duke Energy Corporation | Utilities<br>
                                            Current price: $124.17</p>
                                            <p class="mb-2">Duke has pulled back to a level where it's been finding buyers before, and the stock looks stretched to the downside — meaning it may be due for a bounce back toward its normal range. With a healthy dividend, a reasonable valuation, and a major analyst just raising their price target, this is a solid defensive addition that balances out your tech-heavy portfolio.</p>
                                            <p>Suggested allocation: 5% of portfolio<br>
                                            Stop-loss if you enter: $119.86 | Risk/reward: 1:2.9</p>
                                        </div>

                                    </div>
                                    
                                    <!-- Simulated Message Input -->
                                    <div class="bg-dark-800 border-t border-slate-700 p-3 flex items-center gap-2 relative z-20">
                                        <i data-lucide="paperclip" class="w-4 h-4 text-slate-400"></i>
                                        <div class="flex-grow bg-dark-900 border border-slate-700 rounded-full h-8 px-3 flex items-center">
                                            <span class="text-slate-500 text-xs">Message...</span>
                                        </div>
                                        <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center">
                                            <i data-lucide="mic" class="w-4 h-4 text-white"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order-1 lg:order-2">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center text-brand-500 font-bold shrink-0 shadow-lg">2</div>
                            <h2 class="text-3xl font-bold text-white">Find fresh opportunities</h2>
                        </div>
                        <p class="text-lg text-[var(--text-muted)] mb-8 leading-relaxed">Don't know what to trade? Every afternoon, the Sentry sweeps the market for high-probability setups that aren't on your radar yet.</p>
                        <div class="flex items-center gap-4 text-brand-500 text-sm font-bold">
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-4 h-4"></i> Automated Scans</div>
                            <div class="flex items-center gap-1"><i data-lucide="check" class="w-4 h-4"></i> S&P 100 Coverage</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Step 3: /watch Command -->
            <section class="reveal-item">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center text-brand-500 font-bold shrink-0 shadow-lg">3</div>
                            <h2 class="text-3xl font-bold text-white">Build your watchlist</h2>
                        </div>
                        <p class="text-lg text-[var(--text-muted)] mb-8 leading-relaxed">Tell the agent which tickers to monitor. Use the <code>/watch</code> command to add any stock for constant analysis.</p>
                        <button class="copy-cmd w-full max-w-sm text-left bg-dark-800 p-5 rounded-2xl border border-slate-700 hover:border-brand-500/50 transition group flex justify-between items-center shadow-lg" data-cmd="/watch AVGO">
                            <div>
                                <code class="text-brand-500 font-mono text-lg">/watch AVGO</code>
                                <p class="text-[10px] text-slate-500 mt-1 uppercase font-bold tracking-wider">Add to watchlist</p>
                            </div>
                            <i data-lucide="copy" class="w-5 h-5 text-slate-600 group-hover:text-brand-500 transition"></i>
                        </button>
                    </div>
                    <div class="relative mx-auto w-full max-w-[340px]">
                        <!-- Hardware Buttons -->
                        <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                        <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                        <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                        <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                            <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner flex flex-col h-[560px]">
                                <!-- Screen Reflection/Glare -->
                                <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>

                                <!-- Hardware Notch -->
                                <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                                    <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                        <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                        <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                                    </div>
                                </div>

                                <div class="bg-dark-800 border-b border-slate-700 pt-8 pb-3 px-4 flex items-center gap-3 relative z-20">
                                    <div class="w-8 h-8 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0"><i data-lucide="activity" class="w-4 h-4 text-brand-500"></i></div>
                                    <div class="text-white font-bold text-sm">StockSentry</div>
                                </div>
                                <div class="p-4 space-y-3 flex-grow flex flex-col justify-end bg-dark-900 relative pb-6">
                                    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"></div>
                                    <div class="bg-brand-500 text-white px-4 py-2 rounded-2xl rounded-tr-sm self-end text-[13px] relative z-10 shadow-md">/watch AVGO</div>
                                    <div class="bg-dark-800 text-white px-4 py-3 rounded-2xl rounded-tl-sm self-start border border-slate-700 text-[12px] leading-relaxed relative z-10 shadow-md">🔍 Validating AVGO...</div>
                                    <div class="bg-dark-800 text-white px-4 py-3 rounded-2xl rounded-tl-sm self-start border border-slate-700 text-[12px] leading-relaxed relative z-10 shadow-md mt-1">👀 Added <strong>AVGO</strong> (Broadcom Inc.) to your watchlist. I'll alert you when it looks like a good entry point.</div>
                                </div>
                                <!-- Simulated Message Input -->
                                <div class="bg-dark-800 border-t border-slate-700 p-3 flex items-center gap-2 relative z-20">
                                    <i data-lucide="paperclip" class="w-4 h-4 text-slate-400"></i>
                                    <div class="flex-grow bg-dark-900 border border-slate-700 rounded-full h-8 px-3 flex items-center">
                                        <span class="text-slate-500 text-xs">Message...</span>
                                    </div>
                                    <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center"><i data-lucide="mic" class="w-4 h-4 text-white"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Step 4: /bought Command -->
            <section class="reveal-item">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div class="order-2 lg:order-1">
                        <!-- Visual: Phone Mockup 4 -->
                        <div class="relative mx-auto w-full max-w-[340px]">
                            <!-- Hardware Buttons -->
                            <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                            <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                            <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>

                            <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                                <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner flex flex-col h-[560px]">
                                    <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>
                                    <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                                        <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                            <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                            <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                                        </div>
                                    </div>
                                    <div class="bg-dark-800 border-b border-slate-700 pt-8 pb-3 px-4 flex items-center gap-3 relative z-20">
                                        <div class="w-8 h-8 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0"><i data-lucide="activity" class="w-4 h-4 text-brand-500"></i></div>
                                        <div class="text-white font-bold text-sm">StockSentry</div>
                                    </div>
                                    <div class="p-4 space-y-3 flex-grow flex flex-col justify-end bg-dark-900 relative pb-6">
                                        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"></div>
                                        <div class="bg-brand-500 text-white px-4 py-2 rounded-2xl rounded-tr-sm self-end text-[13px] relative z-10 shadow-md">/bought AAPL 190.50</div>
                                        <div class="bg-dark-800 text-white px-4 py-3 rounded-2xl rounded-tl-sm self-start border border-slate-700 text-[12px] leading-relaxed relative z-10 shadow-md">🔍 Validating AAPL...</div>
                                        <div class="bg-dark-800 text-white px-4 py-3 rounded-2xl rounded-tl-sm self-start border border-slate-700 text-[12px] leading-relaxed relative z-10 shadow-md mt-1">✅ Logged <strong>AAPL</strong> (Apple Inc.) at <strong>$190.50</strong>. I'll monitor it and alert you when action is needed.</div>
                                    </div>
                                    <!-- Simulated Message Input -->
                                    <div class="bg-dark-800 border-t border-slate-700 p-3 flex items-center gap-2 relative z-20">
                                        <i data-lucide="paperclip" class="w-4 h-4 text-slate-400"></i>
                                        <div class="flex-grow bg-dark-900 border border-slate-700 rounded-full h-8 px-3 flex items-center">
                                            <span class="text-slate-500 text-xs">Message...</span>
                                        </div>
                                        <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center"><i data-lucide="mic" class="w-4 h-4 text-white"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="order-1 lg:order-2">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center text-brand-500 font-bold shrink-0 shadow-lg">4</div>
                            <h2 class="text-3xl font-bold text-white">Log your positions</h2>
                        </div>
                        <p class="text-lg text-[var(--text-muted)] mb-8 leading-relaxed">When you enter a trade, tell the agent your exact price. This allows it to calculate <strong>precise stop-loss levels</strong> tailored to your specific entry.</p>
                        <button class="copy-cmd w-full max-w-sm text-left bg-dark-800 p-5 rounded-2xl border border-slate-700 hover:border-brand-500/50 transition group flex justify-between items-center shadow-lg" data-cmd="/bought AAPL 190.50">
                            <div>
                                <code class="text-brand-500 font-mono text-lg">/bought AAPL 190.50</code>
                                <p class="text-[10px] text-slate-500 mt-1 uppercase font-bold tracking-wider">Start position tracking</p>
                            </div>
                            <i data-lucide="copy" class="w-5 h-5 text-slate-600 group-hover:text-brand-500 transition"></i>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Step 5: Monitoring -->
            <section class="reveal-item">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-full bg-dark-800 border border-slate-700 flex items-center justify-center text-brand-500 font-bold shrink-0 shadow-lg">5</div>
                            <h2 class="text-3xl font-bold text-white">Delegate the monitoring</h2>
                        </div>
                        <p class="text-lg text-[var(--text-muted)] mb-8 leading-relaxed">The AI checks your positions <strong>every 30 minutes</strong> against 14 indicators and news sentiment. It handles the cognitive load while you focus on your life.</p>
                        <div class="bg-dark-800 border border-slate-700 rounded-2xl p-6 flex items-center gap-6">
                             <div class="w-16 h-16 rounded-full bg-brand-500/10 flex items-center justify-center text-brand-500 border border-brand-500/20 shadow-glow shadow-brand-500/5">
                                 <i data-lucide="activity" class="w-8 h-8"></i>
                             </div>
                             <div>
                                 <div class="text-white font-bold mb-1 text-sm">Constant Assessment</div>
                                 <p class="text-[10px] text-slate-500">Evaluating setup strength across all tracked positions.</p>
                             </div>
                        </div>
                    </div>
                    <!-- Visual: Phone Mockup 5 -->
                    <div class="relative mx-auto w-full max-w-[340px]">
                        <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                        <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md border-l border-slate-800/50 z-20"></div>
                        <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md border-r border-slate-800/50 z-20"></div>
                        <div class="bg-dark-950 rounded-[3rem] p-3 shadow-2xl relative z-10 border-2 border-slate-800/80 phone-glow">
                            <div class="bg-dark-900 rounded-[2.5rem] overflow-hidden relative border border-slate-800/50 shadow-inner flex flex-col h-[560px]">
                                <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>
                                <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                                    <div class="w-32 h-7 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-4 px-6">
                                        <div class="w-10 h-1 bg-slate-800 rounded-full"></div>
                                        <div class="w-2 h-2 bg-slate-800 rounded-full"></div>
                                    </div>
                                </div>
