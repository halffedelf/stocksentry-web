  <style is:global>
    .step-tab { transition: all .25s ease; }
    .step-tab[data-active="true"] {
      background: linear-gradient(180deg, rgba(255,122,26,.16) 0%, rgba(255,122,26,.04) 100%);
      border-color: rgba(255,122,26,.45);
    }
    .step-tab[data-active="true"] .step-number { background:#ff7a1a; color:#030712; border-color:#ff7a1a; }
    .step-tab[data-active="true"] .step-label { color:#fff; }
    .step-tab[data-active="true"] .step-eyebrow { color:#ff7a1a; }

    .screen-panel { opacity: 0; transition: opacity .35s ease, transform .35s ease; pointer-events:none; position:absolute; inset:0; transform: translateY(8px); }
    .screen-panel[data-active="true"] { opacity:1; pointer-events:auto; transform:none; position:relative; }

    .desc-panel { display:none; }
    .desc-panel[data-active="true"] { display:block; animation: fadein .35s ease; }
    @keyframes fadein { from { opacity:0; transform: translateY(6px);} to { opacity:1; transform:none;} }

    .persona-card { transition: transform .25s ease, border-color .25s ease; }
    .persona-card:hover { transform: translateY(-3px); border-color: rgba(255,122,26,.35); }

    .tg-bubble-bot { background:#0b1120; border:1px solid rgba(148,163,184,.12); border-radius: 16px 16px 16px 4px; padding: 12px 14px; font-size: 12px; line-height: 1.55; color:#e2e8f0; }
    .tg-bubble-user { background:#ff7a1a; color:#fff; border-radius: 16px 16px 4px 16px; padding: 8px 14px; font-size: 12px; align-self:flex-end; max-width: 80%; }
  </style>

  <script>
    const setupExperience = () => {
      const steps = [
        { n: 1, label: 'Connect',  icon: 'link' },
        { n: 2, label: 'Discover', icon: 'compass' },
        { n: 3, label: 'Watch',    icon: 'eye' },
        { n: 4, label: 'Log',      icon: 'check-square' },
        { n: 5, label: 'Monitor',  icon: 'activity' },
        { n: 6, label: 'Exit',     icon: 'log-out' },
        { n: 7, label: 'Briefing', icon: 'sun' },
      ];

      const rail = document.getElementById('step-rail');
      if (!rail) return;
      rail.innerHTML = steps.map(s => `
        <button class="step-tab text-left rounded-xl border border-slate-700 bg-dark-800 p-3 sm:p-4 group" data-step="${s.n}" ${s.n===1?'data-active="true"':''}>
          <div class="flex items-center gap-2.5 mb-1.5">
            <div class="step-number w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold font-mono border bg-dark-900 text-slate-500 border-slate-700">${String(s.n).padStart(2,'0')}</div>
            <i data-lucide="${s.icon}" class="w-4 h-4 text-slate-500 group-hover:text-brand-500 transition"></i>
          </div>
          <div class="step-eyebrow text-[10px] uppercase tracking-widest font-bold text-slate-500">Step ${String(s.n).padStart(2,'0')}</div>
          <div class="step-label text-sm font-semibold text-slate-300 mt-0.5">${s.label}</div>
        </button>
      `).join('');

      let current = 1;
      const total = steps.length;

      function setStep(n) {
        n = Math.max(1, Math.min(total, n));
        current = n;
        document.querySelectorAll('.step-tab').forEach(b => b.dataset.active = (Number(b.dataset.step) === n) ? 'true' : 'false');
        document.querySelectorAll('.screen-panel').forEach(p => p.dataset.active = (Number(p.dataset.screen) === n) ? 'true' : 'false');
        document.querySelectorAll('.desc-panel').forEach(p => p.dataset.active = (Number(p.dataset.desc) === n) ? 'true' : 'false');
        const progress = document.getElementById('step-progress');
        if (progress) progress.style.width = ((n / total) * 100) + '%';
        const counter = document.getElementById('step-counter');
        if (counter) counter.textContent = String(n).padStart(2,'0') + ' / ' + String(total).padStart(2,'0');
        const prev = document.getElementById('prev-step');
        const next = document.getElementById('next-step');
        if (prev) prev.disabled = (n === 1);
        if (next) next.disabled = (n === total);
        if (window.lucide) window.lucide.createIcons();
      }

      document.querySelectorAll('.step-tab').forEach(btn => btn.addEventListener('click', () => setStep(Number(btn.dataset.step))));
      document.getElementById('prev-step')?.addEventListener('click', () => setStep(current - 1));
      document.getElementById('next-step')?.addEventListener('click', () => setStep(current + 1));

      // Copy commands
      document.querySelectorAll('.copy-cmd').forEach(btn => {
        btn.addEventListener('click', () => {
          const cmd = btn.getAttribute('data-cmd');
          if (!cmd) return;
          navigator.clipboard?.writeText(cmd);
          const icon = btn.querySelector('i[data-lucide]');
          if (icon) {
            const orig = icon.getAttribute('data-lucide');
            icon.setAttribute('data-lucide', 'check');
            window.lucide?.createIcons();
            setTimeout(() => { icon.setAttribute('data-lucide', orig || 'copy'); window.lucide?.createIcons(); }, 1600);
          }
        });
      });

      setStep(1);
    };

    document.addEventListener('astro:page-load', setupExperience);
  </script>
