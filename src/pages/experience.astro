---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="The Experience">

  <!-- HERO -->
  <header class="pt-32 pb-12 px-4 sm:px-6 lg:px-8 relative">
    <div class="max-w-5xl mx-auto text-center reveal-direct">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-6 border border-brand-500/25">
        <i data-lucide="message-square-text" class="w-3 h-3"></i> The Experience
      </div>
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight leading-[1.05]">
        Elite oversight,<br/><span class="text-brand-500">delivered in simple commands.</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">Most trading tools are built for "full-time quants". We built StockSentry for the 99% of investors who have jobs, families, and lives, but still want professional-grade market oversight. Here is the whole experience.</p>
    </div>
  </header>

  <!-- ════════════════════════════════════════════════════════════════ -->
  <!-- INTERACTIVE STEPPED FLOW -->
  <!-- ════════════════════════════════════════════════════════════════ -->
  <section class="px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-7xl mx-auto">

      <!-- Step rail -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2 mb-8 reveal-direct" id="step-rail"></div>

      <!-- Progress bar -->
      <div class="relative h-0.5 bg-slate-800 rounded-full mb-12">
        <div class="absolute inset-y-0 left-0 bg-gradient-to-r from-brand-600 to-brand-500 rounded-full transition-all duration-300" id="step-progress" style="width: 14.28%"></div>
      </div>

      <!-- Main panel: phone (left) + description (right) -->
      <div class="grid lg:grid-cols-12 gap-12 items-center min-h-[640px]">

        <!-- PHONE -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto w-full max-w-[300px] phone-glow">
            <!-- Hardware buttons -->
            <div class="absolute left-[-2px] top-24 w-[3px] h-12 bg-slate-700 rounded-l-md z-20"></div>
            <div class="absolute left-[-2px] top-40 w-[3px] h-12 bg-slate-700 rounded-l-md z-20"></div>
            <div class="absolute right-[-2px] top-32 w-[3px] h-16 bg-slate-700 rounded-r-md z-20"></div>

            <div class="bg-dark-950 rounded-[2.5rem] p-2.5 shadow-2xl relative z-10 border-2 border-slate-800/80">
              <div class="bg-dark-900 rounded-[2rem] overflow-hidden relative border border-slate-800/50 shadow-inner h-[600px] flex flex-col">
                <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none z-30"></div>
                <div class="absolute top-0 inset-x-0 flex justify-center z-40">
                  <div class="w-28 h-6 bg-dark-950 rounded-b-3xl flex items-center justify-center gap-3 px-5">
                    <div class="w-8 h-1 bg-slate-800 rounded-full"></div>
                    <div class="w-1.5 h-1.5 bg-slate-800 rounded-full"></div>
                  </div>
                </div>

                <!-- TG header -->
                <div class="bg-dark-800 border-b border-slate-700 pt-7 pb-2.5 px-3.5 flex items-center gap-2.5 relative z-20">
                  <div class="w-7 h-7 rounded-full bg-brand-900 flex items-center justify-center border border-brand-500 shrink-0">
                    <svg width="14" height="14" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="8" stroke-linejoin="round"/>
                      <path d="M30 65L45 45L55 55L70 30" stroke="#fff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-white font-bold text-xs leading-tight">StockSentry</div>
                    <div class="text-brand-500 text-[10px] leading-tight">bot</div>
                  </div>
                </div>

                <!-- SCREEN AREA -->
                <div class="flex-1 relative bg-dark-900 overflow-hidden">
                  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 14px 14px;"></div>

                  <!-- Panel 1: Connect -->
                  <div class="screen-panel p-3.5 flex flex-col" data-screen="1" data-active="true">
                    <div class="bg-dark-800 rounded-2xl flex flex-col items-center justify-center py-6 border-b border-slate-700/40">
                      <div class="w-16 h-16 rounded-full bg-brand-900 flex items-center justify-center border-2 border-brand-500 mb-3 shadow-lg shadow-brand-500/30">
                        <svg width="28" height="28" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="6" stroke-linejoin="round"/>
                          <path d="M30 65L45 45L55 55L70 30" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                          <circle cx="70" cy="30" r="4" fill="var(--brand-500)"/>
                        </svg>
                      </div>
                      <h3 class="text-white font-bold text-sm">StockSentry</h3>
                      <p class="text-slate-400 text-[10px] mt-0.5">bot</p>
                    </div>
                    <div class="p-3 space-y-3 flex-1">
                      <div>
                        <p class="text-[#4da3ff] text-[9px] font-bold uppercase mb-1.5 tracking-wider">Info</p>
                        <p class="text-white text-[11px] leading-snug">Proactive AI market oversight. Monitoring the S&amp;P 100 &amp; NASDAQ 100 for actionable trends.</p>
                        <p class="text-slate-500 text-[9px] mt-1">Bio</p>
                      </div>
                      <div>
                        <p class="text-white text-[11px]">@StockSentryAYS_bot</p>
                        <p class="text-slate-500 text-[9px] mt-0.5">Username</p>
                      </div>
                      <div class="flex gap-2 pt-1">
                        <div class="flex-1 bg-[#242f3d] py-1.5 rounded-lg text-[#4da3ff] text-[10px] font-bold text-center border border-slate-700/50">SEND MESSAGE</div>
                        <div class="w-8 h-8 bg-[#242f3d] rounded-lg flex items-center justify-center text-[#4da3ff] border border-slate-700/50">
                          <i data-lucide="bell" class="w-3.5 h-3.5"></i>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Panel 2: Discovery -->
                  <div class="screen-panel p-3 flex flex-col" data-screen="2">
                    <div class="tg-bubble-bot mt-2">
                      <p class="text-[9px] text-slate-500 mb-1.5">📊 16:30</p>
                      <p class="font-bold text-white text-[12px] mb-2">👀 WATCHLIST CANDIDATE — DUK</p>
                      <p class="text-slate-300 mb-2 text-[11px]">Duke Energy · Utilities · <span class="font-mono">$124.17</span></p>
                      <div class="bg-dark-950/80 border border-brand-500/25 rounded-lg p-2.5 mb-2 space-y-1">
                        <div class="flex justify-between text-[10px]">
                          <span class="text-brand-500 font-bold uppercase tracking-wider">Verdict</span>
                          <span class="text-white font-bold">STRONG BUY</span>
                        </div>
                        <div class="flex justify-between text-[10px]">
                          <span class="text-brand-500 font-bold uppercase tracking-wider">Confidence</span>
                          <span class="text-white font-bold">88%</span>
                        </div>
                      </div>
                      <p class="text-[10px] text-slate-400 mb-1.5">Major buyer zone. 3-prong rubric shows strong technical alignment. Recent price-target hikes.</p>
                      <p class="text-[10px] text-slate-500 font-mono">Stop $119.86 · R/R 1:2.9</p>
                    </div>
                  </div>

                  <!-- Panel 3: /watch -->
                  <div class="screen-panel p-3 flex flex-col justify-end" data-screen="3">
                    <div class="space-y-2.5">
                      <div class="tg-bubble-user font-mono">/watch AVGO</div>
                      <div class="tg-bubble-bot">🔍 Validating AVGO…</div>
                      <div class="tg-bubble-bot">👀 Added <strong class="text-white">AVGO</strong> (Broadcom Inc.) to your watchlist. I'll alert you when it looks like a good entry point.</div>
                    </div>
                  </div>

                  <!-- Panel 4: /bought -->
                  <div class="screen-panel p-3 flex flex-col justify-end" data-screen="4">
                    <div class="space-y-2.5">
                      <div class="tg-bubble-user font-mono">/bought AAPL 190.50</div>
                      <div class="tg-bubble-bot">🔍 Validating AAPL…</div>
                      <div class="tg-bubble-bot">✅ Logged <strong class="text-white">AAPL</strong> at <span class="text-brand-500 font-mono font-bold">$190.50</span>. Monitoring activated — I'll alert you when action is needed.</div>
                    </div>
                  </div>

                  <!-- Panel 5: Monitoring -->
                  <div class="screen-panel p-3 flex flex-col items-center justify-center" data-screen="5">
                    <div class="w-20 h-20 rounded-full bg-brand-500/10 flex items-center justify-center border border-brand-500/30 mb-5 relative">
                      <i data-lucide="shield-check" class="w-10 h-10 text-brand-500"></i>
                      <div class="absolute inset-0 rounded-full border-2 border-brand-500/30 animate-ping"></div>
                    </div>
                    <h4 class="text-white font-bold text-sm mb-1.5">Active Oversight</h4>
                    <p class="text-slate-400 text-[11px] text-center px-4 leading-relaxed">Scanning your positions every 30 minutes against 14 indicators &amp; news sentiment.</p>
                    <div class="mt-5 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/25 flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      <span class="text-[10px] font-mono text-brand-500 tracking-widest uppercase">Live</span>
                    </div>
                  </div>

                  <!-- Panel 6: /sold -->
                  <div class="screen-panel p-3 flex flex-col justify-end" data-screen="6">
                    <div class="space-y-2.5">
                      <div class="tg-bubble-user font-mono">/sold META</div>
                      <div class="tg-bubble-bot">✅ Cleared <strong class="text-white">META</strong> from active monitoring. Final P&amp;L recorded for your daily briefing audit.</div>
                    </div>
                  </div>

                  <!-- Panel 7: Daily briefing -->
                  <div class="screen-panel p-3 flex flex-col" data-screen="7">
                    <div class="tg-bubble-bot mt-2">
                      <p class="text-[11px] font-bold text-white mb-2">☀️ MORNING BRIEFING</p>
                      <div class="space-y-2 text-[10px]">
                        <div class="flex justify-between items-center"><span class="text-white font-mono">AMZN</span><span class="text-emerald-400 font-mono font-bold">🟢 +162.4%</span></div>
                        <div class="flex justify-between items-center"><span class="text-white font-mono">GOOG</span><span class="text-emerald-400 font-mono font-bold">🟢 +24.4%</span></div>
                        <div class="flex justify-between items-center"><span class="text-white font-mono">META</span><span class="text-rose-400 font-mono font-bold">🔴 −9.6%</span></div>
                        <div class="pt-2 mt-1 border-t border-slate-700 flex justify-between items-center"><span class="text-slate-400 text-[10px] uppercase tracking-wider font-bold">Avg P&amp;L</span><span class="text-brand-500 font-mono font-bold text-[12px]">+32.2%</span></div>
                      </div>
                      <p class="text-[10px] text-slate-400 mt-3 pt-2.5 border-t border-slate-700 italic">"Steady hands. Core positions trending well."</p>
                    </div>
                  </div>
                </div>

                <!-- TG input -->
                <div class="bg-dark-800 border-t border-slate-700 p-2.5 flex items-center gap-2 relative z-20">
                  <i data-lucide="paperclip" class="w-3.5 h-3.5 text-slate-400"></i>
                  <div class="flex-1 bg-dark-900 border border-slate-700 rounded-full h-7 px-3 flex items-center">
                    <span class="text-slate-500 text-[10px]">Message…</span>
                  </div>
                  <div class="w-7 h-7 rounded-full bg-brand-600 flex items-center justify-center"><i data-lucide="mic" class="w-3.5 h-3.5 text-white"></i></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- DESCRIPTION PANELS -->
        <div class="lg:col-span-7" id="desc-area">

          <div class="desc-panel" data-desc="1" data-active="true">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 01 · Connect</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Connect via Telegram.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">StockSentry lives entirely inside Telegram — private, conversational, and always in your pocket. No new app to install. No broker linking. Setup takes under a minute.</p>
            <div class="grid sm:grid-cols-3 gap-3">
              <div class="rounded-xl border border-slate-700 bg-dark-800 p-4">
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500 mb-2"><i data-lucide="download" class="w-4 h-4"></i></div>
                <div class="text-white text-sm font-semibold mb-1">Install Telegram</div>
                <div class="text-xs text-slate-500">iOS, Android, or desktop.</div>
              </div>
              <div class="rounded-xl border border-slate-700 bg-dark-800 p-4">
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500 mb-2"><i data-lucide="user-plus" class="w-4 h-4"></i></div>
                <div class="text-white text-sm font-semibold mb-1">Anonymous ID</div>
                <div class="text-xs text-slate-500">We never see your phone.</div>
              </div>
              <div class="rounded-xl border border-slate-700 bg-dark-800 p-4">
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/25 flex items-center justify-center text-brand-500 mb-2"><i data-lucide="play" class="w-4 h-4"></i></div>
                <div class="text-white text-sm font-semibold mb-1">Open the bot</div>
                <div class="text-xs text-slate-500"><a href="https://t.me/StockSentryAYS_bot" target="_blank" class="font-mono text-brand-500 hover:underline">@StockSentryAYS_bot</a></div>
              </div>
            </div>
          </div>

          <div class="desc-panel" data-desc="2">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 02 · Discover</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Find high-confidence setups.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">The Sentry doesn't just find stocks — it evaluates them. Every afternoon it sweeps the S&amp;P 100 (and NASDAQ 100 on Premium) through a 3-prong rubric and surfaces only the high-confidence candidates.</p>
            <div class="space-y-2.5">
              <div class="flex items-center gap-3 rounded-xl border border-slate-700 bg-dark-800 px-4 py-3">
                <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-500 shrink-0"></i>
                <span class="text-sm text-slate-300"><strong class="text-white">Confidence engine</strong> — 0–100% rubric score, technical + fundamental + macro.</span>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-700 bg-dark-800 px-4 py-3">
                <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-500 shrink-0"></i>
                <span class="text-sm text-slate-300"><strong class="text-white">Sentiment catalyst</strong> — fresh news weighted into every verdict.</span>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-slate-700 bg-dark-800 px-4 py-3">
                <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-500 shrink-0"></i>
                <span class="text-sm text-slate-300"><strong class="text-white">No noise</strong> — only high-confidence picks reach your chat.</span>
              </div>
            </div>
          </div>

          <div class="desc-panel" data-desc="3">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 03 · Watch</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Build your watchlist.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">Tell the agent which tickers to monitor. One command — the Sentry takes it from there, scanning the chart and the news for the right entry moment.</p>
            <button class="copy-cmd group w-full max-w-md text-left bg-dark-800 p-5 rounded-2xl border border-slate-700 hover:border-brand-500/50 transition flex justify-between items-center" data-cmd="/watch AVGO">
              <div>
                <code class="text-brand-500 font-mono text-lg block">/watch AVGO</code>
                <p class="text-[10px] text-slate-500 mt-1 uppercase font-bold tracking-wider">Tap to copy</p>
              </div>
              <i data-lucide="copy" class="w-5 h-5 text-slate-600 group-hover:text-brand-500 transition"></i>
            </button>
          </div>

          <div class="desc-panel" data-desc="4">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 04 · Log</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Log your positions.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">When you enter a trade, tell the Sentry your exact fill price. That lets it calculate stop-loss levels and R/R tailored to your entry — not a generic average.</p>
            <button class="copy-cmd group w-full max-w-md text-left bg-dark-800 p-5 rounded-2xl border border-slate-700 hover:border-brand-500/50 transition flex justify-between items-center" data-cmd="/bought AAPL 190.50">
              <div>
                <code class="text-brand-500 font-mono text-lg block">/bought AAPL 190.50</code>
                <p class="text-[10px] text-slate-500 mt-1 uppercase font-bold tracking-wider">Tap to copy</p>
              </div>
              <i data-lucide="copy" class="w-5 h-5 text-slate-600 group-hover:text-brand-500 transition"></i>
            </button>
          </div>

          <div class="desc-panel" data-desc="5">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 05 · Monitor</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Delegate the monitoring.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">The Sentry re-checks every position every 30 minutes against 14 technical indicators and live news sentiment. You get a ping <em class="text-white not-italic font-semibold">only</em> when it's time to act.</p>
            <div class="grid grid-cols-3 gap-3">
              <div class="rounded-xl border border-slate-700 bg-dark-800 p-4 text-center">
                <div class="font-mono text-2xl font-bold text-white mb-1">30<span class="text-slate-500 text-base">m</span></div>
                <div class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">Re-check cadence</div>
              </div>
              <div class="rounded-xl border border-slate-700 bg-dark-800 p-4 text-center">
                <div class="font-mono text-2xl font-bold text-white mb-1">14</div>
                <div class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">Indicators</div>
              </div>
              <div class="rounded-xl border border-slate-700 bg-dark-800 p-4 text-center">
                <div class="font-mono text-2xl font-bold text-white mb-1">24<span class="text-slate-500 text-base">/7</span></div>
                <div class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">Background</div>
              </div>
            </div>
          </div>

          <div class="desc-panel" data-desc="6">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 06 · Exit</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Exit with precision.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">When the trend breaks, you get an alert. When you've exited the trade, <code class="font-mono text-brand-500">/sold</code> clears the ticker and locks the trade into your performance audit.</p>
            <button class="copy-cmd group w-full max-w-md text-left bg-dark-800 p-5 rounded-2xl border border-slate-700 hover:border-brand-500/50 transition flex justify-between items-center" data-cmd="/sold META">
              <div>
                <code class="text-brand-500 font-mono text-lg block">/sold META</code>
                <p class="text-[10px] text-slate-500 mt-1 uppercase font-bold tracking-wider">Tap to copy</p>
              </div>
              <i data-lucide="copy" class="w-5 h-5 text-slate-600 group-hover:text-brand-500 transition"></i>
            </button>
          </div>

          <div class="desc-panel" data-desc="7">
            <div class="text-brand-500 font-mono text-xs font-bold uppercase tracking-widest mb-3">Step 07 · Briefing</div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Daily P&amp;L briefing.</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-6">Every morning at 8:30 AM, a concise report lands in Telegram — every active position, current P&amp;L, and the day's macro context. The whole portfolio in 30 seconds.</p>
            <div class="rounded-2xl border border-brand-500/30 bg-brand-500/5 p-5">
              <div class="text-brand-500 text-xs font-bold uppercase tracking-widest mb-2">Sample line</div>
              <p class="text-white italic text-base leading-relaxed">"Good morning! Portfolio currently <span class="text-brand-500 font-bold not-italic font-mono">+32.2%</span>. Steady hands — core positions trending well."</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Nav arrows -->
      <div class="flex items-center justify-between mt-12 pt-8 border-t border-slate-800">
        <button id="prev-step" class="flex items-center gap-2 text-slate-400 hover:text-white transition text-sm font-medium disabled:opacity-30 disabled:cursor-not-allowed">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> Previous step
        </button>
        <div class="text-xs font-mono text-slate-500" id="step-counter">01 / 07</div>
        <button id="next-step" class="flex items-center gap-2 text-slate-400 hover:text-white transition text-sm font-medium">
          Next step <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════ -->
  <!-- WHO IS THIS FOR (redesigned) -->
  <!-- ════════════════════════════════════════════════════════════════ -->
  <section class="px-4 sm:px-6 lg:px-8 py-24 border-t border-slate-800">
    <div class="max-w-7xl mx-auto">

      <div class="max-w-3xl mb-14 reveal-direct">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold tracking-wider uppercase mb-5 border border-brand-500/25">
          <i data-lucide="users" class="w-3 h-3"></i> Who it's for
        </div>
        <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight leading-[1.05] mb-5">
          Built for the protective investor.
        </h2>
        <p class="text-lg text-slate-400 leading-relaxed">
          StockSentry is not for day-traders chasing scalps, or full-time quants tuning their own models. It's for the people who want to grow capital steadily without being tethered to a screen.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-4 mb-14 reveal-group">
        <div class="persona-card reveal-item rounded-3xl border border-slate-700 bg-dark-800 p-7 flex flex-col">
          <div class="flex items-center justify-between mb-6">
