<!-- ════════════════════════════════════════════════════════════════════
     Scoped styles + sparkline script — paste once anywhere in MainLayout
     ════════════════════════════════════════════════════════════════════ -->
<style is:global>
  .ss-num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
  .ss-label-stamp { font-family: 'JetBrains Mono', ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; font-size: 10px; }
  .ss-metric { transition: transform .25s ease, border-color .25s ease; }
  .ss-metric:hover { transform: translateY(-2px); border-color: rgba(255,122,26,.35); }
</style>

<script>
  const drawProofSparkline = (svgId) => {
    const svg = document.getElementById(svgId);
    if (!svg) return;

    // 48-month equity (Jan 2021 → Dec 2024), rebased to $10,000. Source: Backtest v9.
    const user = [9796,10484,10803,11000,11672,12295,12626,13210,12703,14010,14126,14293,13658,13364,13575,13271,13639,12588,12457,12057,11154,12495,12785,12329,12561,12461,13177,13275,14065,15105,15807,15746,15377,15132,16396,16686,17183,19075,20315,20339,20898,20787,21619,22337,23044,22874,23857,22283];
    const spy  = [10035,10314,10782,11352,11427,11683,11968,12325,11750,12575,12474,13051,12362,11997,12448,11356,11381,10443,11405,10939,9928,10735,11332,10679,11350,11065,11475,11658,11712,12471,12879,12670,12069,11807,12885,13474,13688,14403,14874,14274,14996,15525,15713,16080,16418,16271,17242,16827];
    const qqq  = [10170,10156,10331,10941,10810,11487,11815,12314,11614,12527,12777,12924,11794,11266,11792,10189,10027,9134,10280,9753,8725,9074,9577,8714,9641,9607,10519,10572,11406,12125,12593,12406,11776,11533,12780,13494,13740,14466,14650,14009,14871,15833,15568,15739,16152,16012,16869,16946];
    const yearIdx = [0, 12, 24, 36]; // Jan of '21 '22 '23 '24
    const monoFont = 'JetBrains Mono, monospace';

    const W = 700, H = 340;
    const padL = 50, padR = 104, padT = 30, padB = 34;

    const all = user.concat(spy, qqq);
    const yMin = Math.min(...all) * 0.95;
    const yMax = Math.max(...all) * 1.07;
    const n = user.length - 1;
    const x = (i) => padL + (W - padL - padR) * (i / n);
    const y = (v) => padT + (H - padT - padB) * (1 - (v - yMin) / (yMax - yMin));

    // 2022 bear shading (highlight survival)
    const bx0 = x(yearIdx[1]), bx1 = x(yearIdx[2]);
    const bear = `
      <rect x="${bx0}" y="${padT}" width="${bx1 - bx0}" height="${H - padT - padB}" fill="rgba(244,63,94,.07)"/>
      <text x="${(bx0 + bx1) / 2}" y="${padT + 13}" text-anchor="middle" fill="#fb7185" font-size="9" font-weight="700" font-family="${monoFont}" letter-spacing="1.5" opacity="0.8">2022 BEAR</text>
    `;

    // Y-axis grid + $k ticks
    let yLabels = '';
    for (let i = 0; i <= 3; i++) {
      const v = yMin + (yMax - yMin) * (i / 3);
      const yy = y(v);
      yLabels += `<line x1="${padL}" x2="${W - padR}" y1="${yy}" y2="${yy}" stroke="rgba(148,163,184,.08)" stroke-width="1"/>`;
      yLabels += `<text x="${padL - 9}" y="${yy + 4}" text-anchor="end" fill="#94a3b8" font-size="11" font-family="${monoFont}">$${Math.round(v / 1000)}k</text>`;
    }

    // X-axis year labels
    let xLabels = '';
    [["’21", yearIdx[0]], ["’22", yearIdx[1]], ["’23", yearIdx[2]], ["’24", yearIdx[3]]].forEach(([l, idx]) => {
      xLabels += `<text x="${x(idx)}" y="${H - padB + 20}" text-anchor="middle" fill="#94a3b8" font-size="12" font-weight="500" font-family="${monoFont}">${l}</text>`;
    });

    // Path builder
    const pathOf = (arr) => arr.map((v, i) => (i === 0 ? 'M' : 'L') + x(i).toFixed(1) + ',' + y(v).toFixed(1)).join(' ');
    const pUser = pathOf(user), pSpy = pathOf(spy), pQqq = pathOf(qqq);
    const area = pUser + ' L ' + x(n).toFixed(1) + ',' + (H - padB) + ' L ' + padL + ',' + (H - padB) + ' Z';

    // End dots + callouts
    const lx = x(n);
    const yU = y(user[n]), yS = y(spy[n]), yQ = y(qqq[n]);
    const sentryEnd = `
      <line x1="${lx}" x2="${W - padR + 8}" y1="${yU}" y2="${yU}" stroke="rgba(255,122,26,.5)" stroke-width="1" stroke-dasharray="2 3"/>
      <circle cx="${lx}" cy="${yU}" r="6" fill="#ff7a1a" stroke="#030712" stroke-width="2.5"/>
      <text x="${W - padR + 12}" y="${yU - 1}" fill="#ff7a1a" font-size="17" font-weight="800" font-family="${monoFont}">$22,283</text>
      <text x="${W - padR + 12}" y="${yU + 17}" fill="#34d399" font-size="12" font-weight="700" font-family="${monoFont}">+122.8%</text>
    `;
    const yB = (yS + yQ) / 2;
    const benchEnd = `
      <circle cx="${lx}" cy="${yS}" r="4" fill="#64748b" stroke="#030712" stroke-width="2"/>
      <circle cx="${lx}" cy="${yQ}" r="4" fill="#475569" stroke="#030712" stroke-width="2"/>
      <text x="${W - padR + 12}" y="${yB - 4}" fill="#94a3b8" font-size="11.5" font-weight="700" font-family="${monoFont}">S&amp;P +70.7%</text>
      <text x="${W - padR + 12}" y="${yB + 12}" fill="#94a3b8" font-size="11.5" font-weight="700" font-family="${monoFont}">QQQ +70.5%</text>
    `;

    svg.innerHTML = `
      <defs>
        <linearGradient id="proofSg-${svgId}" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#ff7a1a" stop-opacity="0.34"/>
          <stop offset="100%" stop-color="#ff7a1a" stop-opacity="0"/>
        </linearGradient>
      </defs>
      ${bear}
      ${yLabels}
      <path d="${area}" fill="url(#proofSg-${svgId})"/>
      <path d="${pQqq}" stroke="#475569" stroke-width="1.75" fill="none" stroke-dasharray="5 4" stroke-linejoin="round" stroke-linecap="round"/>
      <path d="${pSpy}" stroke="#64748b" stroke-width="1.75" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
      <path d="${pUser}" stroke="#ff7a1a" stroke-width="2.75" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
      ${benchEnd}
      ${sentryEnd}
      ${xLabels}
    `;
  };

  const setupChartModal = () => {
    const trigger = document.getElementById('proof-chart-trigger');
    const modal = document.getElementById('proof-chart-modal');
    const closeBtn = document.getElementById('proof-modal-close');
    
    if (!trigger || !modal || !closeBtn) return;

    const openModal = () => {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      drawProofSparkline('proof-sparkline-modal');
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    trigger.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  };

  document.addEventListener('astro:page-load', () => {
    drawProofSparkline('proof-sparkline-main');
    setupChartModal();
    if (window.lucide) window.lucide.createIcons();
  });
</script>
