---
const { currentPath } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/experience", label: "Experience" },
  { href: "/pricing", label: "Pricing" },
  { href: "/faq", label: "FAQ" },
];
---

<nav id="main-nav" class="border-b border-transparent bg-dark-900/0 backdrop-blur-md fixed w-full z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
            <a href="/" class="flex items-center gap-2">
                <svg width="24" height="24" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="6" stroke-linejoin="round"/>
                    <path d="M30 65L45 45L55 55L70 30" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="70" cy="30" r="4" fill="var(--brand-500)"/>
                </svg>
                <span class="text-xl font-bold text-white tracking-tight">StockSentry<span class="text-brand-500">.bot</span></span>
            </a>
            
            <!-- Desktop Navigation -->
            <div class="hidden md:flex space-x-8">
                {navLinks.map(({ href, label }) => (
                    <a 
                        href={href} 
                        class={`transition hover:text-white ${currentPath === href || (href !== "/" && currentPath?.startsWith(href)) ? "text-white font-medium" : "text-slate-300"}`}
                    >
                        {label}
                    </a>
                ))}
            </div>

            <div class="flex items-center gap-4">
                <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="hidden sm:flex bg-brand-600 hover:bg-brand-500 text-white px-5 py-2.5 rounded-lg font-medium transition text-sm items-center gap-2 btn-hover-effect">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    Start Free Trial
                </a>
                
                <!-- Mobile Menu Button -->
                <button 
                    id="mobile-menu-button" 
                    class="md:hidden text-slate-300 hover:text-white focus:outline-none p-2"
                    aria-label="Menu"
                >
                    <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu: Dim backdrop -->
    <div
        id="mobile-menu-overlay"
        class="fixed inset-0 z-[40] md:hidden pointer-events-none"
        style="background: rgba(0,0,0,0.6); opacity: 0; transition: opacity 0.3s ease;"
    ></div>

    <!-- Mobile Menu: Glass card -->
    <div
        id="mobile-menu"
        class="md:hidden fixed top-[4.5rem] inset-x-4 z-[50] pointer-events-none"
        style="opacity: 0; transform: translateY(-12px) scale(0.97); transition: opacity 0.3s ease, transform 0.3s ease;"
    >
        <div style="background: rgba(10, 16, 36, 0.97); border: 1px solid rgba(255,255,255,0.12); border-radius: 2rem; box-shadow: 0 8px 32px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.08); overflow: hidden;">
            <div style="height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent); margin: 0 1.5rem;"></div>
            <div class="p-3 space-y-1 pt-4">
                {navLinks.map(({ href, label }) => (
                    <a 
                        href={href} 
                        class={`flex items-center gap-4 px-5 py-4 rounded-xl transition-all duration-200 ${currentPath === href || (href !== "/" && currentPath?.startsWith(href)) ? "text-brand-500 font-bold" : "text-white/90 hover:text-white"}`}
                        style={currentPath === href || (href !== "/" && currentPath?.startsWith(href)) ? "background: rgba(59,130,246,0.15);" : ""}
                    >
                        <div style="width:2.25rem; height:2.25rem; border-radius:0.65rem; background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <i data-lucide={
                                label === "Home" ? "home" : 
                                label === "Experience" ? "compass" : 
                                label === "Pricing" ? "credit-card" : "help-circle"
                            } class="w-4 h-4 text-brand-500"></i>
                        </div>
                        <span class="text-[15px] font-medium">{label}</span>
                    </a>
                ))}
            </div>
            <div class="px-3 pb-4 pt-2">
                <div style="height:1px; background:rgba(255,255,255,0.08); margin-bottom:0.75rem;"></div>
                <a 
                    href="https://t.me/StockSentryAYS_bot" 
                    target="_blank" 
                    class="flex items-center justify-center gap-3 w-full text-white font-bold transition-all duration-200 active:scale-[0.98]"
                    style="background: linear-gradient(135deg, var(--brand-600, #2563eb), var(--brand-500, #3b82f6)); padding:1rem; border-radius:1.25rem; box-shadow:0 4px 16px rgba(59,130,246,0.35), inset 0 1px 0 rgba(255,255,255,0.2); font-size:0.95rem;"
                >
                    <i data-lucide="send" class="w-4 h-4"></i>
                    Start Free Trial
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    const setupNav = () => {
        const nav = document.getElementById('main-nav');
        
        const handleScroll = () => {
            if (window.scrollY > 10) {
                nav?.classList.remove('bg-dark-900/0', 'border-transparent');
                nav?.classList.add('bg-dark-900/95', 'border-slate-800', 'shadow-lg');
            } else {
                nav?.classList.remove('bg-dark-900/95', 'border-slate-800', 'shadow-lg');
                nav?.classList.add('bg-dark-900/0', 'border-transparent');
            }
        };

        window.addEventListener('scroll', handleScroll);
        handleScroll(); // Check on load
    };

    const setupMobileMenu = () => {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        const overlay = document.getElementById('mobile-menu-overlay');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        const navLinks = menu?.querySelectorAll('a');

        if (!button || !menu || button.hasAttribute('data-nav-initialized')) return;

        let isOpen = false;

        const openMenu = () => {
            isOpen = true;
            document.body.style.overflow = 'hidden';
            menu.style.opacity = '1';
            menu.style.transform = 'translateY(0) scale(1)';
            menu.style.pointerEvents = 'auto';
            if (overlay) {
                overlay.style.opacity = '1';
                overlay.style.pointerEvents = 'auto';
            }
            menuIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
        };

        const closeMenu = () => {
            isOpen = false;
            menu.style.opacity = '0';
            menu.style.transform = 'translateY(-12px) scale(0.97)';
            menu.style.pointerEvents = 'none';
            if (overlay) {
                overlay.style.opacity = '0';
                overlay.style.pointerEvents = 'none';
            }
            menuIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
        };

        const toggleMenu = () => isOpen ? closeMenu() : openMenu();

        button.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            toggleMenu();
        });

        // Close when tapping the dim backdrop
        overlay?.addEventListener('click', closeMenu);

        // Close when tapping outside both the menu and the button
        document.addEventListener('click', (e) => {
            if (isOpen && !menu.contains(e.target) && !button.contains(e.target)) {
                closeMenu();
            }
        });

        navLinks?.forEach(link => {
            link.addEventListener('click', closeMenu);
        });

        button.setAttribute('data-nav-initialized', 'true');
    };

    // Re-run after Astro page transitions
    document.addEventListener('astro:page-load', () => {
        setupNav();
        setupMobileMenu();
    });
</script>
