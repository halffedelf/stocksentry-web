---
const { currentPath } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/experience", label: "Experience" },
  { href: "/pricing", label: "Pricing" },
  { href: "/faq", label: "FAQ" },
];
---

<nav id="main-nav" class="border-b border-transparent bg-dark-900/0 backdrop-blur-md fixed w-full z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
            <a href="/" class="flex items-center gap-2">
                <svg width="24" height="24" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M50 5L15 20V45C15 70 30 90 50 95C70 90 85 70 85 45V20L50 5Z" stroke="var(--brand-500)" stroke-width="6" stroke-linejoin="round"/>
                    <path d="M30 65L45 45L55 55L70 30" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="70" cy="30" r="4" fill="var(--brand-500)"/>
                </svg>
                <span class="text-xl font-bold text-white tracking-tight">StockSentry<span class="text-brand-500">.bot</span></span>
            </a>
            
            <!-- Desktop Navigation -->
            <div class="hidden md:flex space-x-8">
                {navLinks.map(({ href, label }) => (
                    <a 
                        href={href} 
                        class={`transition hover:text-white ${currentPath === href || (href !== "/" && currentPath?.startsWith(href)) ? "text-white font-medium" : "text-slate-300"}`}
                    >
                        {label}
                    </a>
                ))}
            </div>

            <div class="flex items-center gap-4">
                <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="hidden sm:flex bg-brand-600 hover:bg-brand-500 text-white px-5 py-2.5 rounded-lg font-medium transition text-sm items-center gap-2 btn-hover-effect">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    Start Free Trial
                </a>
                
                <!-- Mobile Menu Button -->
                <button 
                    id="mobile-menu-button" 
                    class="md:hidden text-slate-300 hover:text-white focus:outline-none p-2"
                    aria-label="Menu"
                >
                    <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Menu (Floating Card) -->
    <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden md:hidden opacity-0 transition-opacity duration-300"></div>
    
    <div id="mobile-menu" class="hidden md:hidden fixed top-20 inset-x-4 z-50 transform -translate-y-4 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-dark-900/90 backdrop-blur-2xl border border-slate-700/50 rounded-[2rem] shadow-2xl p-4 overflow-hidden">
            <div class="space-y-1">
                {navLinks.map(({ href, label }) => (
                    <a 
                        href={href} 
                        class={`flex items-center gap-4 px-5 py-4 rounded-2xl transition-all ${currentPath === href || (href !== "/" && currentPath?.startsWith(href)) ? "bg-brand-500/10 text-brand-500 font-bold" : "text-slate-300 hover:bg-white/5"}`}
                    >
                        <i data-lucide={
                            label === "Home" ? "home" : 
                            label === "Experience" ? "compass" : 
                            label === "Pricing" ? "credit-card" : "help-circle"
                        } class="w-5 h-5"></i>
                        {label}
                    </a>
                ))}
            </div>
            <div class="mt-4 pt-4 border-t border-slate-800">
                <a href="https://t.me/StockSentryAYS_bot" target="_blank" class="flex items-center justify-center gap-3 w-full bg-brand-600 hover:bg-brand-500 text-white px-5 py-5 rounded-[1.5rem] font-bold transition shadow-lg shadow-brand-500/20">
                    <i data-lucide="send" class="w-5 h-5"></i>
                    Start Free Trial
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    const setupNav = () => {
        const nav = document.getElementById('main-nav');
        
        const handleScroll = () => {
            if (window.scrollY > 10) {
                nav?.classList.remove('bg-dark-900/0', 'border-transparent');
                nav?.classList.add('bg-dark-900/95', 'border-slate-800', 'shadow-lg');
            } else {
                nav?.classList.remove('bg-dark-900/95', 'border-slate-800', 'shadow-lg');
                nav?.classList.add('bg-dark-900/0', 'border-transparent');
            }
        };

        window.addEventListener('scroll', handleScroll);
        handleScroll(); // Check on load
    };

    const setupMobileMenu = () => {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        const overlay = document.getElementById('mobile-menu-overlay');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        const navLinks = menu?.querySelectorAll('a');

        const toggleMenu = (forceClose = false) => {
            const isOpening = forceClose ? false : menu?.classList.contains('hidden');
            
            if (isOpening) {
                // Open
                menu?.classList.remove('hidden');
                overlay?.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                
                // Animate in
                setTimeout(() => {
                    menu?.classList.remove('-translate-y-4', 'opacity-0', 'pointer-events-none');
                    overlay?.classList.add('opacity-100');
                    menuIcon?.classList.add('hidden');
                    closeIcon?.classList.remove('hidden');
                }, 10);
            } else {
                // Close
                menu?.classList.add('-translate-y-4', 'opacity-0', 'pointer-events-none');
                overlay?.classList.remove('opacity-100');
                menuIcon?.classList.remove('hidden');
                closeIcon?.classList.add('hidden');
                document.body.style.overflow = '';
                
                // Hide after transition
                setTimeout(() => {
                    menu?.classList.add('hidden');
                    overlay?.classList.add('hidden');
                }, 300);
            }
        };

        button?.addEventListener('click', () => toggleMenu());
        overlay?.addEventListener('click', () => toggleMenu(true));

        // Close menu when clicking a link
        navLinks?.forEach(link => {
            link.addEventListener('click', () => toggleMenu(true));
        });
    };

    // Re-run after Astro page transitions
    document.addEventListener('astro:page-load', () => {
        setupNav();
        setupMobileMenu();
    });
</script>
